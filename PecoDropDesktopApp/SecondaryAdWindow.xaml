<Window x:Class="PecoDropDesktopApp.SecondaryAdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ShowInTaskbar="False"
        Background="#03120A" Title="PecoDrop Digital Signage">

    <Window.Resources>
        <FontFamily x:Key="UrduFont">Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Tahoma, Segoe UI</FontFamily>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.35" Color="#22C55E"/>
    </Window.Resources>

    <Grid Background="#021008">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Digital Signage Header -->
            <RowDefinition Height="*"/>    <!-- 1: Video Media Player -->
            <RowDefinition Height="Auto"/> <!-- 2: Bottom Eco Banner -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP BRANDING BANNER -->
        <Border Grid.Row="0" Background="#E6052016" BorderBrush="#15803D" BorderThickness="0,0,0,2" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: PecoDrop Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="♻" FontSize="20" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PECO DROP" FontSize="20" FontWeight="Black" Foreground="#FFFFFF"/>
                            <Border Background="#166534" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DIGITAL SIGNAGE" FontSize="10" FontWeight="Bold" Foreground="#86EFAC"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="SMART REVERSE VENDING MACHINE • ریورس وینڈنگ مشین" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Live Slogan -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="SMALL ACTIONS • BIG IMPACT" FontSize="14" FontWeight="Black" Foreground="#FDE047" HorizontalAlignment="Center"/>
                    <TextBlock Text="اپنے ماحول کو سرسبز اور صاف بنائیں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Eco Points Live Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#064E3B" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EARN POINTS &amp; REWARDS • " FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                            <TextBlock Text="انعامات حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="11.5" FontWeight="Bold" Foreground="#FDE047"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: FULLSCREEN VIDEO PLAYER -->
        <Grid Grid.Row="1" Background="#000000">
            <MediaElement x:Name="SecondaryPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          MediaEnded="SecondaryPlayer_MediaEnded"
                          MediaFailed="SecondaryPlayer_MediaFailed"/>

            <!-- Fallback / Loading Graphic -->
            <Border x:Name="PlayerPlaceholder" Background="#021B11" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🌱" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="PECO DROP" FontSize="36" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="RECYCLE TODAY FOR A CLEANER TOMORROW" FontSize="16" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                    <TextBlock Text="بوتل، کین یا کپ ڈالیں اور پوائنٹس حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="20" FontWeight="Bold" Foreground="#FDE047" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: BOTTOM ECO TICKER -->
        <Border Grid.Row="2" Background="#073B28" BorderBrush="#15803D" BorderThickness="0,2,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="♻ " FontSize="14" Foreground="#86EFAC"/>
                        <TextBlock Text="REDUCE WASTE • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="کچرا کم کریں" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#86EFAC"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🍃 " FontSize="14" Foreground="#86EFAC"/>
                        <TextBlock Text="REUSE RESOURCES • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="دوبارہ استعمال" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#86EFAC"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🌎 " FontSize="14" Foreground="#86EFAC"/>
                        <TextBlock Text="SAVE ENVIRONMENT • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                        <TextBlock Text="سرسبز مستقبل" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#86EFAC"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
