                                    </Border>
                                    <Border Width="13" Height="13" CornerRadius="6.5" Background="#C2410C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                        <TextBlock Text="3" FontSize="8.5" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModernPodium3Name" Text="Bronze Hero" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ModernPodium3Points" Text="0 pts" FontSize="10" FontWeight="Bold" Foreground="#FB923C" Margin="0,1,0,1"/>
