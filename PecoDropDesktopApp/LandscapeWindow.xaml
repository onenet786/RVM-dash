                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RANK" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="CITIZEN / RECYCLER" FontSize="9" FontWeight="Black" Foreground="#64748B" Margin="30,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="POINTS" FontSize="9" FontWeight="Black" Foreground="#64748B"/>
                            </Grid>

                            <!-- List (Top 10 Users Uniformly Filling Height - No Space Left) -->
                            <ItemsControl Grid.Row="1" x:Name="ModernLeaderboardList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" Rows="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" BorderBrush="#162032" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,1.5" VerticalAlignment="Stretch">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="13" FontWeight="Black" Foreground="{Binding RankColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" BorderBrush="{Binding RingColor}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="3.5" Background="#1E293B" Foreground="{Binding BarColor}" BorderThickness="0" Margin="0,2.5,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="3" Background="#141E33" BorderBrush="{Binding RingColor}" BorderThickness="1" CornerRadius="5" Padding="6,2.5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PointsBalance, StringFormat='{}{0} pts'}" FontSize="11" FontWeight="Black" Foreground="{Binding PointsColor}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ROW 3: RECENT ACTIVITY FEED -->
                    <Border Grid.Row="3" Background="#101726" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒 " FontSize="10"/>
                                    <TextBlock Text="RECENT ACTIVITY" FontSize="9.5" FontWeight="Black" Foreground="#94A3B8"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Last Updated: 2 mins ago" FontSize="8.5" FontWeight="SemiBold" Foreground="#64748B"/>
                            </Grid>

                            <ItemsControl x:Name="ModernRecentActivityList">
