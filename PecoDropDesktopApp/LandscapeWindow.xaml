                                                <!-- Points Awarded Badge -->
                                                <TextBlock Grid.Column="2" Text="{Binding PointsText}" FontSize="10" FontWeight="Black" Foreground="#4ADE80" Margin="4,0,8,0" VerticalAlignment="Center"/>

                                                <!-- Time Ago -->
                                                <TextBlock Grid.Column="3" Text="{Binding TimeAgo}" FontSize="8.5" Foreground="#64748B" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
