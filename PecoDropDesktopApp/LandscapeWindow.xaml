                                                    <TextBlock Text="REDEEM" FontSize="9.5" FontWeight="Black" Foreground="White"/>
                                                    <TextBlock Text="انعام حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Bold" Foreground="#DCFCE7"/>
