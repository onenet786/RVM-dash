                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#F59E0B" BorderThickness="2">
                                        <Border.Background>
                                            <ImageBrush x:Name="ModernPodium1Avatar" ImageSource="pack://application:,,,/PecoDropDesktopApp;component/Assets/Avatars/avatar1.png" Stretch="UniformToFill"/>
