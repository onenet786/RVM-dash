                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModernPodium1Name" Text="Eco Champion" FontSize="11.5" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ModernPodium1Points" Text="0 pts" FontSize="10.5" FontWeight="Black" Foreground="#FBBF24" Margin="0,1,0,1"/>
                                    <TextBlock Text="🥇 #1 CHAMPION" FontSize="7.5" FontWeight="Black" Foreground="#F59E0B"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- #3 BRONZE (AMBER / ORANGE) -->
                        <Border Grid.Column="4" Background="#18130F" BorderBrush="#EA580C" BorderThickness="1.5" CornerRadius="8" Padding="6,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Border Width="28" Height="28" CornerRadius="14" BorderBrush="#FB923C" BorderThickness="1.5">
                                        <Border.Background>
                                            <ImageBrush x:Name="ModernPodium3Avatar" ImageSource="pack://application:,,,/PecoDropDesktopApp;component/Assets/Avatars/avatar3.png" Stretch="UniformToFill"/>
