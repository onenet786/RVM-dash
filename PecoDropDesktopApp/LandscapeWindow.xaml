<Window x:Class="PecoDropDesktopApp.LandscapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ShowInTaskbar="True" Title="PecoDrop Kiosk Main"
        Icon="pack://application:,,,/PecoDropDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>

        <!-- Authentic Urdu Nastaliq Font Stack -->
        <FontFamily x:Key="UrduFont">./Fonts/#Jameel Noori Nastaleeq, pack://application:,,,/Fonts/#Jameel Noori Nastaleeq, ./Fonts/#Noto Nastaliq Urdu, pack://application:,,,/Fonts/#Noto Nastaliq Urdu, Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Gulzar, Pak Nastaleeq, Nafees Nastaleeq, Tahoma, Segoe UI, Arial</FontFamily>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="SubtleItemShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.20" Color="#0D9488"/>

        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="80" CenterY="80"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="3,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ============================================================== -->
        <!-- 1. CLASSIC KIOSK SCREEN LAYOUT (LEGACY DUAL-PANE VIEW)          -->
        <!-- ============================================================== -->
        <Grid x:Name="ClassicScreenLayout" Visibility="Collapsed">

        <Grid.ColumnDefinitions>
            <!-- LEFT: INSTRUCTIONAL VIDEO & LIVE SESSION DETAILS (60%) -->
            <ColumnDefinition Width="6*"/>
            <!-- RIGHT: LEADERBOARD (40%) -->
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- COLUMN 0: 50% KIOSK DETAILS & INTERACTION (LEFT SIDE)          -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#FFFFFF" Padding="14,10" BorderBrush="#CBD5E1" BorderThickness="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header Ribbon -->
                    <RowDefinition Height="Auto"/> <!-- 1: Hardware Diagnostics Bar -->
                    <RowDefinition Height="*"/>    <!-- 2: Instructional Video / Deposit Centerpiece -->
                    <RowDefinition Height="Auto"/> <!-- 3: Live Session Details Breakdown & Points Balance -->
                    <RowDefinition Height="Auto"/> <!-- 4: Collapsed Hidden Elements -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,8" MinHeight="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="44" Height="44" Margin="0,0,8,0">
                            <Grid Width="38" Height="38">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                <Path Data="M 17 11 L 17 7 L 23 7 L 23 11 L 27 15 L 27 32 L 13 32 L 13 15 Z" Fill="#073B28"/>
                                <Path Data="M 26 20 C 36 21 36 34 24 34 C 28 28 28 22 26 20 Z" Fill="#22C55E"/>
                            </Grid>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PECO DROP" FontSize="19" FontWeight="Black" Foreground="#073B28"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="4" Padding="5,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="4" Padding="5,1.5" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="WELCOME • " FontSize="16" FontWeight="Black" Foreground="#073B28"/>
                            <TextBlock Text="خوش آمدید" FontFamily="{StaticResource UrduFont}" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                        </StackPanel>
                        <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Right: Date, Time & ISPP Logo Card -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="12.5" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="2" Height="44" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/PecoDropDesktopApp;component/Assets/ispp.jpg" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </StackPanel>

                    <!-- Collapsed Labels for compatibility -->
                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Visibility="Collapsed"/>
                    <TextBlock x:Name="BottleInfoText" Visibility="Collapsed"/>
                </Grid>

                <!-- ROW 1: HARDWARE DIAGNOSTICS BAR -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,6" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="HARDWARE DIAGNOSTICS 🔌" FontSize="8.5" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConnectionText" Text="SERIAL: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DbDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ApiDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ApiStatusText" Text="API: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MachineStateText" Text="IDLE" FontSize="8" FontWeight="Bold" Foreground="#0369A1" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Demo Testing Screen Launcher Button -->
                            <Button Grid.Column="1" Click="DemoTestingButton_Click" Cursor="Hand" ToolTip="Open Hardware Simulator &amp; Demo Testing Panel (F2)" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#0F172A" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎮 " FontSize="8" VerticalAlignment="Center"/>
                                                <TextBlock Text="DEMO TESTING (F2)" FontSize="7.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- HARDWARE ERROR BANNER -->
                        <Border x:Name="CompartmentWarningBanner" Grid.Row="3" Margin="0,4,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="8,4" Visibility="Collapsed">
                                <TextBlock x:Name="CompartmentWarningText" TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                            <Border x:Name="HardwareErrorBanner" Grid.Row="2" Margin="0,3,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️ " FontSize="8" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="HardwareErrorText" Text="HARDWARE CONNECTION ERROR • " FontSize="7.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    <TextBlock Text="ہارڈویئر منسلک نہیں ہے" FontFamily="{StaticResource UrduFont}" FontSize="8.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="DEMO MODE 🎮" Background="#0F172A" Foreground="#34D399" FontSize="7.5" FontWeight="Bold" Padding="5,1" Margin="4,0,0,0" Cursor="Hand" Click="DemoTestingButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="#059669" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="3" Content="RETRY 🔄" Background="#DC2626" Foreground="White" FontSize="7.5" FontWeight="Bold" Padding="4,1" Margin="4,0,0,0" Cursor="Hand" Click="RetryHardwareConnection_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ACTIVE AUTHENTICATED USER GREETING BANNER -->
                <Border x:Name="UserGreetingBanner" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,-8" Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1.5" CornerRadius="8" Padding="12,3" HorizontalAlignment="Center" Visibility="Collapsed" Effect="{StaticResource CardShadow}" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👤 " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GreetingUserNameText" Text="Eco Citizen" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#166534" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                            <TextBlock x:Name="GreetingPointsBalanceText" Text="Balance: 0 pts" FontSize="10" FontWeight="Bold" Foreground="#FDE047"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- DISPLAY LAYOUT HOTKEY NOTIFICATION TOAST -->
                <Border x:Name="LayoutToastBanner" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Background="#064E3B" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="6" Padding="12,4" Visibility="Collapsed" Panel.ZIndex="20" Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖥️ " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LayoutToastText" Text="Layout: Hardware Screen [LEFT] | Video Signage [RIGHT]" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ROW 2: INSTRUCTIONAL VIDEO / DEPOSIT CENTERPIECE (EQUAL 1/3 HEIGHT) -->
                <Border Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="8" ClipToBounds="True" Background="#000000" BorderBrush="#E2EAE0" BorderThickness="1.2" Margin="0,0,0,6" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                    <Grid>
                        <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded" MediaFailed="InstructionPlayer_MediaFailed"/>
                        <Grid x:Name="InstructionPlaceholder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border Background="#FBFDF9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="240" Height="240" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3 3"/>
                                        <Ellipse Width="222" Height="222" Fill="#FFFFFF" Stroke="#E2ECE0" StrokeThickness="1.5"/>
                                        <Ellipse Width="204" Height="204" Fill="#F8FCF7" Stroke="#CBE0CB" StrokeThickness="1.2"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="INSERT • " FontSize="15" FontWeight="Black" Foreground="#073B28"/>
                                                <TextBlock Text="داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="16" FontWeight="Black" Foreground="#073B28"/>
                                            </StackPanel>
                                            <TextBlock Text="BOTTLE / CAN / CUP / PAPER" FontSize="9.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <Border Background="#073B28" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="OR PRESS [0] TO START • " FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="یا 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>

                        <!-- Touchless QR Start Floating Card (Visible on idle over video or placeholder) -->
                        <Border x:Name="StartQrCard" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Background="#FFFFFF" BorderBrush="#15803D" BorderThickness="2" CornerRadius="12" Padding="10,8" Effect="{StaticResource CardShadow}" Panel.ZIndex="12" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                            <StackPanel HorizontalAlignment="Center" Width="190">
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,0,5" HorizontalAlignment="Center">
                                    <TextBlock Text="📱 TOUCHLESS SCAN" FontSize="9.5" FontWeight="Black" Foreground="#15803D"/>
                                </Border>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="4" CornerRadius="8" HorizontalAlignment="Center">
                                    <Image x:Name="StartQrImage" Width="175" Height="175" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock Text="SCAN TO START" FontSize="11" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center" Margin="0,4,0,1"/>
                                <TextBlock Text="اسکین کریں اور شروع کریں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Classic Idle Start Prompt Overlay: "PRESS 0 TO START" -->
                        <Border x:Name="ClassicIdleStartOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" Background="#DD064E3B" BorderBrush="#34D399" BorderThickness="2" CornerRadius="28" Padding="20,8" Panel.ZIndex="15" Cursor="Hand" MouseLeftButtonUp="StartButton_Click" Effect="{StaticResource CardShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#10B981" Margin="0,0,12,0" BorderBrush="#FFFFFF" BorderThickness="1.5">
                                    <TextBlock Text="0" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PRESS " FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock Text="[0]" FontSize="14.5" FontWeight="Black" Foreground="#34D399"/>
                                        <TextBlock Text=" TO START RECYCLING" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" • شروع کرنے کے لیے 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Bold" Foreground="#86EFAC" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Or touch screen / scan touchless QR to begin session" FontSize="9" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Classic Active Intake Overlay: "PLEASE INSERT BOTTLE / CAN / PAPER" (3 Illuminated Apertures) -->
                        <Border x:Name="ClassicActiveIntakeOverlay" Visibility="Collapsed" Panel.ZIndex="20" Background="#0A1813" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid Margin="16,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Header -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Border Background="#064E3B" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="14" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,5,0"/>
                                            <TextBlock Text="SESSION ACTIVE • INTAKE GATES READY" FontSize="9" FontWeight="Black" Foreground="#86EFAC"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="PLEASE INSERT BOTTLE / CAN / PAPER" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                                        <TextBlock Text=" • " FontSize="16" FontWeight="Black" Foreground="#34D399"/>
                                        <TextBlock Text="براہ کرم بوتل ، کین ، یا کاغذ داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="17" FontWeight="Black" Foreground="#34D399"/>
                                    </StackPanel>
                                    <TextBlock Text="Sensors active • Insert items one at a time into the corresponding illuminated aperture" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- 3 Illuminated Aperture Cards (Height 390px, Large 165px Icons) -->
                                <Grid Grid.Row="1" Margin="6,0" VerticalAlignment="Center" MaxHeight="390">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Aperture 1: PLASTIC BOTTLE (⭕ Magenta Glow) -->
                                    <Border Grid.Column="0" Background="#180C14" BorderBrush="#E11D48" BorderThickness="2" CornerRadius="14" Padding="10,10" MaxHeight="390" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="ModernPlasticAperture_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="#4C0519" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="8" Padding="10,3" HorizontalAlignment="Center">
                                                <TextBlock Text="APERTURE 1 • ⭕ CIRCLE" FontSize="10" FontWeight="Black" Foreground="#FDA4AF"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,6">
                                                <Grid Width="165" Height="165" HorizontalAlignment="Center">
                                                    <Ellipse Width="165" Height="165" Stroke="#E11D48" StrokeThickness="4.5" Fill="#2A0B18"/>
                                                    <Ellipse Width="135" Height="135" Stroke="#FDA4AF" StrokeThickness="2" StrokeDashArray="3 3"/>
                                                    <TextBlock Text="🧴" FontSize="74" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="PLASTIC BOTTLES" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                <TextBlock Text="پلاسٹک کی بوتل" FontFamily="{StaticResource UrduFont}" FontSize="16.5" FontWeight="Bold" Foreground="#FDA4AF" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Row="2" Background="#2A0B18" CornerRadius="5" Padding="8,3">
