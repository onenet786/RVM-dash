                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="ModernRewardBalanceText" Text="0" FontSize="24" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock Text="POINTS" FontSize="9" FontWeight="Black" Foreground="#94A3B8"/>
                                    <TextBlock Text="پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
