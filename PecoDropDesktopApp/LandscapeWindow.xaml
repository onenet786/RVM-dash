                                    </Border>
                                    <Border Width="13" Height="13" CornerRadius="6.5" Background="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                        <TextBlock Text="2" FontSize="8.5" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModernPodium2Name" Text="Runner Up" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ModernPodium2Points" Text="0 pts" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,1"/>
                                    <TextBlock Text="🥈 RUNNER UP" FontSize="7.5" FontWeight="Bold" Foreground="#93C5FD"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- #1 CHAMPION (GOLD / TALLER) -->
