                                    <TextBlock Text="LIVE RANKINGS" FontSize="9" FontWeight="Black" Foreground="#6EE7B7"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 1: PODIUM TOP 3 SHOWCASE (COMPACT HORIZONTAL BAR) -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1.12*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- #2 RUNNER UP (SILVER / CYAN) -->
                        <Border Grid.Column="0" Background="#101726" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="6,4">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
