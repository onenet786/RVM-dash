                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="MetalCompartmentStatus" Grid.Row="3" TextWrapping="Wrap" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="#B91C1C" Margin="0,3,0,0" Visibility="Collapsed"/>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <!-- 🔺 Triangle Style Icon -->
                                                    <Grid Width="34" Height="34" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Polygon Points="17,2 32,31 2,31" Stroke="#10B981" StrokeThickness="2" Fill="#D1FAE5" StrokeLineJoin="Round"/>
                                                        <TextBlock Text="🥫" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="CAN" FontSize="11" FontWeight="Black" Foreground="#0369A1"/>
                                                        <TextBlock Text="🔺 TRIANGLE" FontSize="8.5" FontWeight="Bold" Foreground="#059669"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="8.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanSmallCountText" Text="0" FontSize="13" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="8.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanMediumCountText" Text="0" FontSize="13" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="8.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanLargeCountText" Text="0" FontSize="13" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="CanTotalCountText" Text="0" FontSize="17" FontWeight="Black" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10" FontWeight="Bold" Foreground="#0284C7" Margin="1,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 3. PAPER Card (🟦 Square Style - Doubled Chamber Icon & Text, Compact Height) -->
                                        <Border x:Name="PaperCompartmentCard" Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="8" Padding="6,6" MinHeight="130" MaxHeight="146" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="PaperCompartmentStatus" Grid.Row="3" TextWrapping="Wrap" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Margin="0,3,0,0" Visibility="Collapsed"/>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <!-- 🟦 Square Style Icon -->
                                                    <Border Width="34" Height="34" CornerRadius="6" Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="PAPER" FontSize="11" FontWeight="Black" Foreground="#B45309"/>
                                                        <TextBlock Text="🟦 SQUARE" FontSize="8.5" FontWeight="Bold" Foreground="#0284C7"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="WT: " FontSize="8.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PaperWeightText" Text="0.000" FontSize="14" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" kg" FontSize="9.5" Foreground="#B45309" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="6,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PaperTotalWeightText" Text="0.000" FontSize="15" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" kg" FontSize="9.5" Foreground="#B45309" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Reject Card (🚫 Excluded Style - Doubled Chamber Icon & Text, Compact Height) -->
                                        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="8" Padding="6,6" MinHeight="130" MaxHeight="146" VerticalAlignment="Top">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Border Width="34" Height="34" CornerRadius="6" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="🚫" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="REJECT" FontSize="11" FontWeight="Black" Foreground="#DC2626"/>
                                                        <TextBlock Text="EXCLUDED" FontSize="8.5" FontWeight="Bold" Foreground="#EF4444"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,6">
                                                    <TextBlock x:Name="RejectedCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" pcs" FontSize="9.5" FontWeight="Bold" Foreground="#EF4444" Margin="2,1,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="RejectedTotalCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10" FontWeight="Bold" Foreground="#B91C1C" Margin="1,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- RIGHT COLUMN: TEAL HOW-TO + TOP 5 RECYCLERS -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- How To Use RVM (Exact Same Height 308 as Video Player) -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>     <!-- Top 5 Leaderboard + Flashing Last Recycler -->
                            </Grid.RowDefinitions>

                            <!-- TEAL GLASSMORPHISM HOW TO USE RVM CARD (EXACT SAME SIZE AS VIDEO PLAYER) -->
                            <Border Grid.Row="0" HorizontalAlignment="Stretch" Height="308" CornerRadius="12" Padding="14,8" BorderThickness="1.5" Effect="{StaticResource TealGlassShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EB0F766E" Offset="0.0"/>
                                        <GradientStop Color="#E0115E59" Offset="0.5"/>
                                        <GradientStop Color="#F0042E2B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#995EEAD4" Offset="0.0"/>
                                        <GradientStop Color="#4D2DD4BF" Offset="0.5"/>
                                        <GradientStop Color="#8014B8A6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <Grid>
                                    <Border CornerRadius="10" BorderThickness="1,1,0,0" BorderBrush="#50FFFFFF" IsHitTestVisible="False" Margin="-10,-4,-10,-4"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Title -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                            <TextBlock Text="✦ " FontSize="12" Foreground="#FACC15"/>
                                            <TextBlock Text="HOW TO USE PECO DROP • " FontSize="13" FontWeight="Black" Foreground="#99F6E4"/>
                                            <TextBlock Text="طریقہ کار" FontFamily="{StaticResource UrduFont}" FontSize="14" FontWeight="Black" Foreground="#99F6E4"/>
                                            <TextBlock Text=" ✦" FontSize="12" Foreground="#FACC15"/>
                                        </StackPanel>

                                        <UniformGrid Grid.Row="1" Columns="1" Rows="7">
                                            <!-- Step 1: Press 0 to Start -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="▶️" FontSize="11" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="1. Press 0 to Start • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="شروع کرنے کیلئے 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 2: Insert Bottle/Can/PAPER/Cup -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🍾" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="2. Insert Bottle/Can/PAPER/Cup • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="بوتل، کین یا کپ ڈالیں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 3: Detect -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🔍" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="3. Detect • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="خودکار اسکین اور شناخت" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 4: Press Enter -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="⏎" FontSize="12" FontWeight="Black" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="4. Press Enter • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="آگے بڑھنے کیلئے Enter دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 5: Enter Mobile Number / Scan QR Code -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="📱" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="5. Enter Mobile Number / Scan QR Code • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="نمبر یا QR درج کریں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 6: Press Enter and Get Points -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎁" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="6. Press Enter and Get Points • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="پوائنٹس حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Step 7: Save -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0.5">
                                                <Border Width="24" Height="24" CornerRadius="12" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🌱" FontSize="12" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="7. Save • " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="اپنے ماحول کو سرسبز بنائیں" FontFamily="{StaticResource UrduFont}" FontSize="14.5" FontWeight="Black" Foreground="#99F6E4"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- TOP 10 RECYCLERS LEADERBOARD (DARK SLEEK GAME STYLE) -->
                            <Border Grid.Row="2" Background="#12151E" CornerRadius="14" Padding="12,7" BorderBrush="#252E40" BorderThickness="1.2" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Top 10 Cards List -->
                                        <RowDefinition Height="Auto"/> <!-- Flashing Last Recycler Card -->
                                    </Grid.RowDefinitions>

                                    <!-- Leaderboard Header with Trophy & Subtitle -->
                                    <Grid Grid.Row="0" Margin="2,1,2,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Leaderboard (Top 10)" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="• لیڈر بورڈ" FontFamily="{StaticResource UrduFont}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="#4ADE80" Margin="0,0,4,0"/>
                                                <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Black" Foreground="#4ADE80"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- User Cards List (Top 10 Users Uniformly Filling Height - No Space Left) -->
                                    <ItemsControl Grid.Row="1" x:Name="LeaderboardList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1" Rows="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0DFFFFFF" BorderBrush="#1F283B" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="0,1.5" VerticalAlignment="Stretch">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="13.5" FontWeight="Black" Foreground="{Binding RankColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" BorderBrush="{Binding RingColor}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="3.5" Background="#242D3D" Foreground="{Binding BarColor}" BorderThickness="0" Margin="0,2.5,0,0">
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="1.75" ClipToBounds="True">
                                                                            <Grid x:Name="PART_Track">
                                                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1.75"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding PointsBalance}" FontSize="12" FontWeight="Black" Foreground="{Binding PointsColor}" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" pts" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,1,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- FLASHING LAST RECYCLER FOOTER CARD -->
                                    <Border Grid.Row="2" Margin="0,4,0,0" CornerRadius="8" Padding="10,5.5" MinHeight="50" Background="#141D1B" BorderBrush="#047857" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Flashing Live Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Avatar Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name, Material & Time -->
                                                <ColumnDefinition Width="Auto"/> <!-- Points Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Flashing Pulse Badge -->
                                            <Border Grid.Column="0" x:Name="FlashingLiveBadge" Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="#4ADE80" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="RECENT" FontSize="8" FontWeight="Black" Foreground="#86EFAC"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Avatar Icon -->
                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <TextBlock Text="♻️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- User Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="LastRecyclerNameText" Text="Eco Champion" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="LastRecyclerTimeText" Text=" • Just now" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="LastRecyclerActivityText" Text="Recycled Container • آخری ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </StackPanel>

                                            <!-- Points Chip -->
                                            <Border Grid.Column="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastRecyclerPointsText" Text="+10 pts" FontSize="12" FontWeight="Black" Foreground="#4ADE80"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ROW 4: COLLAPSED (ENVIRONMENTAL IMPACT HIDDEN, REWARD BALANCE INTEGRATED INTO CONTAINER BREAKDOWN) -->
                    <Grid Grid.Row="4" Visibility="Collapsed">
                        <TextBlock x:Name="Co2SavedText" Text="0.00"/>
                        <TextBlock x:Name="WaterSavedText" Text="0.00"/>
                        <TextBlock x:Name="TotalItemsText" Text="0"/>
                    </Grid>

                    <!-- Hidden Elements for Background Subsystems -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="HeaderDotText"/>
                        <TextBlock x:Name="CommandCenterRvmNameText"/>
                        <TextBlock x:Name="AdHeaderRvmNameText"/>
                        <TextBlock x:Name="StatusText"/>
                        <TextBlock x:Name="BottleInfoText"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden Arduino machine controls (replaced by hotkeys 66, 77, 88, 99) -->
        <Border Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,92,18,0" Padding="6" CornerRadius="9"
                Background="#EEFFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                Panel.ZIndex="80" Effect="{StaticResource CardShadow}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="MACHINE CONTROL" FontSize="9" FontWeight="Black"
                           Foreground="#334155" HorizontalAlignment="Center" Margin="2,0,2,5"/>
                <Button Content="START" Click="StartButton_Click" Background="#15803D"
                        Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,0,0,4"
                        Cursor="Hand"/>
                <Button Content="STOP" Click="StopButton_Click" Background="#DC2626"
                        Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,0,0,4"
                        Cursor="Hand"/>
                <Button Content="RESET" Click="ResetHardwareButton_Click" Background="#D97706"
                        Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,0,0,4"
                        Cursor="Hand"/>
                <Button Content="CALIBRATE" Click="CalibrateHardwareButton_Click" Background="#0369A1"
                        Foreground="White" FontWeight="Bold" Padding="14,7" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM SCREEN: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY FOOTER   -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero text overlay -->
                        <RowDefinition Height="*"/>    <!-- Video canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom eco footer -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Signage Overlay Headline -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="19" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Footer Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="12,8" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Waste • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="کچرا کم کریں" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Resources • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="دوبارہ استعمال" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="For a Greener Future • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="سرسبز مستقبل" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 55 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 55 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
