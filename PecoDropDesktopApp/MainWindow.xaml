                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="5" Padding="6,3.5" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="10" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="17" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="5" Padding="6,3.5">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="10" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="17" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
