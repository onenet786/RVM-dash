<Window x:Class="PecoDropDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/PecoDropDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Modern Natural Eco Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>

        <!-- Authentic Urdu Nastaliq Font Stack -->
        <FontFamily x:Key="UrduFont">./Fonts/#Jameel Noori Nastaleeq, pack://application:,,,/Fonts/#Jameel Noori Nastaleeq, ./Fonts/#Noto Nastaliq Urdu, pack://application:,,,/Fonts/#Noto Nastaliq Urdu, Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Gulzar, Pak Nastaleeq, Nafees Nastaleeq, Segoe UI, Arial</FontFamily>
        
        <!-- Soft Natural Drop Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="SubtleItemShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.09" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.22" Color="#0D9488"/>

        <!-- Interactive Circle Button -->
        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="250">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom 5 Navigation Card Buttons -->
        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 62%: Interactive Kiosk Dashboard -->
            <RowDefinition Height="62*"/>
            <!-- BOTTOM 38%: Cinematic Digital Signage Video Screen & Eco Bar -->
            <RowDefinition Height="38*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: THE COMPLETE INTERACTIVE KIOSK DASHBOARD                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="24,10,24,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <!-- Decorative Corner Leaf Art -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="80" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 70 0 C 90 20 100 50 80 70 C 60 90 30 70 40 40 C 50 10 70 0 70 0 Z" Fill="#86EFAC"/>
                    <Path Data="M 20 10 C 40 30 50 60 30 80 C 10 90 0 70 10 40 C 20 20 20 10 20 10 Z" Fill="#4ADE80"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Top Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Hardware Status Card Bar -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: User Greeting Banner (Active Session) -->
                        <RowDefinition Height="*"/>    <!-- Row 3: Center Section (Left: Insert Bottle + Live Breakdown; Right: How-To + Top 5 Recyclers) -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Bottom Cards (Side-by-Side: Your Environmental Impact & Your Reward Balance - Same Height!) -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,10" MinHeight="75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Left: RVM Logo, Machine Name, and Tagline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="66" Height="66" Margin="0,0,12,0">
                                <Grid Width="46" Height="46">
                                    <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                    <Path Data="M 20 12 L 20 7 L 26 7 L 26 12 L 31 17 L 31 37 L 15 37 L 15 17 Z" Fill="#073B28"/>
                                    <Path Data="M 30 23 C 41 24 41 39 28 39 C 32 33 32 27 30 23 Z" Fill="#22C55E"/>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="32" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="6" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="11" FontWeight="Bold" Foreground="#073B28" Margin="1,-1,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                                    <TextBlock Text="Reduce • Reuse • Recycle • " FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="ری سائیکلنگ مشین" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Center: Welcome Headline with Urdu Nastaliq -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🍃 " FontSize="24" Foreground="#15803D"/>
                                <TextBlock Text="WELCOME  •  " FontSize="27" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text="خوش آمدید" FontFamily="{StaticResource UrduFont}" FontSize="28" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text=" 🍃" FontSize="24" Foreground="#15803D"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <TextBlock Text="Recycle Today for a Better Tomorrow • " FontSize="14" FontWeight="Medium" Foreground="#475569"/>
                                <TextBlock Text="سرسبز اور صاف پاکستان" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Medium" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Right: Date, Time & ISPP Logo Card -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="8" Padding="14,5" Margin="0,0,10,0" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📅 " FontSize="12"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="13.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="12"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="15" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ISPP Logo -->
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="8" Padding="4" Height="66" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/PecoDropDesktopApp;component/Assets/ispp.jpg" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: HARDWARE & MACHINE DIAGNOSTICS WIDGET -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,0,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="HARDWARE &amp; MACHINE DIAGNOSTICS 🔌" FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ConnectionText" Text="SERIAL: CONNECTED" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ApiStatusText" Text="API: ONLINE" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Demo Testing Screen Launcher Button -->
                                <Button Grid.Column="1" Click="DemoTestingButton_Click" Cursor="Hand" ToolTip="Open Hardware Simulator &amp; Demo Testing Panel (F2)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#0F172A" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="8,2.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎮 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="DEMO TESTING (F2)" FontSize="9" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- HARDWARE CONNECTION ERROR BANNER (DYNAMIC ALERT) -->
                            <Border x:Name="CompartmentWarningBanner" Grid.Row="3" Margin="0,4,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="8,4" Visibility="Collapsed">
                                <TextBlock x:Name="CompartmentWarningText" TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                            <Border x:Name="HardwareErrorBanner" Grid.Row="2" Margin="0,4,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#FEE2E2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HardwareErrorText" Text="HARDWARE CONNECTION ERROR: Check USB COM port • " FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                        <TextBlock Text="ہارڈویئر منسلک نہیں ہے" FontFamily="{StaticResource UrduFont}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="DEMO MODE 🎮" Background="#0F172A" Foreground="#34D399" FontSize="8.5" FontWeight="Bold" Padding="8,2" Margin="6,0,0,0" Cursor="Hand" Click="DemoTestingButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="3" Content="RETRY 🔄" Background="#DC2626" Foreground="White" FontSize="8.5" FontWeight="Bold" Padding="8,2" Margin="4,0,0,0" Cursor="Hand" Click="RetryHardwareConnection_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 2: ACTIVE AUTHENTICATED USER GREETING BANNER -->
                    <Border x:Name="UserGreetingBanner" Grid.Row="2" Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1.5" CornerRadius="10" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GreetingUserNameText" Text="Eco Citizen" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="#166534" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="GreetingPointsBalanceText" Text="Balance: 0 pts" FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- DISPLAY LAYOUT HOTKEY NOTIFICATION TOAST -->
                    <Border x:Name="LayoutToastBanner" Grid.Row="2" Background="#064E3B" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️ " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LayoutToastText" Text="Layout: Hardware Screen [LEFT] | Video Signage [RIGHT] (0012)" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ROW 3: CENTER SECTION (LEFT: INSERT BOTTLE + LIVE BREAKDOWN; RIGHT: HOW-TO + TOP 5 RECYCLERS) -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/> <!-- Left: Insert Bottle + Live Container Breakdown (70%) -->
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="3*"/> <!-- Right: Bilingual How-To Guide + Top 5 Leaderboard (30%) -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: INSERT BOTTLE CIRCLE + LIVE SESSION CONTAINER BREAKDOWN -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 1. Insert Bottle / Live Instruction Video Area (16:9 Best Fit) -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>    <!-- 2. Live Session Container Breakdown Dashboard (Above Impact) -->
                            </Grid.RowDefinitions>

                            <!-- 1. INSERT BOTTLE SECTION WITH INSTRUCTION VIDEO PLAYER & PLACEHOLDER (EXACT 16:9 BEST FIT) -->
                            <Border Grid.Row="0" HorizontalAlignment="Stretch" Height="308" CornerRadius="12" ClipToBounds="True" Background="#000000" BorderBrush="#E2EAE0" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                <Grid>
                                    <!-- Video Player: Fits Completely Within Container (Zero Cropping) -->
                                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded" MediaFailed="InstructionPlayer_MediaFailed"/>
                                    
                                    <!-- Placeholder (When video is stopped or loading) -->
                                    <Grid x:Name="InstructionPlaceholder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Border Background="#FBFDF9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="340" Height="340" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="4 4"/>
                                                    <Ellipse Width="320" Height="320" Fill="#FFFFFF" Stroke="#E2ECE0" StrokeThickness="1.8"/>
                                                    <Ellipse Width="298" Height="298" Fill="#F8FCF7" Stroke="#CBE0CB" StrokeThickness="1.5"/>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                            <TextBlock Text="INSERT  •  " FontSize="20" FontWeight="Black" Foreground="#073B28"/>
                                                            <TextBlock Text="داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="22" FontWeight="Black" Foreground="#073B28"/>
                                                        </StackPanel>
                                                        <TextBlock Text="BOTTLE / CAN / CUP / PAPER" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                        
                                                        <Border Background="#073B28" CornerRadius="18" Padding="18,6" HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="OR PRESS [0] TO START • " FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="یا 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>

                                    <!-- Touchless QR Start Floating Card (Visible on idle over video or placeholder) -->
                                    <Border x:Name="StartQrCard" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Background="#FFFFFF" BorderBrush="#15803D" BorderThickness="2" CornerRadius="14" Padding="10,8" Effect="{StaticResource CardShadow}" Panel.ZIndex="12" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                        <StackPanel HorizontalAlignment="Center" Width="190">
                                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,0,5" HorizontalAlignment="Center">
                                                <TextBlock Text="📱 TOUCHLESS SCAN" FontSize="9.5" FontWeight="Black" Foreground="#15803D"/>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="4" CornerRadius="8" HorizontalAlignment="Center">
                                                <Image x:Name="StartQrImage" Width="175" Height="175" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <TextBlock Text="SCAN TO START" FontSize="11" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center" Margin="0,4,0,1"/>
                                            <TextBlock Text="اسکین کریں اور شروع کریں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Portrait Idle Start Prompt Overlay: "PRESS 0 TO START" -->
                                    <Border x:Name="PortraitIdleStartOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Background="#DD064E3B" BorderBrush="#34D399" BorderThickness="2.5" CornerRadius="32" Padding="24,10" Panel.ZIndex="15" Cursor="Hand" MouseLeftButtonUp="StartButton_Click" Effect="{StaticResource CardShadow}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="22" Background="#10B981" Margin="0,0,14,0" BorderBrush="#FFFFFF" BorderThickness="2">
                                                <TextBlock Text="0" FontSize="21" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="PRESS " FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="[0]" FontSize="19" FontWeight="Black" Foreground="#34D399"/>
                                                    <TextBlock Text=" TO START RECYCLING" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    <TextBlock Text=" • شروع کرنے کے لیے 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="19" FontWeight="Bold" Foreground="#86EFAC" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="Or touch screen / scan touchless QR to begin session" FontSize="11" FontWeight="SemiBold" Foreground="#D1FAE5"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Portrait Active Intake Overlay: "PLEASE INSERT BOTTLE / CAN / PAPER" (3 Illuminated Apertures - DOUBLED SIZE & GEOMETRIC STYLES) -->
                                    <Border x:Name="PortraitActiveIntakeOverlay" Visibility="Collapsed" Panel.ZIndex="20" Background="#0A1813" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid Margin="16,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top Header (Doubled Font) -->
                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Border Background="#064E3B" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="16" Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
