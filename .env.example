# ------------------------------------------------------------------
# RVM-dash server configuration template. Copy to .env and fill in.
# NEVER commit a real .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------
NODE_ENV=production
PORT=5009
PUBLIC_BASE_URL=https://isprvm.binishaqsoft.com

# PostgreSQL (sole source of truth)
DB_TYPE=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_STRONG_PG_PASSWORD
PG_DATABASE=rvmpg

# Legacy MongoDB clusters (READ-ONLY sync source). Leave empty to disable Mongo features entirely.
MONGODB_URI_ONS_RVM=
MONGODB_URI_RVMAPP=
MONGODB_DBNAME=ONS-RVM

# Session signing secret (>= 32 random characters). Rotating it logs every user out.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# Master developer login for the portal (super admin). Leave MASTER_DEV_PASSWORD empty to disable the master login.
MASTER_DEV_USERNAME=onenet
MASTER_DEV_PASSWORD=CHANGE_ME_STRONG_MASTER_PASSWORD

# Shared secret that every kiosk sends as the x-kiosk-key header (set the same value as KioskApiKey in each kiosk config.txt).
# Leave empty only during migration; kiosk endpoints are open until this is set.
KIOSK_API_KEY=

# Set to true once the mobile app build that sends Authorization: Bearer tokens is rolled out.
ENFORCE_MOBILE_AUTH=false

# Optional: comma separated Google OAuth client IDs to pin the ID-token audience.
GOOGLE_CLIENT_IDS=

# Destructive PostgreSQL reset credential. Store only the SHA-256 digest in production.
DB_RESET_USERNAME=change-me
DB_RESET_PASSWORD_SHA256=replace-with-sha256-digest

# Gmail SMTP 2-Step Verification Credentials (OTP emails). Without these, OTP flows cannot deliver codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Trash to Cash Verification" <your_sender_email@gmail.com>
