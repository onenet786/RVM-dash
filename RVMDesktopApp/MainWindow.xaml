<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F4F8F4" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Modern Eco Color Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestMedium" Color="#0D5C3A"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        
        <!-- Drop Shadow Effects -->
        <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="#22C55E"/>

        <!-- Styles -->
        <Style x:Key="StatSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CircularStartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavCardButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" Padding="6,6" Margin="3,0"
                                Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F0FDF4"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Background" Value="#073B28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0D5C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 56%: Interactive Kiosk Dashboard & Session Telemetry -->
            <RowDefinition Height="56*"/>
            <!-- BOTTOM 44%: Digital Signage Video Player & Eco Bar -->
            <RowDefinition Height="44*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: INTERACTIVE RECYCLING KIOSK INTERFACE                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F8FAF8" Padding="20,10,20,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header Bar -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Welcome Headline -->
                    <RowDefinition Height="*"/>    <!-- Row 2: Center (Circular Insert + How to Use) -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Live Material Breakdown (Plastic, Can, TetraPak/Cup) -->
                    <RowDefinition Height="Auto"/> <!-- Row 4: Impact & Balance Summary -->
                    <RowDefinition Height="Auto"/> <!-- Row 5: 5 Navigation Action Cards -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Left: RVM Logo and Tagline -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#E8F5E9" BorderBrush="#22C55E" BorderThickness="2" Margin="0,0,10,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="♻" FontSize="24" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RVM" FontSize="22" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8.5" FontWeight="Bold" Foreground="#0D5C3A" Margin="1,-2,0,0"/>
                            <TextBlock Text="Reduce • Reuse • Recycle" FontSize="8.5" FontWeight="SemiBold" Foreground="#64748B" Margin="1,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hidden Compatibility Bindings -->
                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="MachineStateText" Visibility="Collapsed"/>
                    <TextBlock x:Name="ConnectionText" Visibility="Collapsed"/>
                    <TextBlock x:Name="DbStatusText" Visibility="Collapsed"/>
                    <TextBlock x:Name="ApiStatusText" Visibility="Collapsed"/>
                    <Ellipse x:Name="StatusDot" Visibility="Collapsed"/>
                    <Ellipse x:Name="DbDot" Visibility="Collapsed"/>
                    <Ellipse x:Name="ApiDot" Visibility="Collapsed"/>

                    <!-- Header Right: Date, Time & Company Branding Card -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Live Date & Time -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <TextBlock Text="📅 " FontSize="10"/>
                                    <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒 " FontSize="10"/>
                                    <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="12" FontWeight="Bold" Foreground="#073B28"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Environmental Solutions Badge -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,4" Effect="{StaticResource SoftShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="5" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌱" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Environmental Solutions" FontSize="10" FontWeight="Bold" Foreground="#073B28"/>
                                    <TextBlock Text="Pvt. Ltd." FontSize="8" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: WELCOME HEADLINE -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🍃 " FontSize="15" Foreground="#16A34A"/>
                        <TextBlock Text="WELCOME" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                        <TextBlock Text=" 🍃" FontSize="15" Foreground="#16A34A"/>
                    </StackPanel>
                    <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="11" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ROW 2: CENTER SECTION (CIRCULAR INSERT BUTTON + HOW TO USE RVM) -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: CIRCULAR INSERT BUTTON -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Effect="{StaticResource ElevatedShadow}" Padding="12,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Machine Scanner Status -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                <TextBlock x:Name="StatusText" Text="Press 0 to Start" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                                <TextBlock Text=" • " Foreground="#94A3B8"/>
                                <TextBlock x:Name="BottleInfoText" Text="Insert plastic bottle, can, cup or tetra pak" FontSize="10" FontWeight="Medium" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Interactive Target Circle -->
                            <Button Grid.Row="1" Style="{StaticResource CircularStartButton}" Click="StartButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="170" Height="170">
                                    <Ellipse Fill="#F0FDF4" Stroke="#86EFAC" StrokeThickness="2.5"/>
                                    <Ellipse Width="150" Height="150" Fill="#FFFFFF" Stroke="#16A34A" StrokeThickness="1.5" Effect="{StaticResource GlowShadow}"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Container Vector Illustration (Bottle + Can + Carton/Cup) -->
                                        <Canvas Width="64" Height="40" Margin="0,0,0,2">
                                            <!-- Bottle -->
                                            <Path Data="M 10 10 L 10 5 L 15 5 L 15 10 L 20 15 L 20 38 L 5 38 L 5 15 Z" Stroke="#073B28" StrokeThickness="1.5" Fill="#DCFCE7"/>
                                            <Rectangle Canvas.Left="8" Canvas.Top="3" Width="9" Height="2.5" Fill="#15803D" RadiusX="1" RadiusY="1"/>
                                            <!-- Can -->
                                            <Path Data="M 26 18 L 39 18 L 39 38 L 26 38 Z" Stroke="#073B28" StrokeThickness="1.5" Fill="#DBEAFE"/>
                                            <Ellipse Canvas.Left="26" Canvas.Top="16.5" Width="13" Height="4" Stroke="#073B28" StrokeThickness="1.2" Fill="#93C5FD"/>
                                            <!-- Carton / Cup -->
                                            <Path Data="M 45 14 L 59 14 L 56 38 L 47 38 Z" Stroke="#073B28" StrokeThickness="1.5" Fill="#FEF3C7"/>
                                            <Path Data="M 50 9 L 55 9 L 58 14 L 46 14 Z" Stroke="#073B28" StrokeThickness="1.2" Fill="#FDE68A"/>
                                        </Canvas>

                                        <TextBlock Text="INSERT" FontSize="17" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BOTTLE / CAN / CUP" FontSize="9" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,3"/>
                                        
                                        <Border Background="#073B28" CornerRadius="10" Padding="12,3" HorizontalAlignment="Center">
                                            <TextBlock Text="TO START" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Bottom Subtext / Control Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="Tap circle or press 0" FontSize="9" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Button Content="Stop (S)" Style="{StaticResource GreenActionButton}" Background="#DC2626" FontSize="9" Padding="6,2" Margin="8,0,0,0" Click="StopButton_Click"/>
                                <Button Content="Admin (A)" Style="{StaticResource GreenActionButton}" Background="#475569" FontSize="9" Padding="6,2" Margin="4,0,0,0" Click="AdminButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT: HOW TO USE RVM -->
                    <Border Grid.Column="2" Background="#073B28" CornerRadius="14" Effect="{StaticResource ElevatedShadow}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="HOW TO USE RVM" FontSize="12" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                <Border Background="#0D4B34" CornerRadius="8" Padding="8,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="1. INSERT" FontSize="10" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Insert bottle, can, cup or tetra pak" FontSize="8.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#0D4B34" CornerRadius="8" Padding="8,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="2. DETECT" FontSize="10" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Sensors scan, size and identify" FontSize="8.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#0D4B34" CornerRadius="8" Padding="8,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="3. REWARD" FontSize="10" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Earn points and claim to mobile wallet" FontSize="8.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="#0D4B34" CornerRadius="8" Padding="8,4" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="4" FontSize="10" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="4. SAVE ENVIRONMENT" FontSize="10" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Reduce pollution and keep cities clean" FontSize="8.5" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 3: LIVE SESSION DATA STRUCTURE (PLASTIC, CAN, TETRAPAK / CUP BREAKDOWN) -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,0,0,6" Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/> <!-- Plastic -->
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1.2*"/> <!-- Can -->
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1.3*"/> <!-- TetraPak / Cup -->
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="0.7*"/> <!-- Rejected -->
                        </Grid.ColumnDefinitions>

                        <!-- 1. PLASTIC (Bottles / Plastic Cups) -->
                        <Border Grid.Column="0" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="8" Padding="5,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🧴 PLASTIC" FontSize="10" FontWeight="Black" Foreground="#047857" TextAlignment="Center" Margin="0,0,0,2"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="S" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="M" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="L" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. CAN (Aluminium Cans) -->
                        <Border Grid.Column="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="5,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🥫 CAN" FontSize="10" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center" Margin="0,0,0,2"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="S" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="CanSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="M" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="CanMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="L" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="CanLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3. TETRA PAK / CUP (Juice cartons, foam & paper cups) -->
                        <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="5,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🧃 TETRA / CUP" FontSize="10" FontWeight="Black" Foreground="#B45309" TextAlignment="Center" Margin="0,0,0,2"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="S" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="M" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="L" Style="{StaticResource StatSubLabel}"/>
                                        <TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 4. REJECTED -->
                        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="5,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🚫 REJECT" FontSize="10" FontWeight="Black" Foreground="#DC2626" TextAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Grid.Row="1" x:Name="RejectedCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#DC2626" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 4: IMPACT & BALANCE SUMMARY -->
                <Grid Grid.Row="4" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: YOUR IMPACT -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,6" Effect="{StaticResource SoftShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="YOUR IMPACT 🍃" FontSize="11" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,4"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="6" Padding="4,4" Margin="0,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🍾 Items" FontSize="9" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TotalItemsText" Text="0" FontSize="17" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="6" Padding="4,4" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="☁️ CO₂" FontSize="9" FontWeight="Bold" Foreground="#0D9488" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="Co2SavedText" Text="0.00" FontSize="17" FontWeight="Black" Foreground="#0F766E" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="4,4" Margin="2,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="💧 Water" FontSize="9" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="WaterSavedText" Text="0.00" FontSize="17" FontWeight="Black" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Card: YOUR BALANCE -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,6" Effect="{StaticResource SoftShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="YOUR BALANCE 🎁" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TotalPointsText" Text="0" FontSize="22" FontWeight="Black" Foreground="#073B28"/>
                                    <TextBlock Text=" POINTS" FontSize="11" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Content="VIEW REWARDS" Style="{StaticResource GreenActionButton}" VerticalAlignment="Center" Click="ViewRewardsButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 5: BOTTOM 5 QUICK NAVIGATION CARDS -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource NavCardButton}" Click="SignInNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="SIGN IN / UP" FontSize="9" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage account >" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource NavCardButton}" Click="RewardsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎁" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="REWARDS" FontSize="9" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="View &amp; Redeem >" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource NavCardButton}" Click="TransactionNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="TRANSACTION" FontSize="9" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="View History >" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource NavCardButton}" Click="InstructionsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ℹ️" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="INSTRUCTIONS" FontSize="9" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Learn how to use >" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource NavCardButton}" Click="AnnouncementsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📢" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="ANNOUNCEMENTS" FontSize="9" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Latest news >" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Hidden UI bindings for background services & video windows -->
                <StackPanel Visibility="Collapsed">
                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                    <Grid x:Name="InstructionPlaceholder"/>
                    <ItemsControl x:Name="LeaderboardList"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM HALF: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY BAR        -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Hero Text Overlay -->
                        <RowDefinition Height="*"/>    <!-- Video Player Canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Green Eco Bar -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Semi-Transparent Marquee Banner -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Video Progress Indicator Mock Overlay -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#80000000" Padding="12,5" Margin="12,0,12,5" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0:05 / 0:20" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ProgressBar Grid.Column="1" Value="25" Height="4" Foreground="#22C55E" Background="#475569" BorderThickness="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="🔊  ⚙  ⛶" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="12,8" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waste" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Resources" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="For a Greener Future" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
