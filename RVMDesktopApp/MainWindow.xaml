<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Modern Natural Eco Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#083E28"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        
        <!-- Elevation Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.09" Color="#073B28"/>

        <!-- Styles -->
        <Style x:Key="StatSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HardwareChip" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style x:Key="HardwareChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CircularStartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="80" CenterY="80"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="80" CenterY="80"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Background" Value="#073B28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0D5C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 58%: Complete Kiosk Dashboard + Session Matrix + Live Leaderboard -->
            <RowDefinition Height="58*"/>
            <!-- BOTTOM 42%: Cinematic Digital Signage Video Screen & Eco Footer -->
            <RowDefinition Height="42*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP SCREEN: THE EMBEDDED KIOSK DASHBOARD                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="18,10,18,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <!-- Natural Decorative Foliage -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="70" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 70 0 C 90 15 100 40 80 55 C 60 70 30 50 40 30 C 45 10 70 0 70 0 Z" Fill="#86EFAC"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header with Branding & Hardware Status -->
                        <RowDefinition Height="*"/>    <!-- 1: Core 3-Column Working Kiosk Layout -->
                        <RowDefinition Height="Auto"/> <!-- 2: Bottom 5 Navigation Actions -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER & HARDWARE STATUS BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Left: RVM Logo and Machine Identifier -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,10,0">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                <Path Data="M 20 12 L 20 7 L 26 7 L 26 12 L 31 17 L 31 37 L 15 37 L 15 17 Z" Fill="#073B28"/>
                                <Path Data="M 30 23 C 41 24 41 39 28 39 C 32 33 32 27 30 23 Z" Fill="#22C55E"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="22" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="5" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8" FontWeight="Bold" Foreground="#073B28" Margin="1,-2,0,0"/>
                                <TextBlock Text="Reduce • Reuse • Recycle" FontSize="8" FontWeight="SemiBold" Foreground="#64748B" Margin="1,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Center: Live Hardware Telemetry Status Chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource HardwareChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ConnectionText" Text="HARDWARE: CONNECTED" Style="{StaticResource HardwareChipText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HardwareChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DbStatusText" Text="DB: OK" Style="{StaticResource HardwareChipText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HardwareChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ApiStatusText" Text="API: ONLINE" Style="{StaticResource HardwareChipText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource HardwareChip}">
                                <TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" Style="{StaticResource HardwareChipText}" Foreground="#0369A1"/>
                            </Border>
                        </StackPanel>

                        <!-- Hidden compatibility fields -->
                        <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                        <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                        <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>

                        <!-- Header Right: Date, Time & Company Branding Card -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="10,4" HorizontalAlignment="Right" Margin="0,0,0,2" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                        <TextBlock Text="📅 " FontSize="9.5"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="9.5"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="11.5" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="15" Height="15" CornerRadius="3" BorderBrush="#F59E0B" BorderThickness="1.2" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Environmental Solutions Pvt. Ltd." FontSize="9" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: THE COMPLETE 3-COLUMN INTEGRATED KIOSK SYSTEM -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <!-- Left 34%: Welcome, Circular Insert Target, and How to Use Guide -->
                            <ColumnDefinition Width="34*"/>
                            <ColumnDefinition Width="10"/>
                            <!-- Center 38%: Complete Live Material Session Breakdown Matrix -->
                            <ColumnDefinition Width="38*"/>
                            <ColumnDefinition Width="10"/>
                            <!-- Right 28%: Live Leaderboard, Impact Metrics & Balance -->
                            <ColumnDefinition Width="28*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========================================================================= -->
                        <!-- LEFT COLUMN: WELCOME + INSERT CIRCLE + HOW TO USE GUIDE                   -->
                        <!-- ========================================================================= -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="12" Padding="10,8" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Welcome -->
                                    <RowDefinition Height="*"/>    <!-- Insert Circle Button -->
                                    <RowDefinition Height="Auto"/> <!-- How To Use RVM -->
                                    <RowDefinition Height="Auto"/> <!-- Quick Controls -->
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="🍃 WELCOME 🍃" FontSize="13" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="9" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- The Insert Bottle / Can / Cup Circular Target Button -->
                                <Button Grid.Row="1" Style="{StaticResource CircularStartButton}" Click="StartButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="150" Height="150">
                                        <Ellipse Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3 3"/>
                                        <Ellipse Width="138" Height="138" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.5"/>
                                        <Ellipse Width="122" Height="122" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1.2" Effect="{StaticResource CircleShadow}"/>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="50" Height="30" Margin="0,0,0,2">
                                                <Path Data="M 8 8 L 8 4 L 12 4 L 12 8 L 16 12 L 16 28 L 4 28 L 4 12 Z" Stroke="#073B28" StrokeThickness="1.4" Fill="Transparent"/>
                                                <Path Data="M 20 14 L 30 14 L 30 28 L 20 28 Z" Stroke="#073B28" StrokeThickness="1.4" Fill="Transparent"/>
                                                <Path Data="M 35 11 L 45 11 L 43 28 L 37 28 Z" Stroke="#073B28" StrokeThickness="1.4" Fill="Transparent"/>
                                            </Canvas>
                                            <TextBlock Text="INSERT" FontSize="14" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="BOTTLE / CAN / CUP" FontSize="7.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,3"/>
                                            <Border Background="#073B28" CornerRadius="9" Padding="12,3" HorizontalAlignment="Center">
                                                <TextBlock Text="TO START" FontSize="9" FontWeight="Black" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- How to Use RVM 4-Step Process -->
                                <Border Grid.Row="2" Background="#083E28" CornerRadius="9" Padding="8,6" Margin="0,4,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="HOW TO USE RVM" FontSize="9.5" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1.5">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#115338" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="1" FontSize="7.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="1. INSERT (Bottle / Can / Cup)" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1.5">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#115338" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="2" FontSize="7.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="2. DETECT (Sensors scan &amp; classify)" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1.5">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#115338" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="3" FontSize="7.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="3. REWARD (Earn balance points)" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1.5">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#115338" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="4" FontSize="7.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="4. SAVE (Cleaner &amp; greener planet)" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- Hardware Action Buttons -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="STOP (S)" Style="{StaticResource GreenActionButton}" Background="#DC2626" FontSize="9.5" Padding="6,4" Click="StopButton_Click"/>
                                    <Button Grid.Column="2" Content="ADMIN (A)" Style="{StaticResource GreenActionButton}" Background="#475569" FontSize="9.5" Padding="6,4" Click="AdminButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ========================================================================= -->
                        <!-- CENTER COLUMN: COMPLETE LIVE SESSION DETAILS & CONTAINER COUNTER MATRIX   -->
                        <!-- ========================================================================= -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,8" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title & Live Scan Banner -->
                                    <RowDefinition Height="Auto"/> <!-- Machine Status & Last Scan info -->
                                    <RowDefinition Height="*"/>    <!-- Complete Material Breakdown (S/M/L) -->
                                    <RowDefinition Height="Auto"/> <!-- Live Total Items & Points Summary -->
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="SESSION CONTAINERS BREAKDOWN" FontSize="11.5" FontWeight="Black" Foreground="#073B28"/>
                                    <TextBlock Text="LIVE TELEMETRY 🟢" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Grid>

                                <!-- Live Machine Status and Last Scan Card -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MACHINE STATUS" Style="{StaticResource StatSubLabel}" TextAlignment="Left"/>
                                            <TextBlock x:Name="StatusText" Text="Press 0 to Start" FontSize="11" FontWeight="Bold" Foreground="#16A34A" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LAST SCAN DETECTED" Style="{StaticResource StatSubLabel}" TextAlignment="Left"/>
                                            <TextBlock x:Name="BottleInfoText" Text="Insert plastic bottle, can, or cup" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Complete Material Breakdown Table (PLASTIC, CAN, TETRA/CUP, REJECTED) -->
                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- REJECTED CONTAINER (Spans all 3 rows) -->
                                    <Border Grid.RowSpan="5" Grid.Column="7" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="4,2">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <TextBlock Text="REJECT" Style="{StaticResource StatSubLabel}" Foreground="#DC2626"/>
                                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                                <TextBlock x:Name="RejectedCountText" Text="0" FontSize="26" FontWeight="Black" Foreground="#DC2626" TextAlignment="Center"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>

                                    <!-- ROW 0: PLASTIC -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#D1FAE5" CornerRadius="6,0,0,6" BorderBrush="#10B981" BorderThickness="1,1,0,1" Padding="2">
                                        <Viewbox Stretch="Uniform"><TextBlock Text="PLASTIC" FontSize="16" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SMALL" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MEDIUM" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="5" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LARGE" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>

                                    <!-- ROW 2: CAN -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="#DBEAFE" CornerRadius="6,0,0,6" BorderBrush="#0EA5E9" BorderThickness="1,1,0,1" Padding="2">
                                        <Viewbox Stretch="Uniform"><TextBlock Text="CAN" FontSize="16" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SMALL" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanSmallCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MEDIUM" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanMediumCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="5" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LARGE" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanLargeCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>

                                    <!-- ROW 4: TETRA / CUP -->
                                    <Border Grid.Row="4" Grid.Column="0" Background="#FEF3C7" CornerRadius="6,0,0,6" BorderBrush="#F59E0B" BorderThickness="1,1,0,1" Padding="2">
                                        <Viewbox Stretch="Uniform"><TextBlock Text="TETRA/CUP" FontSize="13" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SMALL" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MEDIUM" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="5" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LARGE" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="22" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid>
                                    </Border>
                                </Grid>

                                <!-- Bottom Summary: Total Items + Total Points -->
                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL ITEMS" Style="{StaticResource StatSubLabel}"/>
                                            <TextBlock x:Name="TotalItemsText" Text="0" FontSize="18" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Fill="#E2E8F0" Width="1"/>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="SESSION POINTS" Style="{StaticResource StatSubLabel}"/>
                                            <TextBlock x:Name="TotalPointsText" Text="0" FontSize="18" FontWeight="Black" Foreground="#D97706" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ========================================================================= -->
                        <!-- RIGHT COLUMN: LIVE LEADERBOARD + YOUR IMPACT & BALANCE                    -->
                        <!-- ========================================================================= -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>    <!-- Live Leaderboard -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/> <!-- Your Impact Stats -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/> <!-- Your Balance Card -->
                            </Grid.RowDefinitions>

                            <!-- LIVE LEADERBOARD (Top Recyclers) -->
                            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="TOP RECYCLERS 🏆" FontSize="11" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,4"/>
                                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="46"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Rank" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Name" FontSize="8.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="Points" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="LeaderboardList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="2,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="16"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="46"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Width="14" Height="14" CornerRadius="7" Background="#E0F2FE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="👤" FontSize="7.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="9.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PointsBalance, StringFormat={}{0} pts}" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- YOUR IMPACT (CO2 & Water Saved) -->
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="10" Padding="8,5" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="YOUR IMPACT 🍃" FontSize="9.5" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,3"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="☁️ CO₂ Saved" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Co2SavedText" Text="0.00" FontSize="11.5" FontWeight="Black" Foreground="#0D9488"/>
                                                <TextBlock Text=" kg" FontSize="8.5" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="💧 Water Saved" FontSize="8" FontWeight="Bold" Foreground="#64748B"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="WaterSavedText" Text="0.00" FontSize="11.5" FontWeight="Black" Foreground="#2563EB"/>
                                                <TextBlock Text=" L" FontSize="8.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- YOUR BALANCE -->
                            <Border Grid.Row="4" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="10" Padding="10,6" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="YOUR BALANCE 🎁" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text, ElementName=TotalPointsText}" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                                            <TextBlock Text=" PTS" FontSize="9" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="REWARDS" Style="{StaticResource GreenActionButton}" FontSize="9.5" Padding="8,4" VerticalAlignment="Center" Click="ViewRewardsButton_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ROW 2: 5 QUICK ACTION NAVIGATION CARDS -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. SIGN IN / SIGN UP -->
                        <Button Grid.Column="0" Style="{StaticResource NavCardButton}" Click="SignInNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="👤" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SIGN IN / UP" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. REWARDS -->
                        <Button Grid.Column="1" Style="{StaticResource NavCardButton}" Click="RewardsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🎁" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="REWARDS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. TRANSACTION -->
                        <Button Grid.Column="2" Style="{StaticResource NavCardButton}" Click="TransactionNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🕒" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TRANSACTION" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. INSTRUCTIONS -->
                        <Button Grid.Column="3" Style="{StaticResource NavCardButton}" Click="InstructionsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="ℹ️" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="INSTRUCTIONS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. ANNOUNCEMENTS -->
                        <Button Grid.Column="4" Style="{StaticResource NavCardButton}" Click="AnnouncementsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#0D9488" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="📢" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ANNOUNCEMENTS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="Collapsed">
                        <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                        <Grid x:Name="InstructionPlaceholder"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM SCREEN: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY FOOTER   -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero text overlay -->
                        <RowDefinition Height="*"/>    <!-- Video canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom eco footer -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Signage Overlay Headline -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Footer Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="12,8" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waste" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Resources" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="18" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="11" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="For a Greener Future" FontSize="9" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
