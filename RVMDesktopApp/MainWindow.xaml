<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown"
        PreviewMouseDown="Window_UserActivity" PreviewMouseMove="Window_MouseMoveActivity"
        PreviewTouchDown="Window_UserActivity">
    
    <Window.Resources>
        <!-- Modern Natural Eco Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>

        <!-- Authentic Urdu Nastaliq Font Stack -->
        <FontFamily x:Key="UrduFont">./Fonts/#Jameel Noori Nastaleeq, pack://application:,,,/Fonts/#Jameel Noori Nastaleeq, ./Fonts/#Noto Nastaliq Urdu, pack://application:,,,/Fonts/#Noto Nastaliq Urdu, Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Gulzar, Pak Nastaleeq, Nafees Nastaleeq, Segoe UI, Arial</FontFamily>
        
        <!-- Soft Natural Drop Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="SubtleItemShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.09" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.22" Color="#0D9488"/>

        <!-- Interactive Circle Button -->
        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="250">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom 5 Navigation Card Buttons -->
        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" ClipToBounds="True">
        <Grid.RowDefinitions>
            <!-- TOP 67%: Interactive Kiosk Dashboard (Expanded to provide generous vertical room) -->
            <RowDefinition x:Name="TopDashboardRow" Height="67*"/>
            <!-- BOTTOM 33%: Cinematic Digital Signage Video Screen & Eco Bar -->
            <RowDefinition x:Name="BottomSignageRow" Height="33*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: THE COMPLETE INTERACTIVE KIOSK DASHBOARD                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="24,10,24,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2" ClipToBounds="True">
            <Grid>
                <!-- Decorative Corner Leaf Art -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="80" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 70 0 C 90 20 100 50 80 70 C 60 90 30 70 40 40 C 50 10 70 0 70 0 Z" Fill="#86EFAC"/>
                    <Path Data="M 20 10 C 40 30 50 60 30 80 C 10 90 0 70 10 40 C 20 20 20 10 20 10 Z" Fill="#4ADE80"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="HeaderRowDef" Height="Auto"/> <!-- Row 0: Top Header -->
                        <RowDefinition x:Name="HardwareStatusRowDef" Height="Auto"/> <!-- Row 1: Hardware Status Card Bar -->
                        <RowDefinition x:Name="MainContentRowDef" Height="*"/>    <!-- Row 2: Center Section (Left: Insert Bottle + Live Breakdown; Right: How-To + Top 5 Recyclers) -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Bottom Cards (Side-by-Side: Your Environmental Impact & Your Reward Balance - Same Height!) -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid x:Name="TopHeaderGrid" Grid.Row="0" Margin="0,0,0,8" MinHeight="68">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Left: RVM Logo, Machine Name, and Tagline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="52" Height="52" Margin="0,0,10,0">
                                <Grid Width="46" Height="46">
                                    <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                    <Path Data="M 20 12 L 20 7 L 26 7 L 26 12 L 31 17 L 31 37 L 15 37 L 15 17 Z" Fill="#073B28"/>
                                    <Path Data="M 30 23 C 41 24 41 39 28 39 C 32 33 32 27 30 23 Z" Fill="#22C55E"/>
                                </Grid>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="26" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="5" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="9" FontWeight="Bold" Foreground="#073B28" Margin="1,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Center: Welcome Headline with Urdu Nastaliq (Viewbox prevents label overriding) -->
                        <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="70" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🍃 " FontSize="22" Foreground="#15803D" VerticalAlignment="Center"/>
                                    <TextBlock Text="WELCOME  •  " FontSize="25" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    <TextBlock Text="خوش آمدید" FontFamily="{StaticResource UrduFont}" FontSize="25" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    <TextBlock Text=" 🍃" FontSize="22" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="Recycle Today for a Better Tomorrow • " FontSize="12.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBlock Text="سرسبز اور صاف پاکستان" FontFamily="{StaticResource UrduFont}" FontSize="13.5" FontWeight="Medium" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Viewbox>

                        <!-- Header Right: Date, Time & ISPP Logo Card -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="10,4" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="📅 " FontSize="11"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="11"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="13" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ISPP Logo -->
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="3" Height="52" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/RVMDesktopApp;component/Assets/ispp.jpg" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: HARDWARE & MACHINE DIAGNOSTICS WIDGET -->
                    <Border x:Name="HardwareStatusBar" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,0,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="HARDWARE &amp; MACHINE DIAGNOSTICS 🔌" FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ConnectionText" Text="SERIAL: CONNECTED" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ApiStatusText" Text="API: ONLINE" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- HARDWARE CONNECTION ERROR BANNER (DYNAMIC ALERT) -->
                            <Border x:Name="HardwareErrorBanner" Grid.Row="2" Margin="0,4,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#FEE2E2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HardwareErrorText" Text="HARDWARE CONNECTION ERROR: Check USB COM port • " FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                        <TextBlock Text="ہارڈویئر منسلک نہیں ہے" FontFamily="{StaticResource UrduFont}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="RETRY 🔄" Background="#DC2626" Foreground="White" FontSize="8.5" FontWeight="Bold" Padding="8,2" Margin="4,0,0,0" Cursor="Hand" Click="RetryHardwareConnection_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 2: MAIN DASHBOARD SECTION (FULL-WIDTH VIDEO ON TOP, HOW-TO DIRECTLY UNDER IT, BREAKDOWN + LEADERBOARD BELOW) -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 1. FULL WIDTH INSTRUCTIONAL VIDEO WIDGET (EXACT 16:9) -->
                            <RowDefinition x:Name="HowToUseSpacerRow1" Height="10"/>
                            <RowDefinition x:Name="HowToUseRow" Height="Auto"/> <!-- 2. BILINGUAL HOW TO USE RVM (DIRECTLY UNDER THE VIDEO) -->
                            <RowDefinition x:Name="HowToUseSpacerRow2" Height="6"/>
                            <RowDefinition x:Name="LowerDashboardRow" Height="*"/>    <!-- 3. LIVE SESSION BREAKDOWN + TOP 5 LEADERBOARD -->
                        </Grid.RowDefinitions>

                        <!-- 1. FULL WIDTH INSTRUCTION VIDEO PLAYER & PLACEHOLDER (EXACT 16:9 FIT - ZERO LETTERBOXING) -->
                        <Border x:Name="InstructionContainer" Grid.Row="0" HorizontalAlignment="Stretch" Height="490" CornerRadius="16" ClipToBounds="True" Background="#000000" BorderBrush="#E2EAE0" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                            <Grid ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="InstructionContainerScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <!-- Video Player: Stretches across full width 16:9 container with zero blank space -->
                                <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded" MediaFailed="InstructionPlayer_MediaFailed"/>
                                
                                <!-- Placeholder (When video is stopped or loading in idle mode) -->
                                <Grid x:Name="InstructionPlaceholder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border Background="#FBFDF9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="430" Height="430" Stroke="#CBD5E1" StrokeThickness="1.8" StrokeDashArray="4 4"/>
                                                <Ellipse Width="400" Height="400" Fill="#FFFFFF" Stroke="#E2ECE0" StrokeThickness="2.2"/>
                                                <Ellipse Width="368" Height="368" Fill="#F8FCF7" Stroke="#CBE0CB" StrokeThickness="1.8"/>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="INSERT  •  " FontSize="26" FontWeight="Black" Foreground="#073B28"/>
                                                        <TextBlock Text="داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="28" FontWeight="Black" Foreground="#073B28"/>
                                                    </StackPanel>
                                                    <TextBlock Text="BOTTLE / CAN / CUP / UBC" FontSize="14" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                                    
                                                    <Border Background="#073B28" CornerRadius="20" Padding="26,8" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="OR PRESS [0] TO START • " FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="یا 0 دبائیں" FontFamily="{StaticResource UrduFont}" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- Dynamic Touchless QR Start Floating Card (Visible on Idle on top of video or placeholder) -->
                                <Border x:Name="StartQrCard" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0" Background="#FFFFFF" BorderBrush="#15803D" BorderThickness="2.5" CornerRadius="16" Padding="12,10" Effect="{StaticResource CardShadow}" Panel.ZIndex="12" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                    <StackPanel HorizontalAlignment="Center" Width="170">
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="0,0,0,8" HorizontalAlignment="Center">
                                            <TextBlock Text="📱 TOUCHLESS START" FontSize="10" FontWeight="Black" Foreground="#15803D"/>
                                        </Border>
                                        <Border Background="#FFFFFF" Padding="4" CornerRadius="10" HorizontalAlignment="Center">
                                            <Image x:Name="StartQrImage" Width="145" Height="145" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <TextBlock Text="SCAN TO START" FontSize="13" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center" Margin="0,6,0,1"/>
                                        <TextBlock Text="اسکین کر کے شروع کریں" FontFamily="{StaticResource UrduFont}" FontSize="13.5" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================================================= -->
                                <!-- 1. STATE: PLEASE INSERT BOTTLE / CAN / UBC (SHOWN WHEN USER PRESSES 0)    -->
                                <!-- ========================================================================= -->
                                <Grid x:Name="PleaseInsertOverlay" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Background="#071E16" BorderBrush="#22C55E" BorderThickness="2">
                                        <Grid>
                                            <Ellipse Width="650" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#0D3B2C" Opacity="0.6">
                                                <Ellipse.Effect>
                                                    <BlurEffect Radius="60"/>
                                                </Ellipse.Effect>
                                            </Ellipse>

                                            <Grid Margin="24,16">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header Title -->
                                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border Background="#16A34A" CornerRadius="8" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="READY" FontSize="13" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        </Border>
                                                        <TextBlock Text="PLEASE INSERT BOTTLE / CAN / UBC" FontSize="26" FontWeight="Black" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="برائے مہربانی بوتل، کین یا یو بی سی اندر داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="23" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,3,0,0"/>

                                                    <!-- Active Authenticated User Greeting Badge -->
                                                    <Border x:Name="UserGreetingBanner" Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1.5" CornerRadius="10" Padding="14,5" HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="GreetingUserNameText" Text="Eco Citizen" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <Border Background="#166534" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock x:Name="GreetingPointsBalanceText" Text="Balance: 0 pts" FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Center: Visual Guide & Target Deposit Port -->
                                                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="280"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left Items: Bottle & Can -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <Border Background="#0D2D21" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="14" Padding="14,10" Margin="0,0,0,10" Effect="{StaticResource CardShadow}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🧴" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="PLASTIC BOTTLE" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                                                    <TextBlock Text="PET / HDPE • پلاسٹک بوتل" FontSize="11" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#0D2D21" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="14" Padding="14,10" Effect="{StaticResource CardShadow}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🥫" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="ALUMINIUM CAN" FontSize="14" FontWeight="Black" Foreground="#FFFFFF"/>
                                                                    <TextBlock Text="Beverage Can • ایلومینیم کین" FontSize="11" FontWeight="SemiBold" Foreground="#BAE6FD"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Center: Animated Insert Chamber Portal -->
                                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse Width="190" Height="190" Stroke="#22C55E" StrokeThickness="2.5" StrokeDashArray="6 3">
                                                            <Ellipse.RenderTransform>
                                                                <RotateTransform x:Name="InsertRingRotate" Angle="0" CenterX="95" CenterY="95"/>
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <Ellipse Width="165" Height="165" Fill="#051911" Stroke="#16A34A" StrokeThickness="3"/>
                                                        <Ellipse Width="140" Height="140" Fill="#0B2F22"/>

                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="InsertArrowIcon" Text="⬇" FontSize="38" FontWeight="Black" Foreground="#4ADE80" HorizontalAlignment="Center">
                                                                <TextBlock.RenderTransform>
                                                                    <TranslateTransform x:Name="InsertArrowBounce" Y="0"/>
                                                                </TextBlock.RenderTransform>
                                                            </TextBlock>
