<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F4F8F4" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestMedium" Color="#0D5C3A"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="LightBgGreen" Color="#F0FDF4"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        
        <!-- Drop Shadow Effects -->
        <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.08" Color="#073B28"/>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="25" ShadowDepth="0" Opacity="0.25" Color="#22C55E"/>

        <!-- Button Styles -->
        <Style x:Key="CircularStartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="120" CenterY="120"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="120" CenterY="120"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavCardButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" Padding="8,10" Margin="4,0"
                                Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F0FDF4"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Background" Value="#073B28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0D5C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 55%: Interactive Customer Dashboard -->
            <RowDefinition Height="55*"/>
            <!-- BOTTOM 45%: Cinematic Signage & Video Player -->
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: INTERACTIVE RECYCLING KIOSK INTERFACE                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F8FAF8" Padding="24,14,24,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Bar -->
                    <RowDefinition Height="Auto"/> <!-- Welcome Title -->
                    <RowDefinition Height="*"/>    <!-- Center Section: Circular Target + How To Use -->
                    <RowDefinition Height="Auto"/> <!-- Metrics: Your Impact + Your Balance -->
                    <RowDefinition Height="Auto"/> <!-- Bottom 5 Quick Navigation Cards -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Left: RVM Logo and Tagline -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Vector Circular Leaf Logo -->
                        <Border Width="48" Height="48" CornerRadius="24" Background="#E8F5E9" BorderBrush="#22C55E" BorderThickness="2" Margin="0,0,12,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="♻" FontSize="26" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RVM" FontSize="24" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="9" FontWeight="Bold" Foreground="#0D5C3A" Margin="1,-2,0,0"/>
                            <TextBlock Text="Reduce • Reuse • Recycle" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="1,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hidden bindings for background service compatibility -->
                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="MachineStateText" Visibility="Collapsed"/>
                    <TextBlock x:Name="ConnectionText" Visibility="Collapsed"/>
                    <TextBlock x:Name="DbStatusText" Visibility="Collapsed"/>
                    <TextBlock x:Name="ApiStatusText" Visibility="Collapsed"/>
                    <Ellipse x:Name="StatusDot" Visibility="Collapsed"/>
                    <Ellipse x:Name="DbDot" Visibility="Collapsed"/>
                    <Ellipse x:Name="ApiDot" Visibility="Collapsed"/>

                    <!-- Header Right: Date, Time & Company Branding Card -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Date & Time Card -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="📅 " FontSize="11"/>
                                    <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒 " FontSize="11"/>
                                    <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="13" FontWeight="Bold" Foreground="#073B28"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Environmental Solutions Company Badge -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6" Effect="{StaticResource SoftShadow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Environmental" FontSize="11" FontWeight="Bold" Foreground="#073B28"/>
                                    <TextBlock Text="Solutions Pvt. Ltd." FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: WELCOME BANNER -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🍃 " FontSize="17" Foreground="#16A34A"/>
                        <TextBlock Text="WELCOME" FontSize="20" FontWeight="Black" Foreground="#073B28"/>
                        <TextBlock Text=" 🍃" FontSize="17" Foreground="#16A34A"/>
                    </StackPanel>
                    <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="12" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- ROW 2: CENTER SECTION (CIRCULAR INSERT TARGET + HOW TO USE RVM GUIDE) -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: CIRCULAR INSERT BUTTON (Target Action) -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Effect="{StaticResource ElevatedShadow}" Padding="16,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Machine Scanner Status Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock x:Name="StatusText" Text="Ready to Recycle" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                                <TextBlock Text=" • " Foreground="#94A3B8"/>
                                <TextBlock x:Name="BottleInfoText" Text="Insert Bottle, Can or Cup" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- The Giant Interactive Circle -->
                            <Button Grid.Row="1" Style="{StaticResource CircularStartButton}" Click="StartButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="220" Height="220">
                                    <!-- Outer Pulse Ring -->
                                    <Ellipse Fill="#F0FDF4" Stroke="#86EFAC" StrokeThickness="3"/>
                                    <!-- Inner Container Ring -->
                                    <Ellipse Width="196" Height="196" Fill="#FFFFFF" Stroke="#16A34A" StrokeThickness="2" Effect="{StaticResource GlowShadow}"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Container Vector Graphic (Bottle + Can + Carton) -->
                                        <Canvas Width="74" Height="48" Margin="0,0,0,4">
                                            <!-- Bottle Outline -->
                                            <Path Data="M 12 12 L 12 6 L 18 6 L 18 12 L 24 18 L 24 44 L 6 44 L 6 18 Z" Stroke="#073B28" StrokeThickness="2" Fill="#DCFCE7"/>
                                            <!-- Bottle Cap -->
                                            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="10" Height="3" Fill="#15803D" RadiusX="1" RadiusY="1"/>
                                            <!-- Can Outline -->
                                            <Path Data="M 30 22 L 46 22 L 46 44 L 30 44 Z" Stroke="#073B28" StrokeThickness="2" Fill="#DBEAFE"/>
                                            <Ellipse Canvas.Left="30" Canvas.Top="20" Width="16" Height="5" Stroke="#073B28" StrokeThickness="1.5" Fill="#93C5FD"/>
                                            <!-- Cup / Carton Outline -->
                                            <Path Data="M 52 16 L 68 16 L 64 44 L 54 44 Z" Stroke="#073B28" StrokeThickness="2" Fill="#FEF3C7"/>
                                            <Path Data="M 58 10 L 64 10 L 67 16 L 53 16 Z" Stroke="#073B28" StrokeThickness="1.5" Fill="#FDE68A"/>
                                        </Canvas>

                                        <!-- Text Elements -->
                                        <TextBlock Text="INSERT" FontSize="20" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BOTTLE / CAN / CUP" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,5"/>
                                        
                                        <!-- Start Pill Badge -->
                                        <Border Background="#073B28" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center">
                                            <TextBlock Text="TO START" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Bottom Subtext / Hotkey hint -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Tap circle or press 0 to begin session" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <Button Content="Stop" Style="{StaticResource GreenActionButton}" Background="#DC2626" FontSize="10" Padding="8,2" Margin="10,0,0,0" Click="StopButton_Click"/>
                                <Button Content="Admin" Style="{StaticResource GreenActionButton}" Background="#475569" FontSize="10" Padding="8,2" Margin="4,0,0,0" Click="AdminButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT: HOW TO USE RVM (Dark Forest Green Card) -->
                    <Border Grid.Column="2" Background="#073B28" CornerRadius="16" Effect="{StaticResource ElevatedShadow}" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="HOW TO USE RVM" FontSize="14" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                <!-- Step 1 -->
                                <Border Background="#0D4B34" CornerRadius="10" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="12" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="1. INSERT" FontSize="11" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Insert your empty bottle / can / cup" FontSize="10" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 2 -->
                                <Border Background="#0D4B34" CornerRadius="10" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="12" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="2. DETECT" FontSize="11" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="We will scan, measure and identify it" FontSize="10" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 3 -->
                                <Border Background="#0D4B34" CornerRadius="10" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="12" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="3. REWARD" FontSize="11" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="Earn reward points or cash credits" FontSize="10" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Step 4 -->
                                <Border Background="#0D4B34" CornerRadius="10" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#15803D" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="4" FontSize="12" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="4. SAVE ENVIRONMENT" FontSize="11" FontWeight="Black" Foreground="#86EFAC"/>
                                            <TextBlock Text="You make our planet greener &amp; cleaner" FontSize="10" Foreground="#E2E8F0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 3: METRICS ROW (YOUR IMPACT + YOUR BALANCE) -->
                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: YOUR IMPACT -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14,10" Effect="{StaticResource SoftShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="YOUR IMPACT" FontSize="12" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text=" 🍃" FontSize="12" Foreground="#16A34A"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Bottles Recycled -->
                                <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="8" Padding="6,6" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🍾 Items" FontSize="10" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TotalItemsText" Text="0" FontSize="20" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metric 2: CO2 Saved -->
                                <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Padding="6,6" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="☁️ CO₂ (kg)" FontSize="10" FontWeight="Bold" Foreground="#0D9488" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="Co2SavedText" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#0F766E" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metric 3: Water Saved -->
                                <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="8" Padding="6,6" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="💧 Water (L)" FontSize="10" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="WaterSavedText" Text="0.00" FontSize="20" FontWeight="Black" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right Card: YOUR BALANCE -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="14,10" Effect="{StaticResource SoftShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="YOUR BALANCE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text=" 🎁" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TotalPointsText" Text="0" FontSize="26" FontWeight="Black" Foreground="#073B28"/>
                                    <TextBlock Text=" POINTS" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Content="VIEW REWARDS" Style="{StaticResource GreenActionButton}" VerticalAlignment="Center" Click="ViewRewardsButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 4: BOTTOM 5 QUICK NAVIGATION CARDS -->
                <Grid Grid.Row="4" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. SIGN IN / SIGN UP -->
                    <Button Grid.Column="0" Style="{StaticResource NavCardButton}" Click="SignInNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="SIGN IN / UP" FontSize="10" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage account >" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. REWARDS -->
                    <Button Grid.Column="1" Style="{StaticResource NavCardButton}" Click="RewardsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FEF3C7" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="🎁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="REWARDS" FontSize="10" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="View &amp; Redeem >" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. TRANSACTION -->
                    <Button Grid.Column="2" Style="{StaticResource NavCardButton}" Click="TransactionNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="🕒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TRANSACTION" FontSize="10" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="View History >" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. INSTRUCTIONS -->
                    <Button Grid.Column="3" Style="{StaticResource NavCardButton}" Click="InstructionsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#F3E8FF" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="ℹ️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="INSTRUCTIONS" FontSize="10" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Learn how to use >" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. ANNOUNCEMENTS -->
                    <Button Grid.Column="4" Style="{StaticResource NavCardButton}" Click="AnnouncementsNav_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FEE2E2" HorizontalAlignment="Center" Margin="0,0,0,3">
                                <TextBlock Text="📢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ANNOUNCE" FontSize="10" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <TextBlock Text="Latest news >" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Hidden Material counters to preserve all desktop app aggregation logic -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="PlasticSmallCountText"/>
                    <TextBlock x:Name="PlasticMediumCountText"/>
                    <TextBlock x:Name="PlasticLargeCountText"/>
                    <TextBlock x:Name="CanSmallCountText"/>
                    <TextBlock x:Name="CanMediumCountText"/>
                    <TextBlock x:Name="CanLargeCountText"/>
                    <TextBlock x:Name="TetraPakSmallCountText"/>
                    <TextBlock x:Name="TetraPakMediumCountText"/>
                    <TextBlock x:Name="TetraPakLargeCountText"/>
                    <TextBlock x:Name="RejectedCountText"/>
                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                    <Grid x:Name="InstructionPlaceholder"/>
                    <ItemsControl x:Name="LeaderboardList"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM HALF: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY BAR        -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Video Player Marquee Section -->
            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Hero Text Overlay -->
                        <RowDefinition Height="*"/>    <!-- Video Player Canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Green Eco Bar -->
                    </Grid.RowDefinitions>

                    <!-- Full Video Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Semi-Transparent Marquee Banner -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="20,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="12" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Video Progress Indicator Mock Overlay -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#80000000" Padding="14,6" Margin="14,0,14,6" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0:05 / 0:20" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ProgressBar Grid.Column="1" Value="25" Height="4" Foreground="#22C55E" Background="#475569" BorderThickness="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                <TextBlock Text="🔊  ⚙  ⛶" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="14,10" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- REDUCE -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waste" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- REUSE -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Resources" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- RECYCLE -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="For a Greener Future" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
