                                        </StackPanel>
                                    </Grid>

                                    <!-- YOUR REWARD BALANCE IN LIVE SESSION BREAKDOWN -->
                                    <Border Grid.Row="1" Background="#F4F8F1" BorderBrush="#86EFAC" BorderThickness="1.2" CornerRadius="10" Padding="14,6" Margin="0,2,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Gift Icon & Title -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="19" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎁" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="YOUR REWARD BALANCE" FontSize="13" FontWeight="Black" Foreground="#073B28"/>
                                                    <TextBlock Text="آپ کا موجودہ بیلنس اور پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Right: 3X Points Counter & Label -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TotalPointsText" Text="0" FontSize="56" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="POINTS" FontSize="28" FontWeight="Black" Foreground="#15803D"/>
                                                    <TextBlock Text="پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="30" FontWeight="Bold" Foreground="#15803D" Margin="0,-2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Collapsed for Event Handler / Code-Behind Compatibility -->
                                            <Button x:Name="ViewRewardsButton" Visibility="Collapsed" Click="ViewRewardsButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- 4 Doubled Material Breakdown Cards (Anchored At Bottom in Container) -->
                                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Plastic Card -->
                                        <Border Grid.Column="0" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1.2" CornerRadius="10" Padding="6,12" MinHeight="185">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,12">
                                                    <TextBlock Text="🧴" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PLASTIC" FontSize="11.5" FontWeight="Black" Foreground="#047857" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                                    <Border Background="#CCFBF1" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="5" Padding="5,3">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#CCFBF1" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PlasticTotalCountText" Text="0" FontSize="26" FontWeight="Black" Foreground="#047857" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10.5" FontWeight="Bold" Foreground="#0F766E" Margin="1.5,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Can Card -->
                                        <Border Grid.Column="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.2" CornerRadius="10" Padding="6,12" MinHeight="185">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,12">
                                                    <TextBlock Text="🥫" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CAN" FontSize="11.5" FontWeight="Black" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                                    <Border Background="#E0F2FE" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="5" Padding="5,3">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="CanTotalCountText" Text="0" FontSize="26" FontWeight="Black" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" Margin="1.5,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 3. UBC Card -->
                                        <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="10" Padding="6,12" MinHeight="185">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,12">
                                                    <TextBlock Text="🧃" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="UBC" FontSize="11.5" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                                    <Border Background="#FEF3C7" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#FEF3C7" CornerRadius="5" Padding="5,3" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#FEF3C7" CornerRadius="5" Padding="5,3">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="15" FontWeight="Black" Foreground="#B45309" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#D97706" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TetraPakTotalCountText" Text="0" FontSize="26" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10.5" FontWeight="Bold" Foreground="#D97706" Margin="1.5,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Reject Card -->
                                        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="10" Padding="6,12" MinHeight="185">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,10">
                                                    <TextBlock Text="🚫" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="REJECT" FontSize="11.5" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12">
                                                    <TextBlock x:Name="RejectedCountText" Text="0" FontSize="24" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" pcs" FontSize="10" FontWeight="Bold" Foreground="#EF4444" Margin="2,4,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Row="2" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL: " FontSize="8.5" FontWeight="Black" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="RejectedTotalCountText" Text="0" FontSize="17" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" pcs" FontSize="10.5" FontWeight="Bold" Foreground="#B91C1C" Margin="1.5,1,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- TOP 5 RECYCLERS LEADERBOARD (DARK SLEEK GAME STYLE) -->
                            <Border Grid.Column="2" Background="#12151E" CornerRadius="14" Padding="12,8" BorderBrush="#252E40" BorderThickness="1.2" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Top 5 Cards List -->
                                        <RowDefinition Height="Auto"/> <!-- Flashing Last Recycler Card -->
                                    </Grid.RowDefinitions>

                                    <!-- Leaderboard Header with Trophy & Subtitle -->
                                    <Grid Grid.Row="0" Margin="2,1,2,7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Leaderboard" FontSize="14.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="• لیڈر بورڈ" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="#4ADE80" Margin="0,0,4,0"/>
                                                <TextBlock Text="LIVE" FontSize="8.5" FontWeight="Black" Foreground="#4ADE80"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- User Cards List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="LeaderboardList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0DFFFFFF" BorderBrush="#1F283B" BorderThickness="1" CornerRadius="8" Padding="6,4.5" Margin="0,1,0,3" MinHeight="44">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/> <!-- Rank Number -->
                                                                <ColumnDefinition Width="38"/> <!-- Avatar with Ring -->
                                                                <ColumnDefinition Width="*"/>  <!-- Name & Progress Bar -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Points -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Rank Number (Vibrant Accent) -->
                                                            <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="16.5" FontWeight="Black" Foreground="{Binding RankColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                            <!-- Circular Avatar with Colored Ring -->
                                                            <Border Grid.Column="1" Width="33" Height="33" CornerRadius="16.5" BorderBrush="{Binding RingColor}" BorderThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>

                                                            <!-- Name & Horizontal Progress Bar -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,8,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                
                                                                <!-- Modern Progress Bar with Round Indicator -->
                                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="5" Background="#242D3D" Foreground="{Binding BarColor}" BorderThickness="0" Margin="0,3.5,0,0">
                                                                    <ProgressBar.Template>
                                                                        <ControlTemplate TargetType="ProgressBar">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" ClipToBounds="True">
                                                                                <Grid x:Name="PART_Track">
                                                                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2.5"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ProgressBar.Template>
                                                                </ProgressBar>
                                                            </StackPanel>

                                                            <!-- Points Numeric Score -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding PointsBalance}" FontSize="15" FontWeight="Black" Foreground="{Binding PointsColor}" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" pts" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,1,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- FLASHING LAST RECYCLER FOOTER CARD (Dark Glass Theme) -->
                                    <Border Grid.Row="2" Margin="0,4,0,0" CornerRadius="8" Padding="9,5" MinHeight="48" Background="#141D1B" BorderBrush="#047857" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Flashing Live Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Avatar Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name, Material & Time -->
                                                <ColumnDefinition Width="Auto"/> <!-- Points Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Flashing Pulse Badge -->
                                            <Border Grid.Column="0" x:Name="FlashingLiveBadge" Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="#4ADE80" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="RECENT" FontSize="8" FontWeight="Black" Foreground="#86EFAC"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Avatar Icon -->
                                            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="♻️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- User Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="LastRecyclerNameText" Text="Eco Champion" FontSize="11.5" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="LastRecyclerTimeText" Text=" • Just now" FontSize="8.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="LastRecyclerActivityText" Text="Recycled Container • آخری ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </StackPanel>

                                            <!-- Points Badge -->
                                            <Border Grid.Column="3" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastRecyclerPointsText" Text="+10 pts" FontSize="11.5" FontWeight="Black" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ROW 3: COLLAPSED (ENVIRONMENTAL IMPACT HIDDEN, REWARD BALANCE INTEGRATED INTO CONTAINER BREAKDOWN) -->
                    <Grid Grid.Row="3" Visibility="Collapsed">
                        <TextBlock x:Name="Co2SavedText" Text="0.00"/>
                        <TextBlock x:Name="WaterSavedText" Text="0.00"/>
                        <TextBlock x:Name="TotalItemsText" Text="0"/>
                    </Grid>

                    <!-- Hidden Elements for Background Subsystems -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="HeaderDotText"/>
                        <TextBlock x:Name="CommandCenterRvmNameText"/>
                        <TextBlock x:Name="AdHeaderRvmNameText"/>
                        <TextBlock x:Name="StatusText"/>
                        <TextBlock x:Name="BottleInfoText"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM SCREEN: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY FOOTER   -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero text overlay -->
                        <RowDefinition Height="*"/>    <!-- Video canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom eco footer -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Signage Overlay Headline -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="19" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Footer Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="12,8" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Waste • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="کچرا کم کریں" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Resources • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="دوبارہ استعمال" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="For a Greener Future • " FontSize="9.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="سرسبز مستقبل" FontFamily="{StaticResource UrduFont}" FontSize="10.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
