                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>     <!-- Right: Top 5 Leaderboard -->
                            </Grid.ColumnDefinitions>

                            <!-- LIVE SESSION CONTAINER BREAKDOWN (WITH YOUR REWARD BALANCE INTEGRATED) -->
                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Effect="{StaticResource CardShadow}">
