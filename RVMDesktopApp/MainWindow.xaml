<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Modern Natural Eco Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>
        
        <!-- Soft Natural Drop Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.09" Color="#073B28"/>

        <!-- Interactive Circle Button -->
        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="250">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="110" CenterY="110"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="110" CenterY="110"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom 5 Navigation Card Buttons -->
        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material Live Counter Chip Style -->
        <Style x:Key="MaterialChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 60%: Interactive Kiosk Dashboard (With Instruction Video In Insert Bottle Section) -->
            <RowDefinition Height="60*"/>
            <!-- BOTTOM 40%: Cinematic Digital Signage Video Screen & Eco Bar -->
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: THE COMPLETE INTERACTIVE KIOSK DASHBOARD                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="24,10,24,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <!-- Decorative Corner Leaf Art -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="80" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 70 0 C 90 20 100 50 80 70 C 60 90 30 70 40 40 C 50 10 70 0 70 0 Z" Fill="#86EFAC"/>
                    <Path Data="M 20 10 C 40 30 50 60 30 80 C 10 90 0 70 10 40 C 20 20 20 10 20 10 Z" Fill="#4ADE80"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Top Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Separate Cards Bar (Hardware Status Card & Session Details Card) -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Center Section (Insert Bottle / Instruction Video on Left + How-To & Leaderboard on Right) -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Double Height "Your Impact" & "Your Balance" Cards -->
                        <RowDefinition Height="Auto"/> <!-- Row 4: Bottom 5 Navigation Actions -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Left: RVM Logo, Machine Name, and Tagline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,10,0">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                <Path Data="M 20 12 L 20 7 L 26 7 L 26 12 L 31 17 L 31 37 L 15 37 L 15 17 Z" Fill="#073B28"/>
                                <Path Data="M 30 23 C 41 24 41 39 28 39 C 32 33 32 27 30 23 Z" Fill="#22C55E"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="24" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="5" Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" Margin="1,-2,0,0"/>
                                <TextBlock Text="Reduce • Reuse • Recycle • ری سائیکلنگ مشین" FontSize="8.5" FontWeight="SemiBold" Foreground="#64748B" Margin="1,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Center: Welcome Headline -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🍃 " FontSize="16" Foreground="#15803D"/>
                                <TextBlock Text="WELCOME  •  خوش آمدید" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text=" 🍃" FontSize="16" Foreground="#15803D"/>
                            </StackPanel>
                            <TextBlock Text="Recycle Today for a Better Tomorrow • سرسبز اور صاف پاکستان" FontSize="10.5" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Header Right: Date, Time & Company Branding Card -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="12,3.5" HorizontalAlignment="Right" Margin="0,0,0,2" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                        <TextBlock Text="📅 " FontSize="10"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="10"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="12" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#F59E0B" BorderThickness="1.2" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Environmental Solutions Pvt. Ltd." FontSize="9.5" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: TWO SEPARATE COMPONENT TILES (HARDWARE STATUS WIDGET & SESSION DETAILS TILE) -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- Tile 1: Hardware Status Widget -->
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.25*"/> <!-- Tile 2: Live Session Breakdown Tile -->
                        </Grid.ColumnDefinitions>

                        <!-- TILE 1: SEPARATE HARDWARE STATUS WIDGET -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="8" Padding="12,5" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock Text="HARDWARE &amp; MACHINE DIAGNOSTICS 🔌" FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                    <TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ConnectionText" Text="SERIAL: CONNECTED" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ApiStatusText" Text="API: ONLINE" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- TILE 2: SEPARATE LIVE SESSION DETAILS TILE -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="8" Padding="12,5" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <TextBlock Text="LIVE SESSION CONTAINER BREAKDOWN 📊" FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="BottleInfoText" Text="• Insert container" FontSize="9" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <!-- Plastic -->
                                    <Border Style="{StaticResource MaterialChip}" Background="#F0FDFA" BorderBrush="#99F6E4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🧴 Plastic: " FontSize="9" FontWeight="Bold" Foreground="#047857"/>
                                            <TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#047857"/>
                                            <TextBlock Text="s " FontSize="7.5" Foreground="#047857"/>
                                            <TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#047857"/>
                                            <TextBlock Text="m " FontSize="7.5" Foreground="#047857"/>
                                            <TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#047857"/>
                                            <TextBlock Text="l" FontSize="7.5" Foreground="#047857"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Can -->
                                    <Border Style="{StaticResource MaterialChip}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🥫 Can: " FontSize="9" FontWeight="Bold" Foreground="#0369A1"/>
                                            <TextBlock x:Name="CanSmallCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#0369A1"/>
                                            <TextBlock Text="s " FontSize="7.5" Foreground="#0369A1"/>
                                            <TextBlock x:Name="CanMediumCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#0369A1"/>
                                            <TextBlock Text="m " FontSize="7.5" Foreground="#0369A1"/>
                                            <TextBlock x:Name="CanLargeCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#0369A1"/>
                                            <TextBlock Text="l" FontSize="7.5" Foreground="#0369A1"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Tetra/Cup -->
                                    <Border Style="{StaticResource MaterialChip}" Background="#FFFBEB" BorderBrush="#FDE68A">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🧃 Tetra/Cup: " FontSize="9" FontWeight="Bold" Foreground="#B45309"/>
                                            <TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#B45309"/>
                                            <TextBlock Text="s " FontSize="7.5" Foreground="#B45309"/>
                                            <TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#B45309"/>
                                            <TextBlock Text="m " FontSize="7.5" Foreground="#B45309"/>
                                            <TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#B45309"/>
                                            <TextBlock Text="l" FontSize="7.5" Foreground="#B45309"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Reject -->
                                    <Border Style="{StaticResource MaterialChip}" Background="#FEF2F2" BorderBrush="#FECACA" Margin="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚫 Rej: " FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                            <TextBlock x:Name="RejectedCountText" Text="0" FontSize="10" FontWeight="Black" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 2: CENTER SECTION (INSERT BOTTLE / LIVE INSTRUCTION VIDEO ON LEFT, HOW TO USE & TOP 5 LEADERBOARD ON RIGHT) -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/> <!-- Insert Bottle / Live Instruction Video Area -->
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>    <!-- Bilingual How-To Guide (Top) + Top 5 Leaderboard (Bottom) -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: INSERT BOTTLE SECTION WITH INSTRUCTION VIDEO PLAYER & PLACEHOLDER -->
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Container with Rounded Border & Natural Drop Shadow -->
                            <Border Width="220" Height="220" CornerRadius="110" ClipToBounds="True" Background="#073B28" Effect="{StaticResource CircleShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                <Grid>
                                    <!-- 1. The Video Player (Visible when Instructinal.mp4 is available in Ads\Instructions) -->
                                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded"/>
                                    
                                    <!-- 2. The Insert Bottle Circle Placeholder (Visible when no video is playing) -->
                                    <Grid x:Name="InstructionPlaceholder">
                                        <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click">
                                            <Grid Width="220" Height="220">
                                                <!-- Outer Faint Dotted Ring -->
                                                <Ellipse Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3 3"/>
                                                <!-- Middle Natural Light Cream Ring -->
                                                <Ellipse Width="204" Height="204" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.5"/>
                                                <!-- Inner White Card Circle -->
                                                <Ellipse Width="184" Height="184" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1.2"/>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="68" Height="42" Margin="0,0,0,3">
                                                        <Path Data="M 12 12 L 12 5 L 18 5 L 18 12 L 23 17 L 23 41 L 5 41 L 5 17 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                                        <Rectangle Canvas.Left="10" Canvas.Top="2.5" Width="9" Height="2.5" Stroke="#073B28" StrokeThickness="1.2" Fill="#073B28"/>
                                                        <Path Data="M 28 20 L 42 20 L 42 41 L 28 41 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                                        <Ellipse Canvas.Left="28" Canvas.Top="17.5" Width="14" Height="4" Stroke="#073B28" StrokeThickness="1.2" Fill="Transparent"/>
                                                        <Path Data="M 48 15 L 62 15 L 59 41 L 50 41 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                                    </Canvas>

                                                    <TextBlock Text="INSERT  •  داخل کریں" FontSize="18" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="BOTTLE / CAN / CUP" FontSize="10.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,5"/>
                                                    
                                                    <Border Background="#073B28" CornerRadius="12" Padding="16,5" HorizontalAlignment="Center">
                                                        <TextBlock Text="TO START • شروع کریں" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- RIGHT: BILINGUAL HOW TO USE RVM (TOP) + TOP 5 LEADERBOARD (BOTTOM) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.35*"/> <!-- Bilingual How To Use RVM -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>     <!-- Top 5 Leaderboard with Larger Fonts -->
                            </Grid.RowDefinitions>

                            <!-- BILINGUAL HOW TO USE RVM (FULL WIDTH 4 STEPS) -->
                            <Border Grid.Row="0" Background="#073F26" CornerRadius="12" Padding="16,10" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="HOW TO USE RVM • مشین استعمال کرنے کا طریقہ" FontSize="13" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                    <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                        <!-- Step 1 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#115338" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="🍾" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="1. INSERT • بوتل یا کین ڈالیں" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Insert empty bottle, can or cup • خالی بوتل اندر داخل کریں" FontSize="9.5" Foreground="#CBD5E1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Step 2 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#115338" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="2. DETECT • شناخت اور اسکین" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Sensors scan &amp; identify • مشین خودکار اسکین کرے گی" FontSize="9.5" Foreground="#CBD5E1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Step 3 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#115338" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="🎁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="3. REWARD • پوائنٹس حاصل کریں" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Earn points / cash reward • انعام یا پوائنٹس پائیں" FontSize="9.5" Foreground="#CBD5E1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Step 4 -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#115338" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="🌱" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="4. SAVE • ماحول کو صاف بنائیں" FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/>
                                                <TextBlock Text="You make the planet greener • اپنے ماحول کو سرسبز بنائیں" FontSize="9.5" Foreground="#CBD5E1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <!-- TOP 5 LEADERBOARD (LARGER FONT SIZE & PROMINENT ICONS) -->
                            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="12,5" BorderBrush="#E5EAE1" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="TOP 5 RECYCLERS 🏆 بہترین ری سائیکلرز" FontSize="12" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,3"/>

                                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Rank" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Name" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="Points" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="LeaderboardList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="2,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26"/>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="65"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Width="16" Height="16" CornerRadius="8" Background="#E0F2FE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="👤" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PointsBalance, StringFormat={}{0} pts}" FontSize="11" FontWeight="Black" Foreground="#D97706" TextAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ROW 3: DOUBLE-HEIGHT "YOUR IMPACT" AND "YOUR BALANCE" CARDS WITH MUCH LARGER FONTS & VIBRANT NATURE ICONS -->
                    <Grid Grid.Row="3" Margin="0,0,0,8" MinHeight="116">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/> <!-- Double Height Your Impact Card -->
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>     <!-- Double Height Your Balance Card -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: DOUBLE HEIGHT "YOUR IMPACT 🍃" CARD (LARGER FONTS & BIGGER ICONS) -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="12" Padding="16,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="YOUR ENVIRONMENTAL IMPACT 🍃 ماحولیاتی فوائد" FontSize="13" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,6"/>

                                <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                    <!-- Row 1: Bottles Recycled -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" Margin="0,0,12,0">
                                            <TextBlock Text="🌱" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Bottles &amp; Containers Recycled" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="کل ری سائیکل شدہ بوتلیں اور کین" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="0" FontSize="24" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 2: CO2 Saved -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#ECFDF5" BorderBrush="#5EEAD4" BorderThickness="1.5" Margin="0,0,12,0">
                                            <TextBlock Text="🌳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Carbon Dioxide (CO₂) Saved (kg)" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="کاربن کا اخراج کم کیا گیا" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="0.00" FontSize="24" FontWeight="Black" Foreground="#0F766E" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 3: Water Saved -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" Margin="0,0,12,0">
                                            <TextBlock Text="💧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Fresh Water Saved (Liters)" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="صاف پانی کی بچت کی گئی" FontSize="9.5" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="0.00" FontSize="24" FontWeight="Black" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                    </Grid>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: DOUBLE HEIGHT "YOUR BALANCE 🎁" CARD (LARGER FONTS & BIGGER BUTTON) -->
                        <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="12" Padding="16,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <!-- Leaf Watermark in Background -->
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="80" Height="80" IsHitTestVisible="False" Opacity="0.40">
                                    <Path Data="M 40 10 C 65 15 80 40 60 65 C 30 70 15 50 20 20 Z" Fill="#86EFAC"/>
                                </Canvas>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: YOUR BALANCE + Urdu subtitle -->
                                    <StackPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="YOUR REWARD BALANCE" FontSize="13" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Text=" 🎁" FontSize="14" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="آپ کا موجودہ بیلنس اور پوائنٹس" FontSize="9.5" Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- Big Balance Number + POINTS -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,3,0,5">
                                        <TextBlock x:Name="TotalPointsText" Text="0" FontSize="48" FontWeight="Black" Foreground="#073B28" LineHeight="48"/>
                                        <TextBlock Text="RECYCLE POINTS  •  پوائنٹس" FontSize="12.5" FontWeight="Bold" Foreground="#15803D" Margin="2,-4,0,0"/>
                                    </StackPanel>

                                    <!-- Button: VIEW REWARDS -->
                                    <Button Grid.Row="2" Content="VIEW &amp; REDEEM REWARDS • انعام پائیں" HorizontalAlignment="Left" Background="#073B28" Foreground="White" FontSize="12.5" FontWeight="Bold" Padding="16,7" Cursor="Hand" Click="ViewRewardsButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 4: BOTTOM 5 QUICK NAVIGATION CARDS (Exact Circular Icon Badges) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. SIGN IN / SIGN UP -->
                        <Button Grid.Column="0" Style="{StaticResource BottomNavCardButton}" Click="SignInNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="👤" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SIGN IN / UP" FontSize="9.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage account" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. REWARDS -->
                        <Button Grid.Column="1" Style="{StaticResource BottomNavCardButton}" Click="RewardsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🎁" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="REWARDS" FontSize="9.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="View &amp; Redeem" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. TRANSACTION -->
                        <Button Grid.Column="2" Style="{StaticResource BottomNavCardButton}" Click="TransactionNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🕒" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TRANSACTION" FontSize="9.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="View History" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. INSTRUCTIONS -->
                        <Button Grid.Column="3" Style="{StaticResource BottomNavCardButton}" Click="InstructionsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="ℹ️" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="INSTRUCTIONS" FontSize="9.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Video Guide" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. ANNOUNCEMENTS -->
                        <Button Grid.Column="4" Style="{StaticResource BottomNavCardButton}" Click="AnnouncementsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#0D9488" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="📢" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ANNOUNCEMENTS" FontSize="9.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Latest news" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Hidden Elements for Background Subsystems -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="HeaderDotText"/>
                        <TextBlock x:Name="CommandCenterRvmNameText"/>
                        <TextBlock x:Name="AdHeaderRvmNameText"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM SCREEN: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY FOOTER   -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero text overlay -->
                        <RowDefinition Height="*"/>    <!-- Video canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom eco footer -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Signage Overlay Headline -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="19" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Footer Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="12,8" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waste • کچرا کم کریں" FontSize="9.5" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Resources • دوبارہ استعمال" FontSize="9.5" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="For a Greener Future • سرسبز مستقبل" FontSize="9.5" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
