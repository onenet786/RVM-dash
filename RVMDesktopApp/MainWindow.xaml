                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- RIGHT COLUMN: TEAL HOW-TO + TOP 5 RECYCLERS -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- How To Use RVM (Exact Same Height 308 as Video Player) -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>     <!-- Top 5 Leaderboard + Flashing Last Recycler -->
                            </Grid.RowDefinitions>

                            <!-- TEAL GLASSMORPHISM HOW TO USE RVM CARD (EXACT SAME SIZE AS VIDEO PLAYER) -->
                            <Border Grid.Row="0" HorizontalAlignment="Stretch" Height="308" CornerRadius="12" Padding="14,8" BorderThickness="1.5" Effect="{StaticResource TealGlassShadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EB0F766E" Offset="0.0"/>
                                        <GradientStop Color="#E0115E59" Offset="0.5"/>
                                        <GradientStop Color="#F0042E2B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#995EEAD4" Offset="0.0"/>
                                        <GradientStop Color="#4D2DD4BF" Offset="0.5"/>
                                        <GradientStop Color="#8014B8A6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <Grid>
                                    <Border CornerRadius="10" BorderThickness="1,1,0,0" BorderBrush="#50FFFFFF" IsHitTestVisible="False" Margin="-10,-4,-10,-4"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Title -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                            <TextBlock Text="✦ " FontSize="12" Foreground="#FACC15"/>
                                            <TextBlock Text="HOW TO USE RVM • " FontSize="13" FontWeight="Black" Foreground="#99F6E4"/>
                                            <TextBlock Text="طریقہ کار" FontFamily="{StaticResource UrduFont}" FontSize="14" FontWeight="Black" Foreground="#99F6E4"/>
                                            <TextBlock Text=" ✦" FontSize="12" Foreground="#FACC15"/>
                                        </StackPanel>

                                        <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                            <!-- Step 1: INSERT -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🍾" FontSize="13" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="1. INSERT • " FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="بوتل یا کین ڈالیں" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Insert empty container • خالی بوتل اندر داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="9.5" Foreground="#CCFBF1"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Step 2: DETECT -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🔍" FontSize="13" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="2. DETECT • " FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="شناخت اور اسکین" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Sensors scan &amp; identify • مشین خودکار اسکین کرے گی" FontFamily="{StaticResource UrduFont}" FontSize="9.5" Foreground="#CCFBF1"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Step 3: REWARD -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🎁" FontSize="13" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="3. REWARD • " FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="پوائنٹس حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Earn points reward • انعام یا پوائنٹس پائیں" FontFamily="{StaticResource UrduFont}" FontSize="9.5" Foreground="#CCFBF1"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Step 4: SAVE -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1.2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="🌱" FontSize="13" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="4. SAVE • " FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        <TextBlock Text="ماحول کو صاف بنائیں" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Make planet greener • اپنے ماحول کو سرسبز بنائیں" FontFamily="{StaticResource UrduFont}" FontSize="9.5" Foreground="#CCFBF1"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- TOP 5 RECYCLERS -->
                            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="12,6" BorderBrush="#E5EAE1" BorderThickness="1" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Top 5 Cards List -->
                                        <RowDefinition Height="Auto"/> <!-- Flashing Last Recycler Card -->
                                    </Grid.RowDefinitions>

                                    <!-- Leaderboard Header with Trophy & Subtitle -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆 " FontSize="13"/>
                                            <TextBlock Text="TOP 5 RECYCLERS • " FontSize="11.5" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                            <TextBlock Text="بہترین ری سائیکلرز" FontFamily="{StaticResource UrduFont}" FontSize="12" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Right">
                                            <TextBlock Text="LIVE RANKING" FontSize="8.5" FontWeight="Bold" Foreground="#166534"/>
                                        </Border>
                                    </Grid>

                                    <!-- User Cards List -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="LeaderboardList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,1.5,0,3" MinHeight="38" Effect="{StaticResource SubtleItemShadow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- Rank Badge -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                                                                <ColumnDefinition Width="*"/>    <!-- Name & Subtitle -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Points Chip -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Rank Pill -->
                                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="5" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="#" FontSize="8" FontWeight="Bold" Foreground="#D97706"/>
                                                                    <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Black" Foreground="#B45309"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Avatar Icon -->
                                                            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="👤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- User Display Name & Badge -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="Eco Champion • ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                            </StackPanel>

                                                            <!-- Points Badge / Chip -->
                                                            <Border Grid.Column="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="7,2.5" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PointsBalance}" FontSize="11.5" FontWeight="Black" Foreground="#047857"/>
                                                                    <TextBlock Text=" pts" FontSize="8.5" FontWeight="Bold" Foreground="#15803D" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- FLASHING LAST RECYCLER FOOTER CARD -->
                                    <Border Grid.Row="2" Margin="0,4,0,0" CornerRadius="7" Padding="8,4.5" MinHeight="36" BorderThickness="1.2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FEFCE8" Offset="0.0"/>
                                                <GradientStop Color="#F0FDF4" Offset="0.5"/>
                                                <GradientStop Color="#ECFDF5" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FDE047" Offset="0.0"/>
                                                <GradientStop Color="#86EFAC" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Flashing Live Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- Avatar Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name, Material & Time -->
                                                <ColumnDefinition Width="Auto"/> <!-- Points Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Flashing Pulse Badge -->
                                            <Border Grid.Column="0" x:Name="FlashingLiveBadge" Background="#FEF08A" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="#CA8A04" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="⚡ RECENT" FontSize="7.5" FontWeight="Black" Foreground="#854D0E"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Avatar Icon -->
                                            <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="#FEF9C3" BorderBrush="#FACC15" BorderThickness="1.2" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="♻️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- User Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="LastRecyclerNameText" Text="Eco Champion" FontSize="11" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="LastRecyclerTimeText" Text=" • Just now" FontSize="8" FontWeight="SemiBold" Foreground="#64748B" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="LastRecyclerActivityText" Text="Recycled Container • آخری ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="8.5" FontWeight="SemiBold" Foreground="#047857"/>
                                            </StackPanel>

                                            <!-- Points Chip -->
                                            <Border Grid.Column="3" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="6,2.5" VerticalAlignment="Center">
                                                <TextBlock x:Name="LastRecyclerPointsText" Text="+10 pts" FontSize="10.5" FontWeight="Black" Foreground="#15803D"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ROW 3: BOTTOM IMPACT & REWARD BALANCE CARDS (EXACT SAME WIDTH & ALIGNMENT AS ROW 2) -->
                    <Grid Grid.Row="3" Margin="0,0,0,8" Height="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- Left: Your Environmental Impact Card (Exact Same Width as Live Breakdown Above) -->
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/> <!-- Right: Your Reward Balance Card (Exact Same Width as How-To Above) -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: YOUR ENVIRONMENTAL IMPACT CARD (260px) -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="14" Padding="20,16" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="YOUR ENVIRONMENTAL IMPACT 🍃 " FontSize="14.5" FontWeight="Black" Foreground="#073B28"/>
                                    <TextBlock Text="ماحولیاتی فوائد" FontFamily="{StaticResource UrduFont}" FontSize="15.5" FontWeight="Black" Foreground="#073B28"/>
                                </StackPanel>

                                <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                    <!-- Row 1: Bottles Recycled -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" Margin="0,0,14,0">
                                            <TextBlock Text="🌱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Bottles &amp; Containers Recycled" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="کل ری سائیکل شدہ بوتلیں اور کین" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="0" FontSize="32" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 2: CO2 Saved -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#ECFDF5" BorderBrush="#5EEAD4" BorderThickness="1.5" Margin="0,0,14,0">
                                            <TextBlock Text="🌳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Carbon Dioxide (CO₂) Saved (kg)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="کاربن کا اخراج کم کیا گیا" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="0.00" FontSize="32" FontWeight="Black" Foreground="#0F766E" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 3: Water Saved -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" Margin="0,0,14,0">
                                            <TextBlock Text="💧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Fresh Water Saved (Liters)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="صاف پانی کی بچت کی گئی" FontFamily="{StaticResource UrduFont}" FontSize="12" Foreground="#64748B"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="0.00" FontSize="32" FontWeight="Black" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                    </Grid>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: YOUR REWARD BALANCE CARD (260px) -->
                        <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="14" Padding="20,16" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <!-- Leaf Watermark in Background -->
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="100" Height="100" IsHitTestVisible="False" Opacity="0.35">
                                    <Path Data="M 50 12 C 80 18 100 50 75 80 C 38 88 18 62 25 25 Z" Fill="#86EFAC"/>
                                </Canvas>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: YOUR BALANCE + Urdu Nastaliq subtitle (Top Left) -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="YOUR REWARD BALANCE" FontSize="15" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Text=" 🎁" FontSize="16" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="آپ کا موجودہ بیلنس اور پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="12.5" Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- ONLY POINTS: Right-Aligned, Generously Centered -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                        <TextBlock x:Name="TotalPointsText" Text="0" FontSize="58" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <TextBlock Text="RECYCLE POINTS  •  " FontSize="13.5" FontWeight="Bold" Foreground="#15803D"/>
                                            <TextBlock Text="پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="15" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Button: VIEW REWARDS (Bottom Left) -->
                                    <Button Grid.Row="2" HorizontalAlignment="Left" Background="#073B28" Foreground="White" Padding="20,10" Cursor="Hand" Click="ViewRewardsButton_Click">
