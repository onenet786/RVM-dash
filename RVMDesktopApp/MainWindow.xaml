<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Modern Natural Eco Palette -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>

        <!-- Authentic Urdu Nastaliq Font Stack -->
        <FontFamily x:Key="UrduFont">Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Gulzar, Pak Nastaleeq, Nafees Nastaleeq, Segoe UI, Arial</FontFamily>
        
        <!-- Soft Natural Drop Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="SubtleItemShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.09" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.22" Color="#0D9488"/>

        <!-- Interactive Circle Button -->
        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="250">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom 5 Navigation Card Buttons -->
        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 62%: Interactive Kiosk Dashboard -->
            <RowDefinition Height="62*"/>
            <!-- BOTTOM 38%: Cinematic Digital Signage Video Screen & Eco Bar -->
            <RowDefinition Height="38*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP HALF: THE COMPLETE INTERACTIVE KIOSK DASHBOARD                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="24,10,24,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <Grid>
                <!-- Decorative Corner Leaf Art -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="80" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 70 0 C 90 20 100 50 80 70 C 60 90 30 70 40 40 C 50 10 70 0 70 0 Z" Fill="#86EFAC"/>
                    <Path Data="M 20 10 C 40 30 50 60 30 80 C 10 90 0 70 10 40 C 20 20 20 10 20 10 Z" Fill="#4ADE80"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Top Header -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: Hardware Status Card Bar -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Center Section (Left: Insert Bottle + Live Breakdown; Right: How-To + Top 5 Recyclers) -->
                        <RowDefinition Height="Auto"/> <!-- Row 3: Bottom Cards (Side-by-Side: Your Environmental Impact & Your Reward Balance - Same Height!) -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Header Left: RVM Logo, Machine Name, and Tagline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="46" Margin="0,0,10,0">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                <Path Data="M 20 12 L 20 7 L 26 7 L 26 12 L 31 17 L 31 37 L 15 37 L 15 17 Z" Fill="#073B28"/>
                                <Path Data="M 30 23 C 41 24 41 39 28 39 C 32 33 32 27 30 23 Z" Fill="#22C55E"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="24" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="5" Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" Margin="1,-2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="1,1,0,0">
                                    <TextBlock Text="Reduce • Reuse • Recycle • " FontSize="8.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="ری سائیکلنگ مشین" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Center: Welcome Headline with Urdu Nastaliq -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🍃 " FontSize="16" Foreground="#15803D"/>
                                <TextBlock Text="WELCOME  •  " FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text="خوش آمدید" FontFamily="{StaticResource UrduFont}" FontSize="19" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text=" 🍃" FontSize="16" Foreground="#15803D"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Recycle Today for a Better Tomorrow • " FontSize="10.5" FontWeight="Medium" Foreground="#475569"/>
                                <TextBlock Text="سرسبز اور صاف پاکستان" FontFamily="{StaticResource UrduFont}" FontSize="11.5" FontWeight="Medium" Foreground="#475569"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Right: Date, Time & ISPP Logo Card -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="12,3.5" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                        <TextBlock Text="📅 " FontSize="10"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="10"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="12" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ISPP Logo -->
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="7" Padding="3" Height="46" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/RVMDesktopApp;component/Assets/ispp.jpg" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: HARDWARE & MACHINE DIAGNOSTICS WIDGET -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,0,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <TextBlock Text="HARDWARE &amp; MACHINE DIAGNOSTICS 🔌" FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConnectionText" Text="SERIAL: CONNECTED" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="6,2.5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ApiStatusText" Text="API: ONLINE" FontSize="9" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- HARDWARE CONNECTION ERROR BANNER (DYNAMIC ALERT) -->
                            <Border x:Name="HardwareErrorBanner" Grid.Row="2" Margin="0,4,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#FEE2E2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HardwareErrorText" Text="HARDWARE CONNECTION ERROR: Check USB COM port • " FontSize="9" FontWeight="Bold" Foreground="#DC2626"/>
                                        <TextBlock Text="ہارڈویئر منسلک نہیں ہے" FontFamily="{StaticResource UrduFont}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="RETRY 🔄" Background="#DC2626" Foreground="White" FontSize="8.5" FontWeight="Bold" Padding="8,2" Margin="6,0,0,0" Cursor="Hand" Click="RetryHardwareConnection_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 2: CENTER SECTION (LEFT: INSERT BOTTLE + LIVE BREAKDOWN; RIGHT: HOW-TO + TOP 5 RECYCLERS) -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/> <!-- Left: Insert Bottle + Live Container Breakdown -->
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/> <!-- Right: Bilingual How-To Guide + Top 5 Leaderboard -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: INSERT BOTTLE CIRCLE + LIVE SESSION CONTAINER BREAKDOWN -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 1. Insert Bottle / Live Instruction Video Area (16:9 Best Fit) -->
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>    <!-- 2. Live Session Container Breakdown Dashboard (Above Impact) -->
                            </Grid.RowDefinitions>

                            <!-- 1. INSERT BOTTLE SECTION WITH INSTRUCTION VIDEO PLAYER & PLACEHOLDER (EXACT 16:9 BEST FIT) -->
                            <Border Grid.Row="0" HorizontalAlignment="Stretch" Height="308" CornerRadius="12" ClipToBounds="True" Background="#000000" BorderBrush="#E2EAE0" BorderThickness="1.5" Effect="{StaticResource CardShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                <Grid>
                                    <!-- Video Player: Fits Completely Within Container (Zero Cropping) -->
                                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded" MediaFailed="InstructionPlayer_MediaFailed"/>
                                    
                                    <!-- Placeholder (When video is stopped or loading) -->
                                    <Grid x:Name="InstructionPlaceholder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Border Background="#FBFDF9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="310" Height="310" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="4 4"/>
                                                    <Ellipse Width="292" Height="292" Fill="#FFFFFF" Stroke="#E2ECE0" StrokeThickness="1.8"/>
                                                    <Ellipse Width="270" Height="270" Fill="#F8FCF7" Stroke="#CBE0CB" StrokeThickness="1.5"/>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="80" Height="46" Margin="0,0,0,6">
                                                            <Path Data="M 12 12 L 12 5 L 18 5 L 18 12 L 23 17 L 23 41 L 5 41 L 5 17 Z" Stroke="#073B28" StrokeThickness="2.6" Fill="Transparent"/>
                                                            <Rectangle Canvas.Left="10" Canvas.Top="2.5" Width="11" Height="3" Stroke="#073B28" StrokeThickness="1.6" Fill="#073B28"/>
                                                            <Path Data="M 28 20 L 42 20 L 42 41 L 28 41 Z" Stroke="#073B28" StrokeThickness="2.6" Fill="Transparent"/>
                                                            <Ellipse Canvas.Left="28" Canvas.Top="17.5" Width="15" Height="4.8" Stroke="#073B28" StrokeThickness="1.6" Fill="Transparent"/>
                                                            <Path Data="M 48 15 L 62 15 L 59 41 L 50 41 Z" Stroke="#073B28" StrokeThickness="2.6" Fill="Transparent"/>
                                                        </Canvas>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                            <TextBlock Text="INSERT  •  " FontSize="21" FontWeight="Black" Foreground="#073B28"/>
                                                            <TextBlock Text="داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="22.5" FontWeight="Black" Foreground="#073B28"/>
                                                        </StackPanel>
                                                        <TextBlock Text="BOTTLE / CAN / CUP / UBC" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
                                                        
                                                        <Border Background="#073B28" CornerRadius="16" Padding="20,6" HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="TO START • " FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="شروع کریں" FontFamily="{StaticResource UrduFont}" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 2. LIVE SESSION CONTAINER BREAKDOWN (Directly above Your Environmental Impact - DOUBLED SIZE) -->
                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header Title -->
                                        <RowDefinition Height="*"/>    <!-- Flexible Space -->
                                        <RowDefinition Height="Auto"/> <!-- 4 Material Cards Anchored at Bottom in Container -->
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📊 " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="LIVE SESSION CONTAINER BREAKDOWN • " FontSize="12.5" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                            <TextBlock Text="سیشن کی تفصیل" FontFamily="{StaticResource UrduFont}" FontSize="13.5" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 4 Doubled Material Breakdown Cards (Anchored At Bottom in Container) -->
                                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Plastic Card -->
                                        <Border Grid.Column="0" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1.2" CornerRadius="8" Padding="6,8" MinHeight="88">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🧴" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="PLASTIC" FontSize="12" FontWeight="Black" Foreground="#047857" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Background="#CCFBF1" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#CCFBF1" CornerRadius="4" Padding="5,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#047857" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Can Card -->
                                        <Border Grid.Column="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.2" CornerRadius="8" Padding="6,8" MinHeight="88">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🥫" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CAN" FontSize="12" FontWeight="Black" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="S:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanSmallCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="M:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanMediumCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="5,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="L:" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="CanLargeCountText" Text="0" FontSize="16" FontWeight="Black" Foreground="#0369A1" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 3. UBC (Used Beverage Carton / Can) Card -->
                                        <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.2" CornerRadius="8" Padding="6,8" MinHeight="88">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <TextBlock Text="🧃" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="UBC" FontSize="12" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="5,2" Margin="0,0,3,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
