                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header Title -->
                                        <RowDefinition Height="Auto"/> <!-- YOUR REWARD BALANCE CARD -->
                                        <RowDefinition Height="*"/>    <!-- Flexible Space -->
                                        <RowDefinition Height="Auto"/> <!-- 4 Material Cards Anchored at Bottom in Container -->
