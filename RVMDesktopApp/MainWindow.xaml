                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Reject Card -->
                                        <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.2" CornerRadius="8" Padding="6,8" MinHeight="88">
