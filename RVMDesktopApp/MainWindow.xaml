<Window x:Class="RVMDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Natural Organic Eco Palette Matching Image -->
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#083E28"/>
        <SolidColorBrush x:Key="EcoGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="NaturalCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NaturalSoftBg" Color="#F2F6EF"/>
        <SolidColorBrush x:Key="TextMain" Color="#0F241A"/>
        <SolidColorBrush x:Key="TextSub" Color="#475569"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        
        <!-- Soft Natural Shadows -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.10" Color="#073B28"/>

        <!-- Interactive Circle Button Template -->
        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="110" CenterY="110"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="110" CenterY="110"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom 5 Navigation Card Buttons -->
        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="10" Padding="4,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP 55%: Interactive Natural Kiosk UI -->
            <RowDefinition Height="55*"/>
            <!-- BOTTOM 45%: Cinematic Digital Signage Video Screen -->
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- TOP SCREEN: INTERACTIVE NATURAL KIOSK INTERFACE                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#F7F9F5" Padding="28,14,28,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2">
            <!-- Background Decorative Natural Foliage Leaves -->
            <Grid>
                <!-- Decorative Top Right Leaf Art -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="80" IsHitTestVisible="False" Opacity="0.35">
                    <Path Data="M 70 0 C 90 20 100 50 80 70 C 60 90 30 70 40 40 C 50 10 70 0 70 0 Z" Fill="#86EFAC"/>
                    <Path Data="M 20 10 C 40 30 50 60 30 80 C 10 90 0 70 10 40 C 20 20 20 10 20 10 Z" Fill="#4ADE80"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- 1: Welcome -->
                        <RowDefinition Height="*"/>    <!-- 2: Insert Circle + How to Use -->
                        <RowDefinition Height="Auto"/> <!-- 3: Your Impact & Your Balance -->
                        <RowDefinition Height="Auto"/> <!-- 4: 5 Navigation Action Cards -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: RVM Logo and Tagline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Circular Bottle-Leaf Logo Graphic -->
                            <Grid Width="50" Height="50" Margin="0,0,12,0">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.5" Fill="Transparent"/>
                                <!-- Bottle Silhouette inside -->
                                <Path Data="M 22 14 L 22 9 L 28 9 L 28 14 L 33 19 L 33 40 L 17 40 L 17 19 Z" Fill="#073B28"/>
                                <!-- Curved Leaf wrapping bottle -->
                                <Path Data="M 32 25 C 44 26 44 42 30 42 C 34 36 34 29 32 25 Z" Fill="#22C55E"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="26" FontWeight="Black" Foreground="#073B28" FontFamily="Segoe UI Black, Segoe UI, Arial"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="9" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="9" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="9" FontWeight="Bold" Foreground="#073B28" Margin="1,-3,0,0"/>
                                <TextBlock Text="Reduce • Reuse • Recycle" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" Margin="1,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Hidden compatibility fields -->
                        <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                        <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                        <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>
                        <TextBlock x:Name="MachineStateText" Visibility="Collapsed"/>
                        <TextBlock x:Name="ConnectionText" Visibility="Collapsed"/>
                        <TextBlock x:Name="DbStatusText" Visibility="Collapsed"/>
                        <TextBlock x:Name="ApiStatusText" Visibility="Collapsed"/>
                        <Ellipse x:Name="StatusDot" Visibility="Collapsed"/>
                        <Ellipse x:Name="DbDot" Visibility="Collapsed"/>
                        <Ellipse x:Name="ApiDot" Visibility="Collapsed"/>

                        <!-- Right: Date/Time Box & Environmental Solutions Pvt. Ltd. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Rounded Date & Time Box -->
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="8" Padding="12,5" HorizontalAlignment="Right" Margin="0,0,0,4" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                        <TextBlock Text="📅 " FontSize="10"/>
                                        <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕒 " FontSize="10"/>
                                        <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="12" FontWeight="Bold" Foreground="#073B28"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Company Name Logo -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Stylized geometric S logo -->
                                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#F59E0B" BorderThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Environmental" FontSize="10" FontWeight="Bold" Foreground="#073B28"/>
                                    <TextBlock Text="Solutions Pvt. Ltd." FontSize="8" FontWeight="SemiBold" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: WELCOME HEADLINE -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🍃 " FontSize="16" Foreground="#15803D"/>
                            <TextBlock Text="WELCOME" FontSize="19" FontWeight="Black" Foreground="#073B28"/>
                            <TextBlock Text=" 🍃" FontSize="16" Foreground="#15803D"/>
                        </StackPanel>
                        <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="11" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- ROW 2: CENTER SECTION (INSERT CIRCLE ON LEFT, COMPACT HOW TO USE ON RIGHT) -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: THE INSERT BOTTLE / CAN CIRCULAR BUTTON -->
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click">
                                <Grid Width="220" Height="220">
                                    <!-- Outer Faint Dotted Ring -->
                                    <Ellipse Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="3 3"/>
                                    <!-- Middle Natural Light Cream Ring -->
                                    <Ellipse Width="204" Height="204" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="2"/>
                                    <!-- Inner White Card Circle -->
                                    <Ellipse Width="184" Height="184" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1.5" Effect="{StaticResource CircleShadow}"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Container Line-Art Graphic (Bottle + Can + Carton) -->
                                        <Canvas Width="70" Height="44" Margin="0,0,0,4">
                                            <!-- Bottle -->
                                            <Path Data="M 12 12 L 12 6 L 18 6 L 18 12 L 24 18 L 24 44 L 6 44 L 6 18 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="10" Height="3" Stroke="#073B28" StrokeThickness="1.5" Fill="#073B28"/>
                                            <!-- Can -->
                                            <Path Data="M 29 22 L 44 22 L 44 44 L 29 44 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="29" Canvas.Top="20" Width="15" Height="4.5" Stroke="#073B28" StrokeThickness="1.5" Fill="Transparent"/>
                                            <!-- Carton -->
                                            <Path Data="M 50 16 L 65 16 L 62 44 L 52 44 Z" Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                                            <Path Data="M 55 10 L 61 10 L 64 16 L 51 16 Z" Stroke="#073B28" StrokeThickness="1.5" Fill="Transparent"/>
                                        </Canvas>

                                        <!-- Text Details -->
                                        <TextBlock Text="INSERT" FontSize="20" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BOTTLE / CAN" FontSize="11" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,6"/>
                                        
                                        <!-- Pill Button: TO START -->
                                        <Border Background="#073B28" CornerRadius="12" Padding="16,5" HorizontalAlignment="Center">
                                            <TextBlock Text="TO START" FontSize="11" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- RIGHT: HOW TO USE RVM (Dark Forest Green Panel Matching Mockup) -->
                        <Border Grid.Column="2" Background="#083E28" Width="260" CornerRadius="12" Padding="14,12" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="HOW TO USE RVM" FontSize="12" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                    <!-- Step 1 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#115338" BorderBrush="#1F7552" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🍾" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="1. INSERT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Insert your empty bottle / can" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step 2 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#115338" BorderBrush="#1F7552" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="2. DETECT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="We will scan and identify it" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step 3 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#115338" BorderBrush="#1F7552" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🎁" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="3. REWARD" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Earn points / cash reward" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step 4 -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#115338" BorderBrush="#1F7552" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🌱" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="4. SAVE ENVIRONMENT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="You make the planet cleaner" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 3: YOUR IMPACT & YOUR BALANCE (Exact Mockup Layout) -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT CARD: YOUR IMPACT 🍃 -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="12" Padding="14,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="YOUR IMPACT 🍃" FontSize="11" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,6"/>

                                <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                    <!-- Row 1: Bottles Recycled -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="🍾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Bottles Recycled" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="125" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 2: CO2 Saved -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#ECFDF5" BorderBrush="#99F6E4" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="☁️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="CO₂ Saved (kg)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="18.75" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Row 3: Water Saved -->
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Water Saved (L)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="93.40" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT CARD: YOUR BALANCE (Matching Mockup with Soft Leaf Watermark) -->
                        <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="12" Padding="14,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <!-- Leaf Watermark in Background -->
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="60" Height="60" IsHitTestVisible="False" Opacity="0.45">
                                    <Path Data="M 30 10 C 50 15 60 40 40 55 C 20 60 10 40 20 20 C 25 12 30 10 30 10 Z" Fill="#86EFAC"/>
                                    <Path Data="M 10 25 C 25 30 30 50 15 58 C 5 60 0 45 5 35 Z" Fill="#4ADE80"/>
                                </Canvas>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: YOUR BALANCE + Gift Icon -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="YOUR BALANCE" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text=" 🎁" FontSize="11" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <!-- Big Balance Number + POINTS -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,4">
                                        <TextBlock x:Name="TotalPointsText" Text="120" FontSize="36" FontWeight="Black" Foreground="#073B28" LineHeight="36"/>
                                        <TextBlock Text="POINTS" FontSize="10" FontWeight="Bold" Foreground="#15803D" Margin="2,-4,0,0"/>
                                    </StackPanel>

                                    <!-- Button: VIEW REWARDS -->
                                    <Button Grid.Row="2" Content="VIEW REWARDS" HorizontalAlignment="Left" Background="#073B28" Foreground="White" FontSize="11" FontWeight="Bold" Padding="14,6" Cursor="Hand" Click="ViewRewardsButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 4: BOTTOM 5 QUICK NAVIGATION CARDS (Exact Circular Icon Badges) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. SIGN IN / SIGN UP -->
                        <Button Grid.Column="0" Style="{StaticResource BottomNavCardButton}" Click="SignInNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="👤" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SIGN IN / SIGN UP" FontSize="9" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage your account" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text=">" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2. REWARDS -->
                        <Button Grid.Column="1" Style="{StaticResource BottomNavCardButton}" Click="RewardsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="🎁" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="REWARDS" FontSize="9" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="View &amp; Redeem" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text=">" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 3. TRANSACTION -->
                        <Button Grid.Column="2" Style="{StaticResource BottomNavCardButton}" Click="TransactionNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="🕒" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TRANSACTION" FontSize="9" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="View History" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text=">" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 4. INSTRUCTIONS -->
                        <Button Grid.Column="3" Style="{StaticResource BottomNavCardButton}" Click="InstructionsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#7C3AED" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="ℹ️" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="INSTRUCTIONS" FontSize="9" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Learn how to use" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text=">" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 5. ANNOUNCEMENTS -->
                        <Button Grid.Column="4" Style="{StaticResource BottomNavCardButton}" Click="AnnouncementsNav_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#0D9488" HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <TextBlock Text="📢" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ANNOUNCEMENTS" FontSize="9" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/>
                                <TextBlock Text="Latest updates &amp; news" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text=">" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Hidden Hardware & Session Material fields for background services -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="StatusText"/>
                        <TextBlock x:Name="BottleInfoText"/>
                        <TextBlock x:Name="PlasticSmallCountText"/>
                        <TextBlock x:Name="PlasticMediumCountText"/>
                        <TextBlock x:Name="PlasticLargeCountText"/>
                        <TextBlock x:Name="CanSmallCountText"/>
                        <TextBlock x:Name="CanMediumCountText"/>
                        <TextBlock x:Name="CanLargeCountText"/>
                        <TextBlock x:Name="TetraPakSmallCountText"/>
                        <TextBlock x:Name="TetraPakMediumCountText"/>
                        <TextBlock x:Name="TetraPakLargeCountText"/>
                        <TextBlock x:Name="RejectedCountText"/>
                        <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                        <Grid x:Name="InstructionPlaceholder"/>
                        <ItemsControl x:Name="LeaderboardList"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- BOTTOM SCREEN: DIGITAL SIGNAGE VIDEO PLAYER & ECO SUSTAINABILITY FOOTER   -->
        <!-- ========================================================================= -->
        <Grid x:Name="BottomGrid" Grid.Row="1" Background="#05120B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero text overlay -->
                        <RowDefinition Height="*"/>    <!-- Video canvas -->
                        <RowDefinition Height="Auto"/> <!-- Bottom eco footer -->
                    </Grid.RowDefinitions>

                    <!-- Full HD Media Element Player -->
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>

                    <!-- Top Signage Overlay Headline -->
                    <Border Grid.Row="0" Background="#CC073B28" Padding="20,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="19" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Video Progress Indicator Overlay (0:05 / 0:20) -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#90000000" Padding="14,6" Margin="14,0,14,6" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0:05 / 0:20" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ProgressBar Grid.Column="1" Value="25" Height="4" Foreground="#22C55E" Background="#475569" BorderThickness="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                <TextBlock Text="🔊  ⚙  ⛶" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom Dark Green Eco-Sustainability Footer Bar -->
                    <Border Grid.Row="2" Background="#073B28" Padding="14,10" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Waste" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Resources" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="20" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="12" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="For a Greener Future" FontSize="10" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Real-time Telemetry Terminal Overlay (Press 8 to Toggle) -->
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#0D1526" Padding="18,12">
                        <TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                    </Border>
                    <ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
                        <ItemsControl x:Name="TelemetryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
