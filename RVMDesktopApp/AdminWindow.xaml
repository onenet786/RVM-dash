<Window
    x:Class="RVMDesktopApp.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RVM Admin"
    Icon="Assets/RvmIcon.ico"
    Width="1000"
    Height="650"
    Background="{StaticResource BrushBgDark}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Background="#0D1526"
            BorderBrush="{StaticResource BrushBorderDim}"
            BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                    <Image
                        Source="Assets/RvmLogo.png"
                        Width="40"
                        Height="40"
                        Stretch="Uniform"
                        Margin="0,0,14,0" />
                    <TextBlock
                        Text="ADMIN PANEL"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource BaseText}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                    <Button
                        Content="Refresh"
                        Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="0,0,12,0" />
                    <Button
                        Content="Save Points"
                        Style="{StaticResource AccentButton}"
                        Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,24">
            <TabControl>
                <TabItem Header="Point Settings">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        Margin="0,8,0,0">
                        <DataGrid
                            x:Name="PointsGrid"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False" />
                    </Border>
                </TabItem>
                <TabItem Header="Transactions">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        Margin="0,8,0,0">
                        <DataGrid
                            x:Name="TransactionsGrid"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False"
                            IsReadOnly="True" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
