<Window
    x:Class="RVMDesktopApp.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RVM Master Admin &amp; Live Communication Suite"
    Icon="Assets/RvmIcon.ico"
    Width="1360"
    Height="860"
    MinWidth="1200"
    MinHeight="780"
    Background="{StaticResource BrushBgDark}"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Background="#0D1526"
            BorderBrush="{StaticResource BrushBorderDim}"
            BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
                    <Image
                        Source="Assets/RvmLogo.png"
                        Width="40"
                        Height="40"
                        Stretch="Uniform"
                        Margin="0,0,14,0" />
                    <TextBlock
                        Text="RVM MASTER ADMIN &amp; HARDWARE TEST SUITE"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Style="{StaticResource BaseText}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                    
                    <!-- Live Status Badges -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗄️ SQL Server: " Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtHeaderSqlStatus" Text="Connected 🟢" Foreground="#4ADE80" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,16,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 Dashboard API: " Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtHeaderApiStatus" Text="Not Tested ⚪" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button
                        Content="Refresh"
                        Style="{StaticResource ModernButton}"
                        Click="Refresh_Click"
                        Margin="0,0,10,0" />
                    <Button
                        Content="Save Points"
                        Style="{StaticResource AccentButton}"
                        Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,24">
            <TabControl x:Name="AdminTabs">
                <TabItem Header="Point Settings">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        Margin="0,8,0,0">
                        <DataGrid
                            x:Name="PointsGrid"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False" />
                    </Border>
                </TabItem>

                <TabItem Header="Transactions Log">
                    <Border
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        Margin="0,8,0,0">
                        <DataGrid
                            x:Name="TransactionsGrid"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False"
                            IsReadOnly="True" />
                    </Border>
                </TabItem>

                <!-- NEW TAB: Admin Security & Manual Central Sync -->
                <TabItem Header="🔐 Security &amp; Manual Data Sync">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,16,0">

                            <!-- Top Section: Detailed Bottle Variant Telemetry Comparison Card -->
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📊 RVM BOTTLE &amp; VARIANT TELEMETRY COMPARISON" FontWeight="Bold" FontSize="15" Foreground="#38BDF8"/>
                                            <TextBlock Text="Compare live accepted bottle counts by variant between Local SQL Database and Central Master Dashboard" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="ComparisonSyncBadgeBorder" Background="#065F46" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                <TextBlock x:Name="ComparisonSyncBadgeText" Text="IN SYNC 🟢" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <Button Content="🔄 Refresh &amp; Compare Live Data" Click="RefreshComparisonData_Click" Height="36" Padding="12,4" Style="{StaticResource ModernButton}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Comparison DataGrid -->
                                    <DataGrid x:Name="GridVariantComparison" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="#0F172A" Foreground="White" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" BorderBrush="#334155" Height="260" Margin="0,0,0,12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Material &amp; Variant" Binding="{Binding MaterialVariant}" Width="2*" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <DataGridTextColumn Header="Local SQL Count" Binding="{Binding LocalCount}" Width="*"/>
                                            <DataGridTextColumn Header="Dashboard Count" Binding="{Binding CentralCount}" Width="*"/>
                                            <DataGridTextColumn Header="Variance" Binding="{Binding Variance}" Width="*"/>
                                            <DataGridTextColumn Header="Sync Status" Binding="{Binding Status}" Width="1.4*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtComparisonSummary" Text="Click 'Refresh &amp; Compare Live Data' to load telemetry." Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                        <Button Grid.Column="1" Content="⚡ Sync Local Unsynced Data to Dashboard" Click="SyncLocalData_Click" Height="36" Padding="14,4" Style="{StaticResource AccentButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Manual Central Sync -->
                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="🔄 MANUAL LOCAL DATA CENTRAL SYNC" FontWeight="Bold" Foreground="#38BDF8" FontSize="14" Margin="0,0,0,8"/>
                                        <TextBlock Text="Manually upload unsynced local SQL Server transactions to the Central Master Dashboard." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                        <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Target Dashboard URL:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtSyncTargetUrl" Text="https://isprvm.binishaqsoft.com/api/machine/sync-session" Foreground="#4ADE80" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="🚀 Sync All Local SQL Data to Central Server" Click="SyncLocalData_Click" Height="44" Padding="16,4" Style="{StaticResource AccentButton}" Margin="0,0,0,12"/>

                                        <TextBlock x:Name="TxtSyncStatus" Text="Ready to sync local transactions." Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Column 2: Change Admin Password -->
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔐 CHANGE ADMIN PASSWORD" FontWeight="Bold" Foreground="#38BDF8" FontSize="14" Margin="0,0,0,8"/>
                                        <TextBlock Text="Update the RVM Admin Panel login password stored in your local SQL database." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                        <TextBlock Text="Username:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                        <TextBox Text="RVM" IsReadOnly="True" Height="32" Padding="8,4" Margin="0,0,0,10" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" VerticalContentAlignment="Center"/>

                                        <TextBlock Text="Current Password:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="PwdCurrentAdmin" Height="32" Padding="8,4" Margin="0,0,0,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>

                                        <TextBlock Text="New Password:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="PwdNewAdmin" Height="32" Padding="8,4" Margin="0,0,0,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>

                                        <TextBlock Text="Confirm New Password:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                        <PasswordBox x:Name="PwdConfirmAdmin" Height="32" Padding="8,4" Margin="0,0,0,16" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>

                                        <Button Content="💾 Update Admin Password" Click="ChangePassword_Click" Height="40" Padding="16,4" Style="{StaticResource ModernButton}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- NEW TAB: System & Hardware Config (config.txt) Editor -->
                <TabItem Header="⚙️ System &amp; Hardware Config (config.txt)">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <!-- Action Bar -->
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="RVM SYSTEM CONFIGURATION EDITOR (config.txt)" FontWeight="Bold" Foreground="#38BDF8" FontSize="14"/>
                                        <TextBlock Text="Edit, save, and reload all local hardware, COM ports, database, and machine settings." Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🔄 Reload from File" Click="ReloadConfig_Click" Height="38" Padding="12,4" Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                        <Button Content="💾 Save Configuration" Click="SaveConfig_Click" Height="38" Padding="16,4" Style="{StaticResource AccentButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Machine Identity & Database -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="1. MACHINE IDENTITY &amp; DASHBOARD API" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Machine ID (e.g. RVM-RWP):" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="CfgMachineId" Height="32" Padding="8,4" Margin="0,0,0,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>

                                            <TextBlock Text="Central Dashboard Base URL:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="CfgCentralApiUrl" Height="32" Padding="8,4" Margin="0,0,0,6" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="2. LOCAL SQL SERVER CONNECTION" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Connection String:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="CfgConnectionString" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" Margin="0,0,0,6" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2: Hardware COM Ports & Classifier Directories -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="3. HARDWARE &amp; SENSORS (COM PORTS)" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Arduino Port:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgArduinoPort" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Arduino Baud:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgArduinoBaud" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Camera Port:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgCameraPort" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Camera Baud:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgCameraBaud" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="⚡ Re-initialize Arduino Board" Click="ReinitializeArduino_Click" Height="34" Margin="0,8,0,0" Style="{StaticResource ModernButton}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="4. FOLDERS &amp; CLASSIFIER MODEL" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Advertisement Video Folder:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgAdsFolder" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Instruction Video Folder:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgInstructionsFolder" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Model Path:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgModelPath" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Capture Directory:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="CfgCaptureDir" Height="32" Padding="8,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- NEW TAB: Live Dashboard Sync & Manual Entry Simulator -->
                <TabItem Header="⚡ Central Dashboard Simulator &amp; Test Suite">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Manual Entry Controls -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                            <StackPanel>

                                <!-- Server Connection Card -->
                                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="1. CENTRAL DASHBOARD ENDPOINT" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                        <TextBlock Text="Central Server Base URL:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtServerUrl" Text="https://isprvm.binishaqsoft.com" Height="36" Padding="8,6" Margin="0,0,0,10" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔌 Ping Connection &amp; Rules" Click="TestConnection_Click" Height="40" Padding="8,4" Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtConnStatus" Text="Not Tested" Foreground="#94A3B8" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Manual Session Simulator Card -->
                                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="2. MANUAL BOTTLE &amp; RECYCLING ENTRY" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12" />
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Machine ID:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtMachineId" Text="RVM-RWP" Height="32" Padding="6,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Mobile / QR Token:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtUserId" Text="onenet" Height="32" Padding="6,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Material Type:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="CmbMaterial" Height="32" SelectedIndex="0" Background="#F1F5F9" Foreground="#0F172A" FontWeight="Bold" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="PLASTIC" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                    <ComboBoxItem Content="CAN (Metal)" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                    <ComboBoxItem Content="GLASS" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                    <ComboBoxItem Content="PAPER" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Bottle Size:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="CmbSize" Height="32" SelectedIndex="1" Background="#F1F5F9" Foreground="#0F172A" FontWeight="Bold" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="SMALL" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                    <ComboBoxItem Content="MEDIUM" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                    <ComboBoxItem Content="LARGE" Foreground="#0F172A" Background="#F8FAFC" FontWeight="Bold" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Item Count:" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtItemCount" Text="3" Height="32" Padding="6,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Weight (Kg):" Style="{StaticResource SecondaryText}" Margin="0,0,0,4" />
                                                <TextBox x:Name="TxtWeightKg" Text="0.150" Height="32" Padding="6,4" Background="#0F172A" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="🚀 Simulate Bottle Insert &amp; Sync to Dashboard" Click="SimulateInsert_Click" Height="42" Padding="8,4" Style="{StaticResource AccentButton}" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hardware Telemetry Simulator Card -->
                                <Border Style="{StaticResource CardBorder}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="3. TELEMETRY &amp; QR HARDWARE SIMULATORS" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📡 Send Heartbeat (85% Fill)" Click="SendHeartbeat_Click" Height="40" Padding="6,4" Style="{StaticResource ModernButton}" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="🔍 Verify QR Code Scanner" Click="VerifyQr_Click" Height="40" Padding="6,4" Style="{StaticResource ModernButton}" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>


                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Column: Live Output & Communication Console -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🖥️ LIVE COMMUNICATION CONSOLE LOG" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBox
                                    Grid.Row="1"
                                    x:Name="TxtConsoleLog"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
