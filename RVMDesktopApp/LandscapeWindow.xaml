<Window x:Class="RVMDesktopApp.LandscapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.20" Color="#0D9488"/>

        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="80" CenterY="80"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="3,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56*"/>
            <ColumnDefinition Width="44*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HALF: KIOSK DASHBOARD -->
        <Border Grid.Column="0" Background="#F7F9F5" Padding="14,8" BorderBrush="#E2E8F0" BorderThickness="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Separate Hardware & Session Tiles -->
                    <RowDefinition Height="*"/>    <!-- 2: Insert Circle / Instruction Video on Left + Teal Glass How-To & Leaderboard on Right -->
                    <RowDefinition Height="Auto"/> <!-- 3: Double Height Impact & Balance Cards -->
                    <RowDefinition Height="Auto"/> <!-- 4: 5 Nav Actions -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="38" Margin="0,0,8,0">
                            <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                            <Path Data="M 17 11 L 17 7 L 23 7 L 23 11 L 27 15 L 27 32 L 13 32 L 13 15 Z" Fill="#073B28"/>
                            <Path Data="M 26 20 C 36 21 36 34 24 34 C 28 28 28 22 26 20 Z" Fill="#22C55E"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RVM" FontSize="20" FontWeight="Black" Foreground="#073B28"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8" FontWeight="Bold" Foreground="#073B28"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="WELCOME • خوش آمدید" FontSize="14" FontWeight="Black" Foreground="#073B28"/>
                        <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="8.5" Foreground="#64748B"/>
                    </StackPanel>

                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" Effect="{StaticResource CardShadow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="10.5" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: SEPARATE HARDWARE STATUS & SESSION DETAILS TILES -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="6" Padding="8,3" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="HARDWARE DIAGNOSTICS 🔌" FontSize="8.5" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="SERIAL: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DbDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/><TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                                <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ApiDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="ApiStatusText" Text="API: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                                <TextBlock x:Name="MachineStateText" Text="IDLE" FontSize="8" FontWeight="Bold" Foreground="#0369A1" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="6" Padding="8,3" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Text="SESSION DETAILS 📊" FontSize="8.5" FontWeight="Black" Foreground="#073B28"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" Text="Ready" FontSize="8" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,3,0"/><TextBlock x:Name="BottleInfoText" Text="• Insert item" FontSize="7.5" Foreground="#64748B"/></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Border Style="{StaticResource MaterialChip}" Background="#F0FDFA" BorderBrush="#99F6E4"><StackPanel Orientation="Horizontal"><TextBlock Text="🧴 " FontSize="7.5"/><TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="8" FontWeight="Black" Foreground="#047857"/><TextBlock Text="s " FontSize="6.5" Foreground="#047857"/><TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#047857"/><TextBlock Text="m " FontSize="6.5" Foreground="#047857"/><TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#047857"/><TextBlock Text="l" FontSize="6.5" Foreground="#047857"/></StackPanel></Border>
                                <Border Style="{StaticResource MaterialChip}" Background="#F0F9FF" BorderBrush="#BAE6FD"><StackPanel Orientation="Horizontal"><TextBlock Text="🥫 " FontSize="7.5"/><TextBlock x:Name="CanSmallCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#0369A1"/><TextBlock Text="s " FontSize="6.5" Foreground="#0369A1"/><TextBlock x:Name="CanMediumCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#0369A1"/><TextBlock Text="m " FontSize="6.5" Foreground="#0369A1"/><TextBlock x:Name="CanLargeCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#0369A1"/><TextBlock Text="l" FontSize="6.5" Foreground="#0369A1"/></StackPanel></Border>
                                <Border Style="{StaticResource MaterialChip}" Background="#FFFBEB" BorderBrush="#FDE68A"><StackPanel Orientation="Horizontal"><TextBlock Text="🧃 " FontSize="7.5"/><TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#B45309"/><TextBlock Text="s " FontSize="6.5" Foreground="#B45309"/><TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#B45309"/><TextBlock Text="m " FontSize="6.5" Foreground="#B45309"/><TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="8.5" FontWeight="Black" Foreground="#B45309"/><TextBlock Text="l" FontSize="6.5" Foreground="#B45309"/></StackPanel></Border>
                                <Border Style="{StaticResource MaterialChip}" Background="#FEF2F2" BorderBrush="#FECACA" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="🚫 " FontSize="7.5"/><TextBlock x:Name="RejectedCountText" Text="0" FontSize="8" FontWeight="Black" Foreground="#DC2626"/></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 2: CENTER SECTION -->
                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: INSERT BOTTLE / LIVE INSTRUCTION VIDEO -->
                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="170" Height="170" CornerRadius="85" ClipToBounds="True" Background="#073B28" Effect="{StaticResource CircleShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                            <Grid>
                                <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded"/>
                                <Grid x:Name="InstructionPlaceholder">
                                    <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click">
                                        <Grid Width="170" Height="170">
                                            <Ellipse Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="3 3"/>
                                            <Ellipse Width="156" Height="156" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.2"/>
                                            <Ellipse Width="140" Height="140" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="INSERT • داخل کریں" FontSize="14" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="BOTTLE / CAN / CUP" FontSize="8" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,3"/>
                                                <Border Background="#073B28" CornerRadius="8" Padding="10,2.5" HorizontalAlignment="Center">
                                                    <TextBlock Text="START • شروع کریں" FontSize="8.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.15*"/> <!-- Reduced height (-25%) for How To Use -->
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Bilingual How To Use RVM with Teal Glassmorphism -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="10,5" BorderThickness="1.2" Effect="{StaticResource TealGlassShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EB0F766E" Offset="0.0"/>
                                    <GradientStop Color="#E0115E59" Offset="0.5"/>
                                    <GradientStop Color="#F0042E2B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#995EEAD4" Offset="0.0"/>
                                    <GradientStop Color="#4D2DD4BF" Offset="0.5"/>
                                    <GradientStop Color="#8014B8A6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="✦ " FontSize="10" Foreground="#5EEAD4"/>
                                    <TextBlock Text="HOW TO USE RVM • طریقہ کار" FontSize="11" FontWeight="Black" Foreground="#99F6E4"/>
                                    <TextBlock Text=" ✦" FontSize="10" Foreground="#5EEAD4"/>
                                </StackPanel>
                                <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#3314B8A6" BorderBrush="#805EEAD4" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="1" FontSize="9.5" FontWeight="Bold" Foreground="#99F6E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="1. INSERT • خالی بوتل یا کین ڈالیں" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#3314B8A6" BorderBrush="#805EEAD4" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="2" FontSize="9.5" FontWeight="Bold" Foreground="#99F6E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="2. DETECT • شناخت اور خودکار اسکین" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#3314B8A6" BorderBrush="#805EEAD4" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="3" FontSize="9.5" FontWeight="Bold" Foreground="#99F6E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="3. REWARD • پوائنٹس حاصل کریں" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#3314B8A6" BorderBrush="#805EEAD4" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="4" FontSize="9.5" FontWeight="Bold" Foreground="#99F6E4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="4. SAVE • ماحول کو صاف اور سرسبز بنائیں" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/></StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Top 5 Leaderboard -->
                        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="8,4" BorderBrush="#E5EAE1" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="TOP 5 RECYCLERS 🏆 بہترین ری سائیکلرز" FontSize="9" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                                <Border Grid.Row="1" Background="#F1F5F9" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="#" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="Name" FontSize="7.5" FontWeight="Bold" Foreground="#64748B"/><TextBlock Grid.Column="2" Text="Pts" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/></Grid></Border>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="LeaderboardList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="1,1.5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontSize="8.5" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="8.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding PointsBalance, StringFormat={}{0} pts}" FontSize="8.5" FontWeight="Black" Foreground="#D97706" TextAlignment="Right"/></Grid></Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ROW 3: DOUBLE HEIGHT "YOUR IMPACT" AND "YOUR BALANCE" CARDS -->
                <Grid Grid.Row="3" Margin="0,0,0,5" MinHeight="96">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="8" Padding="10,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="YOUR IMPACT 🍃 ماحولیاتی فوائد" FontSize="10" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                            <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="🌱 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Bottles Recycled (بوتلیں)" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="0" FontSize="16" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="🌳 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CO₂ Saved kg (کاربن بچت)" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="0.00" FontSize="16" FontWeight="Black" Foreground="#0F766E" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="💧 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Water Saved L (پانی کی بچت)" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="0.00" FontSize="16" FontWeight="Black" Foreground="#1D4ED8" VerticalAlignment="Center"/></Grid>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="8" Padding="10,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="REWARD BALANCE 🎁 پوائنٹس بیلنس" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,2"><TextBlock x:Name="TotalPointsText" Text="0" FontSize="32" FontWeight="Black" Foreground="#073B28"/><TextBlock Text="POINTS • پوائنٹس" FontSize="8.5" FontWeight="Bold" Foreground="#15803D" Margin="2,-2,0,0"/></StackPanel>
                            <Button Grid.Row="2" Content="REDEEM • انعام پائیں" HorizontalAlignment="Left" Background="#073B28" Foreground="White" FontSize="9.5" FontWeight="Bold" Padding="10,4" Cursor="Hand" Click="ViewRewardsButton_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 4: 5 QUICK ACTION CARDS -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BottomNavCardButton}" Click="SignInNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#16A34A" Margin="0,0,0,1"><TextBlock Text="👤" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SIGN IN" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="1" Style="{StaticResource BottomNavCardButton}" Click="RewardsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#F59E0B" Margin="0,0,0,1"><TextBlock Text="🎁" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="REWARDS" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="2" Style="{StaticResource BottomNavCardButton}" Click="TransactionNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#0284C7" Margin="0,0,0,1"><TextBlock Text="🕒" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="HISTORY" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="3" Style="{StaticResource BottomNavCardButton}" Click="InstructionsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#7C3AED" Margin="0,0,0,1"><TextBlock Text="ℹ️" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="GUIDE" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="4" Style="{StaticResource BottomNavCardButton}" Click="AnnouncementsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#0D9488" Margin="0,0,0,1"><TextBlock Text="📢" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="NEWS" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT HALF: DIGITAL SIGNAGE VIDEO SCREEN -->
        <Grid x:Name="BottomGrid" Grid.Column="1" Background="#05120B">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>
                    <Border Grid.Row="0" Background="#CC073B28" Padding="14,6"><StackPanel HorizontalAlignment="Center"><TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Grid.Row="2" Background="#073B28" Padding="8,5" BorderBrush="#15803D" BorderThickness="0,2,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="♻" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="REDUCE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="Waste" FontSize="7.5" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="🍃" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="REUSE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="Resources" FontSize="7.5" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="♻" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="RECYCLE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="Greener Future" FontSize="7.5" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
                </Grid>
            </Border>
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0D1526" Padding="18,12"><TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/></Border><ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12"><ItemsControl x:Name="TelemetryList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
        </Grid>
    </Grid>
</Window>
