<Window x:Class="RVMDesktopApp.LandscapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>

        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="100" CenterY="100"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="3,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- LEFT 52%: Interactive Kiosk Dashboard Matching Mockup -->
            <ColumnDefinition Width="52*"/>
            <!-- RIGHT 48%: Digital Signage Video Screen -->
            <ColumnDefinition Width="48*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HALF: KIOSK DASHBOARD -->
        <Border Grid.Column="0" Background="#F7F9F5" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,0,2,0">
            <Grid>
                <!-- Decorative Leaf Foliage -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="90" Height="70" IsHitTestVisible="False" Opacity="0.30">
                    <Path Data="M 60 0 C 80 15 90 40 70 55 C 50 70 25 50 35 30 C 40 10 60 0 60 0 Z" Fill="#86EFAC"/>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="Auto"/> <!-- 1: Welcome -->
                        <RowDefinition Height="*"/>    <!-- 2: Insert Circle + How to Use -->
                        <RowDefinition Height="Auto"/> <!-- 3: Impact & Balance -->
                        <RowDefinition Height="Auto"/> <!-- 4: 5 Nav Actions -->
                    </Grid.RowDefinitions>

                    <!-- ROW 0: TOP HEADER BAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="44" Height="44" Margin="0,0,10,0">
                                <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                                <Path Data="M 19 12 L 19 8 L 25 8 L 25 12 L 29 16 L 29 35 L 15 35 L 15 16 Z" Fill="#073B28"/>
                                <Path Data="M 28 22 C 38 23 38 37 26 37 C 30 31 30 25 28 22 Z" Fill="#22C55E"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RVM" FontSize="22" FontWeight="Black" Foreground="#073B28"/>
                                    <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                    <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="5" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8" FontWeight="Bold" Foreground="#073B28"/>
                                <TextBlock Text="Reduce • Reuse • Recycle" FontSize="8" FontWeight="SemiBold" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" Margin="0,0,0,2" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="11.5" FontWeight="Bold" Foreground="#073B28"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Width="14" Height="14" CornerRadius="2" BorderBrush="#F59E0B" BorderThickness="1.2" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontSize="8" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Environmental Solutions Pvt. Ltd." FontSize="9" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: WELCOME HEADLINE -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🍃 " FontSize="15" Foreground="#15803D"/>
                            <TextBlock Text="WELCOME" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                            <TextBlock Text=" 🍃" FontSize="15" Foreground="#15803D"/>
                        </StackPanel>
                        <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="11" FontWeight="Medium" Foreground="#475569" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ROW 2: CENTER SECTION -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: INSERT CIRCLE -->
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click">
                                <Grid Width="200" Height="200">
                                    <Ellipse Stroke="#CBD5E1" StrokeThickness="1.2" StrokeDashArray="3 3"/>
                                    <Ellipse Width="186" Height="186" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.5"/>
                                    <Ellipse Width="166" Height="166" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1.2" Effect="{StaticResource CircleShadow}"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="64" Height="40" Margin="0,0,0,4">
                                            <Path Data="M 11 11 L 11 5 L 17 5 L 17 11 L 22 16 L 22 38 L 6 38 L 6 16 Z" Stroke="#073B28" StrokeThickness="1.8" Fill="Transparent"/>
                                            <Rectangle Canvas.Left="9" Canvas.Top="3" Width="10" Height="3" Stroke="#073B28" StrokeThickness="1.2" Fill="#073B28"/>
                                            <Path Data="M 26 19 L 40 19 L 40 38 L 26 38 Z" Stroke="#073B28" StrokeThickness="1.8" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="26" Canvas.Top="17" Width="14" Height="4" Stroke="#073B28" StrokeThickness="1.2" Fill="Transparent"/>
                                            <Path Data="M 46 14 L 60 14 L 57 38 L 48 38 Z" Stroke="#073B28" StrokeThickness="1.8" Fill="Transparent"/>
                                        </Canvas>
                                        <TextBlock Text="INSERT" FontSize="18" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BOTTLE / CAN" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,5"/>
                                        <Border Background="#073B28" CornerRadius="11" Padding="14,4" HorizontalAlignment="Center">
                                            <TextBlock Text="TO START" FontSize="10" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- RIGHT: HOW TO USE RVM -->
                        <Border Grid.Column="2" Background="#073F26" CornerRadius="12" Padding="14,12" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="HOW TO USE RVM" FontSize="11.5" FontWeight="Black" Foreground="#86EFAC" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#115338" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="🍾" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="1. INSERT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Insert your empty bottle / can" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#115338" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="2. DETECT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="We will scan and identify it" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#115338" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="🎁" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="3. REWARD" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Earn points / cash reward" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#115338" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="🌱" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="4. SAVE ENVIRONMENT" FontSize="10.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                            <TextBlock Text="You make the planet cleaner" FontSize="8.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 3: YOUR IMPACT & YOUR BALANCE -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: YOUR IMPACT -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="12" Padding="14,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="YOUR IMPACT 🍃" FontSize="11" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,6"/>
                                <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#F0FDF4" Margin="0,0,8,0"><TextBlock Text="🍾" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="Bottles Recycled" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="125" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#ECFDF5" Margin="0,0,8,0"><TextBlock Text="☁️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="CO₂ Saved (kg)" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="18.75" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="#EFF6FF" Margin="0,0,8,0"><TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="Water Saved (L)" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="93.40" FontSize="15" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </Grid>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: YOUR BALANCE -->
                        <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="12" Padding="14,10" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="60" Height="60" IsHitTestVisible="False" Opacity="0.40">
                                    <Path Data="M 30 10 C 50 15 60 40 40 55 C 20 60 10 40 20 20 Z" Fill="#86EFAC"/>
                                </Canvas>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"><TextBlock Text="YOUR BALANCE" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/><TextBlock Text=" 🎁" FontSize="11" Margin="4,0,0,0"/></StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,4"><TextBlock x:Name="TotalPointsText" Text="120" FontSize="36" FontWeight="Black" Foreground="#073B28"/><TextBlock Text="POINTS" FontSize="10" FontWeight="Bold" Foreground="#15803D" Margin="2,-4,0,0"/></StackPanel>
                                    <Button Grid.Row="2" Content="VIEW REWARDS" HorizontalAlignment="Left" Background="#073B28" Foreground="White" FontSize="11" FontWeight="Bold" Padding="14,5" Cursor="Hand" Click="ViewRewardsButton_Click">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROW 4: 5 QUICK ACTION CARDS -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BottomNavCardButton}" Click="SignInNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" Background="#16A34A" Margin="0,0,0,2"><TextBlock Text="👤" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SIGN IN / UP" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/><TextBlock Text="Manage account" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text=">" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="1" Style="{StaticResource BottomNavCardButton}" Click="RewardsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" Background="#F59E0B" Margin="0,0,0,2"><TextBlock Text="🎁" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="REWARDS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/><TextBlock Text="View &amp; Redeem" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text=">" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="2" Style="{StaticResource BottomNavCardButton}" Click="TransactionNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" Background="#0284C7" Margin="0,0,0,2"><TextBlock Text="🕒" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="TRANSACTION" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/><TextBlock Text="View History" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text=">" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="3" Style="{StaticResource BottomNavCardButton}" Click="InstructionsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" Background="#7C3AED" Margin="0,0,0,2"><TextBlock Text="ℹ️" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="INSTRUCTIONS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/><TextBlock Text="Learn how to use" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text=">" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="4" Style="{StaticResource BottomNavCardButton}" Click="AnnouncementsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="30" Height="30" CornerRadius="15" Background="#0D9488" Margin="0,0,0,2"><TextBlock Text="📢" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ANNOUNCEMENTS" FontSize="8.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/><TextBlock Text="Latest news" FontSize="7.5" Foreground="#64748B" HorizontalAlignment="Center"/><TextBlock Text=">" FontSize="8.5" Foreground="#94A3B8" HorizontalAlignment="Center"/></StackPanel></Button>
                    </Grid>

                    <!-- Hidden Hardware & Session Material fields to keep C# background services and data model fully intact -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="StatusText"/>
                        <TextBlock x:Name="BottleInfoText"/>
                        <TextBlock x:Name="HeaderDotText"/>
                        <TextBlock x:Name="CommandCenterRvmNameText"/>
                        <TextBlock x:Name="AdHeaderRvmNameText"/>
                        <TextBlock x:Name="MachineStateText"/>
                        <TextBlock x:Name="ConnectionText"/>
                        <TextBlock x:Name="DbStatusText"/>
                        <TextBlock x:Name="ApiStatusText"/>
                        <Ellipse x:Name="StatusDot"/>
                        <Ellipse x:Name="DbDot"/>
                        <Ellipse x:Name="ApiDot"/>
                        <TextBlock x:Name="PlasticSmallCountText"/>
                        <TextBlock x:Name="PlasticMediumCountText"/>
                        <TextBlock x:Name="PlasticLargeCountText"/>
                        <TextBlock x:Name="CanSmallCountText"/>
                        <TextBlock x:Name="CanMediumCountText"/>
                        <TextBlock x:Name="CanLargeCountText"/>
                        <TextBlock x:Name="TetraPakSmallCountText"/>
                        <TextBlock x:Name="TetraPakMediumCountText"/>
                        <TextBlock x:Name="TetraPakLargeCountText"/>
                        <TextBlock x:Name="RejectedCountText"/>
                        <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                        <Grid x:Name="InstructionPlaceholder"/>
                        <ItemsControl x:Name="LeaderboardList"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT HALF: DIGITAL SIGNAGE VIDEO SCREEN -->
        <Grid x:Name="BottomGrid" Grid.Column="1" Background="#05120B">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>
                    <Border Grid.Row="0" Background="#CC073B28" Padding="16,8"><StackPanel HorizontalAlignment="Center"><TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="17" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="11" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Grid.Row="2" Background="#073B28" Padding="10,6" BorderBrush="#15803D" BorderThickness="0,2,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="♻" FontSize="16" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="REDUCE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="Waste" FontSize="8" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="🍃" FontSize="16" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="REUSE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="Resources" FontSize="8" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="♻" FontSize="16" Foreground="#86EFAC" HorizontalAlignment="Center"/><TextBlock Text="RECYCLE" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="For a Greener Future" FontSize="8" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
                </Grid>
            </Border>
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0D1526" Padding="18,12"><TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/></Border><ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12"><ItemsControl x:Name="TelemetryList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
        </Grid>
    </Grid>
</Window>
