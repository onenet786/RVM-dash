<Window x:Class="RVMDesktopApp.LandscapeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowState="Maximized" WindowStyle="None" Icon="Assets/RvmIcon.ico"
 Background="#EEF2F7" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="InkText" Color="#0F172A"/><SolidColorBrush x:Key="InkMuted" Color="#64748B"/>
  <SolidColorBrush x:Key="LightBorder" Color="#E2E8F0"/><SolidColorBrush x:Key="KioskBg" Color="#0B1120"/>
  <SolidColorBrush x:Key="KioskCard" Color="#111A2E"/><SolidColorBrush x:Key="KioskBorder" Color="#1E293B"/>
  <SolidColorBrush x:Key="NeonGreen" Color="#22C55E"/>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
  <Style x:Key="LightCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LightBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14,10"/><Setter Property="Effect" Value="{StaticResource SoftShadow}"/></Style>
  <Style x:Key="StatLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource InkMuted}"/></Style>
  <Style x:Key="KioskChip" TargetType="Border"><Setter Property="Background" Value="#0F172A"/><Setter Property="BorderBrush" Value="{StaticResource KioskBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="9,5"/></Style>
  <Style x:Key="ChipText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#CBD5E1"/></Style>
  <Style x:Key="PrimaryGreenButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource NeonGreen}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="GhostLightButton" TargetType="Button"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="{StaticResource InkText}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0B1120" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Padding="18,7">
   <Grid><Image Source="Assets/RvmLogo.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="ONS-RVM-1000" FontFamily="Consolas" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Border>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="38*"/><ColumnDefinition Width="62*"/></Grid.ColumnDefinitions>

  <!-- Same customer utility components as portrait, reflowed into a landscape column. -->
  <Border Grid.Column="0" Background="{StaticResource KioskBg}" Padding="18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44*"/><RowDefinition Height="24*"/><RowDefinition Height="32*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource KioskCard}" BorderBrush="{StaticResource KioskBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="INSTRUCTION VIDEO" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8"/><MediaElement x:Name="InstructionPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded"/><Grid x:Name="InstructionPlaceholder" Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="♻" FontSize="42" Foreground="{StaticResource NeonGreen}" HorizontalAlignment="Center"/><TextBlock Text="INSERT ONE ITEM AT A TIME" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1"/></StackPanel></Grid><WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0"><Border Style="{StaticResource KioskChip}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0"/><TextBlock x:Name="ConnectionText" Text="HARDWARE: ..." Style="{StaticResource ChipText}"/></StackPanel></Border><Border Style="{StaticResource KioskChip}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DbDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0"/><TextBlock x:Name="DbStatusText" Text="DB: ..." Style="{StaticResource ChipText}"/></StackPanel></Border><Border Style="{StaticResource KioskChip}"><TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" Style="{StaticResource ChipText}"/></Border></WrapPanel></Grid>
    </Border>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="16" Effect="{StaticResource SoftShadow}" Margin="0,0,0,12"><StackPanel VerticalAlignment="Center"><TextBlock Text="READY TO RECYCLE?" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkText}" TextAlignment="Center" Margin="0,0,0,5"/><TextBlock Text="Deposit bottles or cans and earn points." FontSize="12" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/><Button Content="START RECYCLING  →" Style="{StaticResource PrimaryGreenButton}" Click="StartButton_Click" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="STOP" Style="{StaticResource GhostLightButton}" Click="StopButton_Click"/><Button Grid.Column="2" Content="ADMIN" Style="{StaticResource GhostLightButton}" Click="AdminButton_Click"/></Grid><TextBlock Text="0 START  ·  8 TELEMETRY  ·  9 VIDEO  ·  ESC EXIT" FontFamily="Consolas" FontSize="9" Foreground="#64748B" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LEADERBOARD" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkText}" Margin="0,0,0,8"/><Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBlock Text="S No." FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkMuted}" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="Name" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkMuted}"/><TextBlock Grid.Column="2" Text="Total" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkMuted}" TextAlignment="Right"/></Grid></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="LeaderboardList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding PhoneNumber}" FontSize="11" Foreground="{StaticResource InkText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding PointsBalance, StringFormat={}{0} pts}" FontSize="11" FontWeight="Bold" Foreground="#D97706" TextAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border><Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="14,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="YOUR POINTS" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Text, ElementName=TotalPointsText, StringFormat={}{0} points}" FontSize="19" FontWeight="Bold" Foreground="#D97706"/></StackPanel></Border></Grid>
   </Grid>
  </Border>

  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="55*"/><RowDefinition Height="45*"/></Grid.RowDefinitions>
   <!-- Same command-center cards as portrait. -->
   <Border Grid.Row="0" Background="#F1F5F9" Padding="22,16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="RVM Command Center" FontSize="23" FontWeight="Bold" Foreground="{StaticResource InkText}"/><Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="5" Padding="8,3" Margin="12,0,0,0"><TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#15803D"/></Border></StackPanel><TextBlock Text="SESSION TELEMETRY" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource InkMuted}"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource LightCard}"><StackPanel><TextBlock Text="MACHINE STATUS" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatusText" Text="Press 0 to Start" FontSize="18" FontWeight="Bold" Foreground="#16A34A" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource LightCard}"><StackPanel><TextBlock Text="LAST SCAN" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BottleInfoText" Text="Insert a plastic bottle or metal can" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkText}" TextTrimming="CharacterEllipsis"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource LightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="TOTAL ITEMS" Style="{StaticResource StatLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="TotalItemsText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#0891B2" TextAlignment="Center"/></Viewbox></Grid></Border><Border Grid.Column="6" Style="{StaticResource LightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="TOTAL POINTS" Style="{StaticResource StatLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="TotalPointsText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#D97706" TextAlignment="Center"/></Viewbox></Grid></Border></Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Grid.Column="7" Style="{StaticResource LightCard}" Padding="8,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="REJECTED" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="RejectedCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#DC2626" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="0" Grid.Column="0" Background="#D1FAE5" CornerRadius="9,0,0,9" BorderBrush="#10B981" BorderThickness="1,1,0,1" Padding="5"><Viewbox Stretch="Uniform"><TextBlock Text="PLASTIC" FontSize="30" FontWeight="ExtraBold" Foreground="#047857" TextAlignment="Center"/></Viewbox></Border>
      <Border Grid.Row="0" Grid.Column="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SMALL" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="0" Grid.Column="3" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MEDIUM" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="0" Grid.Column="5" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LARGE" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="2" Grid.Column="0" Background="#DBEAFE" CornerRadius="9,0,0,9" BorderBrush="#0EA5E9" BorderThickness="1,1,0,1" Padding="5"><Viewbox Stretch="Uniform"><TextBlock Text="CAN" FontSize="30" FontWeight="ExtraBold" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Border>
      <Border Grid.Row="2" Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SMALL" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="CanSmallCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="2" Grid.Column="3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="MEDIUM" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="CanMediumCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>
      <Border Grid.Row="2" Grid.Column="5" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="6,3"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LARGE" Style="{StaticResource StatLabel}" TextAlignment="Center"/><Viewbox Grid.Row="1" Stretch="Uniform" Margin="2,0"><TextBlock x:Name="CanLargeCountText" Text="0" FontSize="38" FontWeight="ExtraBold" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>
     </Grid>
    </Grid>
   </Border>
   <!-- Same cinematic advertisement and telemetry treatment as portrait. -->
   <Grid x:Name="BottomGrid" Grid.Row="1" Background="#050A13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions><Border x:Name="AdPanel" Grid.Column="0" Background="#050A13" ClipToBounds="True"><Grid><MediaElement x:Name="AdvertisementPlayer" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/><Border VerticalAlignment="Top" Background="#A60B1120" Padding="22,16"><Grid><StackPanel Orientation="Horizontal"><Image Source="Assets/RvmLogo.png" Width="42" Height="42" Stretch="Uniform" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ONS-RVM-1000" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="SMART RECYCLING SYSTEM" FontFamily="Consolas" FontSize="10" Foreground="#86EFAC"/></StackPanel></StackPanel><Border HorizontalAlignment="Right" Style="{StaticResource KioskChip}"><TextBlock Text="ADVERTISEMENT" Style="{StaticResource ChipText}"/></Border></Grid></Border><Border VerticalAlignment="Bottom" Height="5" Background="{StaticResource NeonGreen}"/></Grid></Border><Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0D1526" Padding="18,12"><TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/></Border><ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12"><ItemsControl x:Name="TelemetryList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border></Grid>
  </Grid>
  </Grid>
 </Grid>
</Window>
