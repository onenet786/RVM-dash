<Window x:Class="RVMDesktopApp.LandscapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#083E28"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>

        <Style x:Key="StatSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HardwareChip" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="HardwareChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CircularStartButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="65" CenterY="65"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="2,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenActionButton" TargetType="Button">
            <Setter Property="Background" Value="#073B28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- LEFT 60%: Interactive Kiosk Dashboard & Session Breakdown Matrix -->
            <ColumnDefinition Width="60*"/>
            <!-- RIGHT 40%: Digital Signage Video Screen -->
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HALF: KIOSK DASHBOARD -->
        <Border Grid.Column="0" Background="#F7F9F5" Padding="14,8" BorderBrush="#E2E8F0" BorderThickness="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- 3-Column Core Area -->
                    <RowDefinition Height="Auto"/> <!-- 5 Nav Actions -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="36" Height="36" Margin="0,0,8,0">
                            <Ellipse Stroke="#073B28" StrokeThickness="2" Fill="Transparent"/>
                            <Path Data="M 16 10 L 16 6 L 22 6 L 22 10 L 26 14 L 26 30 L 12 30 L 12 14 Z" Fill="#073B28"/>
                            <Path Data="M 25 18 C 34 19 34 32 23 32 C 26 27 26 21 25 18 Z" Fill="#22C55E"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RVM" FontSize="18" FontWeight="Black" Foreground="#073B28"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="8" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="8" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="7" FontWeight="Bold" Foreground="#073B28"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource HardwareChip}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="HARDWARE: CONNECTED" Style="{StaticResource HardwareChipText}"/></StackPanel></Border>
                        <Border Style="{StaticResource HardwareChip}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DbDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="DbStatusText" Text="DB: OK" Style="{StaticResource HardwareChipText}"/></StackPanel></Border>
                        <Border Style="{StaticResource HardwareChip}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ApiDot" Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="ApiStatusText" Text="API: ONLINE" Style="{StaticResource HardwareChipText}"/></StackPanel></Border>
                        <Border Style="{StaticResource HardwareChip}"><TextBlock x:Name="MachineStateText" Text="MACHINE: IDLE" Style="{StaticResource HardwareChipText}" Foreground="#0369A1"/></Border>
                    </StackPanel>

                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" Effect="{StaticResource CardShadow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="8.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="9.5" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Core 3-Column Area -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="28*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Insert Button + How To Use -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="10" Padding="8,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🍃 WELCOME 🍃" FontSize="11" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                            <Button Grid.Row="1" Style="{StaticResource CircularStartButton}" Click="StartButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="110" Height="110">
                                    <Ellipse Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="3 3"/>
                                    <Ellipse Width="100" Height="100" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.2"/>
                                    <Ellipse Width="88" Height="88" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1" Effect="{StaticResource CardShadow}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="INSERT" FontSize="12" FontWeight="Black" Foreground="#073B28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="BOTTLE / CAN" FontSize="7" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                                        <Border Background="#073B28" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center">
                                            <TextBlock Text="START" FontSize="7.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Grid.Row="2" Background="#083E28" CornerRadius="6" Padding="6,4" Margin="0,3">
                                <TextBlock Text="1. INSERT • 2. DETECT • 3. REWARD" FontSize="7.5" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="STOP (S)" Style="{StaticResource GreenActionButton}" Background="#DC2626" FontSize="8" Padding="4,2" Click="StopButton_Click"/>
                                <Button Grid.Column="2" Content="ADMIN (A)" Style="{StaticResource GreenActionButton}" Background="#475569" FontSize="8" Padding="4,2" Click="AdminButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Center: Full Matrix -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="8,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="SESSION BREAKDOWN MATRIX" FontSize="10" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,4"/>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="STATUS" Style="{StaticResource StatSubLabel}" TextAlignment="Left"/><TextBlock x:Name="StatusText" Text="Press 0 to Start" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="LAST SCAN" Style="{StaticResource StatSubLabel}" TextAlignment="Left"/><TextBlock x:Name="BottleInfoText" Text="Insert item" FontSize="9" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Border Grid.RowSpan="5" Grid.Column="7" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="REJ" Style="{StaticResource StatSubLabel}" Foreground="#DC2626"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="RejectedCountText" Text="0" FontSize="20" FontWeight="Black" Foreground="#DC2626" TextAlignment="Center"/></Viewbox></Grid></Border>

                                <Border Grid.Row="0" Grid.Column="0" Background="#D1FAE5" CornerRadius="4,0,0,4" BorderBrush="#10B981" BorderThickness="1,1,0,1" Padding="2"><Viewbox Stretch="Uniform"><TextBlock Text="PLASTIC" FontSize="14" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="S" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="0" Grid.Column="3" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="M" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="0" Grid.Column="5" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="L" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#047857" TextAlignment="Center"/></Viewbox></Grid></Border>

                                <Border Grid.Row="2" Grid.Column="0" Background="#DBEAFE" CornerRadius="4,0,0,4" BorderBrush="#0EA5E9" BorderThickness="1,1,0,1" Padding="2"><Viewbox Stretch="Uniform"><TextBlock Text="CAN" FontSize="14" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Border>
                                <Border Grid.Row="2" Grid.Column="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="S" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanSmallCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="2" Grid.Column="3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="M" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanMediumCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="2" Grid.Column="5" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="L" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="CanLargeCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#0369A1" TextAlignment="Center"/></Viewbox></Grid></Border>

                                <Border Grid.Row="4" Grid.Column="0" Background="#FEF3C7" CornerRadius="4,0,0,4" BorderBrush="#F59E0B" BorderThickness="1,1,0,1" Padding="2"><Viewbox Stretch="Uniform"><TextBlock Text="TETRA" FontSize="12" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Border>
                                <Border Grid.Row="4" Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="S" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="4" Grid.Column="3" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="M" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid></Border>
                                <Border Grid.Row="4" Grid.Column="5" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" Padding="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="L" Style="{StaticResource StatSubLabel}"/><Viewbox Grid.Row="1" Stretch="Uniform"><TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#B45309" TextAlignment="Center"/></Viewbox></Grid></Border>
                            </Grid>

                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="ITEMS" Style="{StaticResource StatSubLabel}"/><TextBlock x:Name="TotalItemsText" Text="0" FontSize="14" FontWeight="Black" Foreground="#047857" HorizontalAlignment="Center"/></StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="POINTS" Style="{StaticResource StatSubLabel}"/><TextBlock x:Name="TotalPointsText" Text="0" FontSize="14" FontWeight="Black" Foreground="#D97706" HorizontalAlignment="Center"/></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Leaderboard & Impact -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="6,4" BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="LEADERBOARD 🏆" FontSize="9" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                                <Border Grid.Row="1" Background="#F1F5F9" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="#" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="Name" FontSize="7.5" FontWeight="Bold" Foreground="#64748B"/><TextBlock Grid.Column="2" Text="Pts" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" TextAlignment="Right"/></Grid></Border>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="LeaderboardList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="1,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Rank}" FontSize="8.5" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="8.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding PointsBalance, StringFormat={}{0} pts}" FontSize="8.5" FontWeight="Bold" Foreground="#D97706" TextAlignment="Right"/></Grid></Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="8" Padding="6,3">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="☁️ CO₂" FontSize="7" FontWeight="Bold" Foreground="#64748B"/><TextBlock x:Name="Co2SavedText" Text="0.00" FontSize="9.5" FontWeight="Black" Foreground="#0D9488"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="💧 Water" FontSize="7" FontWeight="Bold" Foreground="#64748B"/><TextBlock x:Name="WaterSavedText" Text="0.00" FontSize="9.5" FontWeight="Black" Foreground="#2563EB"/></StackPanel></Grid>
                        </Border>

                        <Border Grid.Row="4" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="8" Padding="6,4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="BALANCE" FontSize="7.5" FontWeight="Bold" Foreground="#64748B"/><TextBlock Text="{Binding Text, ElementName=TotalPointsText, StringFormat={}{0} PTS}" FontSize="12" FontWeight="Black" Foreground="#073B28"/></StackPanel><Button Grid.Column="1" Content="CLAIM" Style="{StaticResource GreenActionButton}" FontSize="8" Padding="6,2" VerticalAlignment="Center" Click="ViewRewardsButton_Click"/></Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Nav Cards -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource NavCardButton}" Click="SignInNav_Click"><TextBlock Text="👤 SIGN IN" FontSize="8" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></Button>
                    <Button Grid.Column="1" Style="{StaticResource NavCardButton}" Click="RewardsNav_Click"><TextBlock Text="🎁 REWARDS" FontSize="8" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></Button>
                    <Button Grid.Column="2" Style="{StaticResource NavCardButton}" Click="TransactionNav_Click"><TextBlock Text="🕒 HISTORY" FontSize="8" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></Button>
                    <Button Grid.Column="3" Style="{StaticResource NavCardButton}" Click="InstructionsNav_Click"><TextBlock Text="ℹ️ GUIDE" FontSize="8" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></Button>
                    <Button Grid.Column="4" Style="{StaticResource NavCardButton}" Click="AnnouncementsNav_Click"><TextBlock Text="📢 NEWS" FontSize="8" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></Button>
                </Grid>

                <StackPanel Visibility="Collapsed">
                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaEnded="InstructionPlayer_MediaEnded"/>
                    <Grid x:Name="InstructionPlaceholder"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT HALF: DIGITAL SIGNAGE VIDEO SCREEN -->
        <Grid x:Name="BottomGrid" Grid.Column="1" Background="#05120B">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>
