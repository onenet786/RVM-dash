<Window x:Class="RVMDesktopApp.LandscapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized" WindowStyle="None" ShowInTaskbar="True"
        Icon="pack://application:,,,/RVMDesktopApp;component/Assets/RvmIcon.ico"
        Background="#F7F9F5" PreviewKeyDown="Window_KeyDown">
    
    <Window.Resources>
        <SolidColorBrush x:Key="ForestDark" Color="#073B28"/>
        <SolidColorBrush x:Key="ForestGuide" Color="#073F26"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#15803D"/>
        <SolidColorBrush x:Key="BrightLeaf" Color="#22C55E"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E2EAE0"/>

        <!-- Authentic Urdu Nastaliq Font Stack -->
        <FontFamily x:Key="UrduFont">Jameel Noori Nastaleeq, Urdu Typesetting, Noto Nastaliq Urdu, Gulzar, Pak Nastaleeq, Nafees Nastaleeq, Segoe UI, Arial</FontFamily>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#073B28"/>
        <DropShadowEffect x:Key="SubtleItemShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.04" Color="#073B28"/>
        <DropShadowEffect x:Key="CircleShadow" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Color="#073B28"/>
        <DropShadowEffect x:Key="TealGlassShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.20" Color="#0D9488"/>

        <Style x:Key="ExactInsertCircleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="200">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02" CenterX="80" CenterY="80"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomNavCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="3,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#EAF3E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56*"/>
            <ColumnDefinition Width="44*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HALF: KIOSK DASHBOARD -->
        <Border Grid.Column="0" Background="#F7F9F5" Padding="14,8" BorderBrush="#E2E8F0" BorderThickness="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                    <RowDefinition Height="Auto"/> <!-- 1: Hardware Diagnostics Bar -->
                    <RowDefinition Height="*"/>    <!-- 2: Left: Insert Bottle + Live Breakdown; Right: How-To + Top 5 Recyclers -->
                    <RowDefinition Height="Auto"/> <!-- 3: Bottom Cards: Side-by-Side Your Environmental Impact & Your Reward Balance (Same Height!) -->
                    <RowDefinition Height="Auto"/> <!-- 4: 5 Nav Actions -->
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="38" Margin="0,0,8,0">
                            <Ellipse Stroke="#073B28" StrokeThickness="2.2" Fill="Transparent"/>
                            <Path Data="M 17 11 L 17 7 L 23 7 L 23 11 L 27 15 L 27 32 L 13 32 L 13 15 Z" Fill="#073B28"/>
                            <Path Data="M 26 20 C 36 21 36 34 24 34 C 28 28 28 22 26 20 Z" Fill="#22C55E"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RVM" FontSize="20" FontWeight="Black" Foreground="#073B28"/>
                                <Border x:Name="LiveBadgeBorder" Background="#DCFCE7" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LiveBadgeText" Text="LIVE 🟢" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                                <Border x:Name="RvmNameChipBorder" Background="#E0F2FE" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderRvmNameText" Text="RVM-001" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="REVERSE VENDING MACHINE" FontSize="8" FontWeight="Bold" Foreground="#073B28"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="WELCOME • " FontSize="14" FontWeight="Black" Foreground="#073B28"/>
                            <TextBlock Text="خوش آمدید" FontFamily="{StaticResource UrduFont}" FontSize="15" FontWeight="Black" Foreground="#073B28"/>
                        </StackPanel>
                        <TextBlock Text="Recycle Today for a Better Tomorrow" FontSize="8.5" Foreground="#64748B"/>
                    </StackPanel>

                    <TextBlock x:Name="HeaderDotText" Visibility="Collapsed"/>
                    <TextBlock x:Name="CommandCenterRvmNameText" Visibility="Collapsed"/>
                    <TextBlock x:Name="AdHeaderRvmNameText" Visibility="Collapsed"/>

                    <!-- Header Right: Date, Time & ISPP Logo Card -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LiveDateText" Text="14 May 2025" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LiveTimeText" Text="10:30 AM" FontSize="10.5" FontWeight="Bold" Foreground="#073B28"/>
                            </StackPanel>
                        </Border>

                        <!-- ISPP Logo -->
                        <Border Background="#FFFFFF" BorderBrush="#E5EAE1" BorderThickness="1" CornerRadius="6" Padding="2" Height="36" Effect="{StaticResource CardShadow}" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/RVMDesktopApp;component/Assets/ispp.jpg" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: HARDWARE DIAGNOSTICS BAR -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,0,5" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="HARDWARE DIAGNOSTICS 🔌" FontSize="8.5" FontWeight="Black" Foreground="#073B28" Margin="0,0,0,2"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="SERIAL: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                            <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="DbDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/><TextBlock x:Name="DbStatusText" Text="DB: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                            <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ApiDot" Width="6" Height="6" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="ApiStatusText" Text="API: OK" FontSize="8" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border>
                            <TextBlock x:Name="MachineStateText" Text="IDLE" FontSize="8" FontWeight="Bold" Foreground="#0369A1" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- HARDWARE ERROR BANNER -->
                        <Border x:Name="HardwareErrorBanner" Grid.Row="2" Margin="0,3,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠️ " FontSize="8" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="HardwareErrorText" Text="HARDWARE CONNECTION ERROR • " FontSize="7.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    <TextBlock Text="ہارڈویئر منسلک نہیں ہے" FontFamily="{StaticResource UrduFont}" FontSize="8.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="RETRY 🔄" Background="#DC2626" Foreground="White" FontSize="7.5" FontWeight="Bold" Padding="4,1" Margin="4,0,0,0" Cursor="Hand" Click="RetryHardwareConnection_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 2: CENTER SECTION -->
                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: INSERT BOTTLE / LIVE INSTRUCTION VIDEO + LIVE SESSION CONTAINER BREAKDOWN -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Insert Bottle -->
                        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="160" Height="160" CornerRadius="80" ClipToBounds="True" Background="#073B28" Effect="{StaticResource CircleShadow}" Cursor="Hand" MouseLeftButtonUp="StartButton_Click">
                                <Grid>
                                    <MediaElement x:Name="InstructionPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" MediaEnded="InstructionPlayer_MediaEnded"/>
                                    <Grid x:Name="InstructionPlaceholder">
                                        <Button Style="{StaticResource ExactInsertCircleButton}" Click="StartButton_Click">
                                            <Grid Width="160" Height="160">
                                                <Ellipse Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="3 3"/>
                                                <Ellipse Width="146" Height="146" Fill="#FBFDF9" Stroke="#E2ECE0" StrokeThickness="1.2"/>
                                                <Ellipse Width="130" Height="130" Fill="#FFFFFF" Stroke="#CBE0CB" StrokeThickness="1"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="INSERT • " FontSize="13" FontWeight="Black" Foreground="#073B28"/>
                                                        <TextBlock Text="داخل کریں" FontFamily="{StaticResource UrduFont}" FontSize="13.5" FontWeight="Black" Foreground="#073B28"/>
                                                    </StackPanel>
                                                    <TextBlock Text="BOTTLE / CAN / CUP" FontSize="7.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,-2,0,3"/>
                                                    <Border Background="#073B28" CornerRadius="8" Padding="10,2.5" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="START • " FontSize="8" FontWeight="Black" Foreground="#FFFFFF"/>
                                                            <TextBlock Text="شروع کریں" FontFamily="{StaticResource UrduFont}" FontSize="8.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Live Session Breakdown (Directly above Impact - DOUBLED SIZE) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2EAE0" BorderThickness="1.2" CornerRadius="8" Padding="10,8" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="SESSION DETAILS • " FontSize="9" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                        <TextBlock Text="سیشن تفصیل" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0">
                                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="8.5" FontWeight="Bold" Foreground="#16A34A"/>
                                        </Border>
                                        <TextBlock x:Name="BottleInfoText" Text="• Insert item" FontSize="8" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Plastic -->
                                    <Border Grid.Column="0" Background="#F0FDFA" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="6" Padding="4,5" MinHeight="62">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                                <TextBlock Text="🧴" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="PLASTIC" FontSize="8.5" FontWeight="Black" Foreground="#047857" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#CCFBF1" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="S:" FontSize="7" Foreground="#0F766E"/><TextBlock x:Name="PlasticSmallCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#047857" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#CCFBF1" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="M:" FontSize="7" Foreground="#0F766E"/><TextBlock x:Name="PlasticMediumCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#047857" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#CCFBF1" CornerRadius="3" Padding="3,1"><StackPanel Orientation="Horizontal"><TextBlock Text="L:" FontSize="7" Foreground="#0F766E"/><TextBlock x:Name="PlasticLargeCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#047857" Margin="1,0,0,0"/></StackPanel></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Can -->
                                    <Border Grid.Column="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="4,5" MinHeight="62">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                                <TextBlock Text="🥫" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CAN" FontSize="8.5" FontWeight="Black" Foreground="#0369A1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#E0F2FE" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="S:" FontSize="7" Foreground="#0284C7"/><TextBlock x:Name="CanSmallCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#0369A1" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#E0F2FE" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="M:" FontSize="7" Foreground="#0284C7"/><TextBlock x:Name="CanMediumCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#0369A1" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#E0F2FE" CornerRadius="3" Padding="3,1"><StackPanel Orientation="Horizontal"><TextBlock Text="L:" FontSize="7" Foreground="#0284C7"/><TextBlock x:Name="CanLargeCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#0369A1" Margin="1,0,0,0"/></StackPanel></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Tetra -->
                                    <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="4,5" MinHeight="62">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                                                <TextBlock Text="🧃" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="TETRA" FontSize="8.5" FontWeight="Black" Foreground="#B45309" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#FEF3C7" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="S:" FontSize="7" Foreground="#D97706"/><TextBlock x:Name="TetraPakSmallCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#B45309" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#FEF3C7" CornerRadius="3" Padding="3,1" Margin="0,0,2,0"><StackPanel Orientation="Horizontal"><TextBlock Text="M:" FontSize="7" Foreground="#D97706"/><TextBlock x:Name="TetraPakMediumCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#B45309" Margin="1,0,0,0"/></StackPanel></Border>
                                                <Border Background="#FEF3C7" CornerRadius="3" Padding="3,1"><StackPanel Orientation="Horizontal"><TextBlock Text="L:" FontSize="7" Foreground="#D97706"/><TextBlock x:Name="TetraPakLargeCountText" Text="0" FontSize="11" FontWeight="Black" Foreground="#B45309" Margin="1,0,0,0"/></StackPanel></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Reject -->
                                    <Border Grid.Column="6" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="4,5" MinHeight="62">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                <TextBlock Text="🚫" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="REJ" FontSize="8.5" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="RejectedCountText" Text="0" FontSize="18" FontWeight="Black" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                <TextBlock Text=" pcs" FontSize="7.5" FontWeight="Bold" Foreground="#EF4444" Margin="1,4,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.15*"/> <!-- How To Use -->
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>    <!-- Top 5 Leaderboard + Flashing Last Recycler -->
                        </Grid.RowDefinitions>

                        <!-- Bilingual How To Use RVM with Teal Glassmorphism & Yellow Icons -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="10,5" BorderThickness="1.2" Effect="{StaticResource TealGlassShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EB0F766E" Offset="0.0"/>
                                    <GradientStop Color="#E0115E59" Offset="0.5"/>
                                    <GradientStop Color="#F0042E2B" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#995EEAD4" Offset="0.0"/>
                                    <GradientStop Color="#4D2DD4BF" Offset="0.5"/>
                                    <GradientStop Color="#8014B8A6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="✦ " FontSize="10" Foreground="#FACC15"/>
                                    <TextBlock Text="HOW TO USE RVM • " FontSize="11" FontWeight="Black" Foreground="#99F6E4"/>
                                    <TextBlock Text="طریقہ کار" FontFamily="{StaticResource UrduFont}" FontSize="12" FontWeight="Black" Foreground="#99F6E4"/>
                                    <TextBlock Text=" ✦" FontSize="10" Foreground="#FACC15"/>
                                </StackPanel>
                                <UniformGrid Grid.Row="1" Columns="1" Rows="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="🍾" FontSize="10" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="1. INSERT • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/><TextBlock Text="خالی بوتل یا کین ڈالیں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/></StackPanel></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="🔍" FontSize="10" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="2. DETECT • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/><TextBlock Text="خودکار اسکین" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/></StackPanel></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="🎁" FontSize="10" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="3. REWARD • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/><TextBlock Text="پوائنٹس حاصل کریں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/></StackPanel></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1"><Border Width="20" Height="20" CornerRadius="10" Background="#33FBBF24" BorderBrush="#EAB308" BorderThickness="1" Margin="0,0,6,0"><TextBlock Text="🌱" FontSize="10" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="4. SAVE • " FontSize="12" FontWeight="Black" Foreground="#FFFFFF"/><TextBlock Text="ماحول کو سرسبز بنائیں" FontFamily="{StaticResource UrduFont}" FontSize="12.5" FontWeight="Black" Foreground="#FFFFFF"/></StackPanel></StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Top 5 Leaderboard Cards + Flashing Last Recycler -->
                        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" Padding="8,4" BorderBrush="#E5EAE1" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TOP 5 RECYCLERS • " FontSize="8.5" FontWeight="Black" Foreground="#073B28"/>
                                        <TextBlock Text="بہترین ری سائیکلرز" FontFamily="{StaticResource UrduFont}" FontSize="9" FontWeight="Black" Foreground="#073B28"/>
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="LeaderboardList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,1.5,0,2.5" MinHeight="34" Effect="{StaticResource SubtleItemShadow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="#" FontSize="7.5" FontWeight="Bold" Foreground="#D97706"/>
                                                                <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Black" Foreground="#B45309"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock Text="👤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="Eco Champion • ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="7.5" Foreground="#64748B"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding PointsBalance}" FontSize="10" FontWeight="Black" Foreground="#047857"/>
                                                                <TextBlock Text=" pts" FontSize="7.5" FontWeight="Bold" Foreground="#15803D" Margin="1,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- FLASHING LAST RECYCLER FOOTER CARD -->
                                <Border Grid.Row="2" Margin="0,3,0,0" CornerRadius="6" Padding="7,3.5" MinHeight="34" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FEFCE8" Offset="0.0"/>
                                            <GradientStop Color="#F0FDF4" Offset="0.5"/>
                                            <GradientStop Color="#ECFDF5" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FDE047" Offset="0.0"/>
                                            <GradientStop Color="#86EFAC" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Flashing Pulse Badge -->
                                        <Border Grid.Column="0" Background="#FEF08A" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="4" Padding="4,1.5" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="#CA8A04" Margin="0,0,2.5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="⚡ RECENT" FontSize="7" FontWeight="Black" Foreground="#854D0E"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Avatar -->
                                        <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="#FEF9C3" BorderBrush="#FACC15" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock Text="♻️" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="LastRecyclerNameText" Text="Eco Champion" FontSize="9.5" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="LastRecyclerTimeText" Text=" • Just now" FontSize="7" Foreground="#64748B" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LastRecyclerActivityText" Text="Recycled Container • آخری ری سائیکلر" FontFamily="{StaticResource UrduFont}" FontSize="7" Foreground="#047857"/>
                                        </StackPanel>

                                        <!-- Points -->
                                        <Border Grid.Column="3" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                            <TextBlock x:Name="LastRecyclerPointsText" Text="+10 pts" FontSize="9" FontWeight="Black" Foreground="#15803D"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ROW 3: BOTTOM CARDS (SIDE-BY-SIDE: YOUR IMPACT & YOUR REWARD BALANCE - EXACT SAME HEIGHT!) -->
                <Grid Grid.Row="3" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: YOUR IMPACT CARD -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E8EFE5" BorderThickness="1" CornerRadius="8" Padding="10,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="YOUR IMPACT 🍃 " FontSize="10" FontWeight="Black" Foreground="#073B28"/>
                                <TextBlock Text="ماحولیاتی فوائد" FontFamily="{StaticResource UrduFont}" FontSize="10.5" FontWeight="Black" Foreground="#073B28"/>
                            </StackPanel>
                            <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="🌱 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Bottles Recycled (بوتلیں)" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="TotalItemsText" Text="0" FontSize="16" FontWeight="Black" Foreground="#073B28" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="🌳 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CO₂ Saved kg (کاربن بچت)" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="Co2SavedText" Text="0.00" FontSize="16" FontWeight="Black" Foreground="#0F766E" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="💧 " FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Water Saved L (پانی کی بچت)" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/></StackPanel><TextBlock Grid.Column="2" x:Name="WaterSavedText" Text="0.00" FontSize="16" FontWeight="Black" Foreground="#1D4ED8" VerticalAlignment="Center"/></Grid>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- RIGHT: YOUR BALANCE CARD (SAME HEIGHT!) -->
                    <Border Grid.Column="2" Background="#F4F8F1" BorderBrush="#E2EBE0" BorderThickness="1" CornerRadius="8" Padding="10,6" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="REWARD BALANCE 🎁 " FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="پوائنٹس بیلنس" FontFamily="{StaticResource UrduFont}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,2"><TextBlock x:Name="TotalPointsText" Text="0" FontSize="26" FontWeight="Black" Foreground="#073B28"/><StackPanel Orientation="Horizontal" Margin="2,-2,0,0"><TextBlock Text="POINTS • " FontSize="8" FontWeight="Bold" Foreground="#15803D"/><TextBlock Text="پوائنٹس" FontFamily="{StaticResource UrduFont}" FontSize="8.5" FontWeight="Bold" Foreground="#15803D"/></StackPanel></StackPanel>
                            <Button Grid.Row="2" HorizontalAlignment="Left" Background="#073B28" Foreground="White" Padding="10,3.5" Cursor="Hand" Click="ViewRewardsButton_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="REDEEM • " FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="انعام پائیں" FontFamily="{StaticResource UrduFont}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 4: 5 QUICK ACTION CARDS -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BottomNavCardButton}" Click="SignInNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#16A34A" Margin="0,0,0,1"><TextBlock Text="👤" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SIGN IN" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="1" Style="{StaticResource BottomNavCardButton}" Click="RewardsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#F59E0B" Margin="0,0,0,1"><TextBlock Text="🎁" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="REWARDS" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="2" Style="{StaticResource BottomNavCardButton}" Click="TransactionNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#0284C7" Margin="0,0,0,1"><TextBlock Text="🕒" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="HISTORY" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="3" Style="{StaticResource BottomNavCardButton}" Click="InstructionsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#7C3AED" Margin="0,0,0,1"><TextBlock Text="ℹ️" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="GUIDE" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button Grid.Column="4" Style="{StaticResource BottomNavCardButton}" Click="AnnouncementsNav_Click"><StackPanel HorizontalAlignment="Center"><Border Width="24" Height="24" CornerRadius="12" Background="#0D9488" Margin="0,0,0,1"><TextBlock Text="📢" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="NEWS" FontSize="7.5" FontWeight="Bold" Foreground="#073B28" HorizontalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT HALF: DIGITAL SIGNAGE VIDEO SCREEN -->
        <Grid x:Name="BottomGrid" Grid.Column="1" Background="#05120B">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="AdPanel" Grid.Column="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <MediaElement x:Name="AdvertisementPlayer" Grid.RowSpan="3" LoadedBehavior="Manual" Stretch="Fill" MediaEnded="AdvertisementPlayer_MediaEnded"/>
                    <Border Grid.Row="0" Background="#CC073B28" Padding="14,6"><StackPanel HorizontalAlignment="Center"><TextBlock Text="SMALL ACTIONS BIG IMPACT" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/><TextBlock Text="RECYCLE TODAY FOR A BETTER TOMORROW" FontSize="9" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Grid.Row="2" Background="#073B28" Padding="8,5" BorderBrush="#15803D" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REDUCE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Waste • " FontSize="7.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="کچرا کم کریں" FontFamily="{StaticResource UrduFont}" FontSize="8.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🍃" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="REUSE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Resources • " FontSize="7.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="دوبارہ استعمال" FontFamily="{StaticResource UrduFont}" FontSize="8.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="♻" FontSize="13" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                <TextBlock Text="RECYCLE" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="For a Greener Future • " FontSize="7.5" Foreground="#86EFAC"/>
                                    <TextBlock Text="سرسبز مستقبل" FontFamily="{StaticResource UrduFont}" FontSize="8.5" Foreground="#86EFAC"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="TelemetryPanel" Grid.Column="0" Background="#080D18" BorderBrush="#22C55E" BorderThickness="0,0,0,2" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0D1526" Padding="18,12"><TextBlock Text="REAL-TIME TELEMETRY TERMINAL  (ESC OR 8 TO CLOSE)" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/></Border><ScrollViewer x:Name="TelemetryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12"><ItemsControl x:Name="TelemetryList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
        </Grid>
    </Grid>
</Window>
